+
+uint32_t
+sweet_cpu_signal_raw(unsigned int cpu)
+{
+	if (cpu >= MAX_CPUS) {
+		return 0xffffffffu;
+	}
+	cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
+	return cdp == NULL ? 0xffffffffu : os_atomic_load(&cdp->cpu_signal, acquire);
+}
