+	case SWEET_HFS_DIRTY_RO:
+		return "ro";
+	case SWEET_HFS_DIRTY_RW:
+		return "rw";
+	case SWEET_HFS_DIRTY_REPAIR:
+		return "repair";
+	default:
+		return "auto";
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
