+    if (me && !me->initWithTypeTimeStamp(type, timeStamp, options)) {
+        me->release();
+        return 0;
+    }
+
+    IOHIDAxisEventData * event = (IOHIDAxisEventData *)me->_data;
+    event->position.x = x;
+    event->position.y = y;
+    event->position.z = z;
+
+    return me;
+}
+
