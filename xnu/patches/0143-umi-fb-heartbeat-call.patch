 static void
 sweet_log_flush_to_disk(void)
 {
+	static int sweet_flush_on = -1;
 	uint64_t base, total, flushed, pos;
+
+	/*
+	 * sweetflush=0 turns the ring writes off completely, so a boot can be run
+	 * with the panel heartbeat as the only output: if the system then survives,
+	 * these writes were what hung it.
+	 */
+	if (sweet_flush_on < 0) {
+		int on = 1;
+		PE_parse_boot_argn("sweetflush", &on, sizeof(on));
+		sweet_flush_on = on ? 1 : 0;
+	}
+	if (!sweet_flush_on) {
+		return;
+	}
 	void *bounce;
