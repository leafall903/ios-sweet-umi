+                                    x,
+                                    y,
+                                    z,
+                                    options);
+
+    if ( event ) {
+        data = (IOHIDMotionEventData *)event->_data;
+        data->motionType = motionType;
+        data->motionSubType = motionSubType;
+        data->motionSequence = sequence;
+    }
+
+    return event;
+}
