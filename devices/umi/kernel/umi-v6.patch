@@ -0,0 +1,72 @@
+/*
+ * Built-in IOSurface for SWEET (see SweetSurface.cpp).
+ *
+ * Shared with SweetFramebuffer.cpp: the framebuffer looks surfaces up by
+ * id when a swap names them and publishes the panel memory itself as the
+ * default framebuffer surface.
+ */
+#ifndef _SWEET_SURFACE_H
+#define _SWEET_SURFACE_H
+
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSObject.h>
+#include <mach/mach_types.h>
+
+class OSDictionary;
+
+#define SWEET_SURFACE_MAX_PLANES        20
+
+struct sweet_surface_plane {
+	uint32_t width, height, bytesPerRow, offset, size;
+	uint16_t bytesPerElement;
+	uint8_t  elementWidth, elementHeight;
+};
+
+class SweetSurface : public OSObject {
+	OSDeclareDefaultStructors(SweetSurface);
+
+public:
+	uint32_t id;
+	uint32_t width, height, bytesPerRow, offset, pixelFormat, allocSize;
+	uint16_t bytesPerElement;
+	uint8_t  elementWidth, elementHeight;
+	uint32_t cacheMode, planeCount, parentID;
+	struct sweet_surface_plane planes[SWEET_SURFACE_MAX_PLANES];
+
+	IOMemoryDescriptor       *memory;       /* pixels (buffer or physical) */
+	IOOptionBits              mapCache;     /* cache mode for user mappings */
+	IOBufferMemoryDescriptor *state;        /* shared state page, read-only for users */
+	IOMemoryMap              *kernelMap;    /* lazily created for kernel copies */
+
+	OSDictionary *values;
+	uint32_t purgeable;
+    uint64_t wrapCharge;
+    uint32_t wrapDelta;
+    bool wrapped;
+	bool init() APPLE_KEXT_OVERRIDE { values = NULL; purgeable = 0;wrapCharge=0;wrapDelta=0;wrapped=false; return OSObject::init(); }
+	void free() APPLE_KEXT_OVERRIDE;
+
+	/* Kernel address of the pixels (mapped on first use), or 0. */
+	uintptr_t kernelAddress();
+};
+
+/* Retained surface for an id, or NULL. */
+SweetSurface *sweet_surface_copy(uint32_t id);
+
+/*
+ * Publish physical memory (the panel framebuffer) as a surface. Returns a
+ * retained surface that stays in the id table until released by the caller
+ * and every user.
+ */
+SweetSurface *sweet_surface_create_physical(uint64_t phys, uint32_t width,
+    uint32_t height, uint32_t bytesPerRow, uint32_t pixelFormat);
+
+/* Send right for the surface in task (IOSurfaceLookupFromMachPort). */
+mach_port_name_t sweet_surface_port_in_task(SweetSurface *surface, task_t task);
+
+#endif /* SWEET */
+#endif /* _SWEET_SURFACE_H */
diff --git a/iokit/Kernel/arm/SweetWatchdog.cpp b/iokit/Kernel/arm/SweetWatchdog.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetWatchdog.cpp
@@ -0,0 +1,107 @@
+/*
+ * Built-in IOWatchdog for SWEET.
+ *
+ * watchdogd (launchd job with _PanicOnCrash) opens IOServiceMatching(
+ * "IOWatchdog") with type 1 and exits when it is missing, which panics the
+ * system. On Apple hardware the kext arms a SoC watchdog that resets the
+ * device unless watchdogd keeps checking in. SWEET has no reset path, so
+ * this service accepts every call (check-in 1, enable/disable userspace
+ * monitoring 3/4, 0/5, struct calls 2 and 9) and does nothing; each
+ * selector is logged the first time it is used.
+ *
+ * watchdogd also writes the device boot stage to the PMU: it looks up
+ * the IOService with IOPMUPrimary = 1 and crashes when there is none
+ * (customer builds ignore -wdt_no_pmu). SWEET has no Apple PMU, so this
+ * service carries IOPMUPrimary and accepts property writes.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+
+class IOWatchdog : public IOService {
+	OSDeclareDefaultStructors(IOWatchdog);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdog, IOService);
+
+IOReturn
+IOWatchdog::setProperties(__unused OSObject *properties)
+{
+	return kIOReturnSuccess;
+}
+
+bool
+IOWatchdog::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IOWatchdogUserClient");
+	setProperty("IOPMUPrimary", 1ULL, 32);
+	registerService();
+	IOLog("SWEET WDT: IOWatchdog registered (accepts check-ins, never fires)\n");
+	return true;
+}
+
+class IOWatchdogUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOWatchdogUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdogUserClient, IOUserClient);
+
+IOReturn
+IOWatchdogUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t sweet_wdt_logged;       /* selectors already logged (< 64) */
+
+IOReturn
+IOWatchdogUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		IOByteCount len = args->structureOutputDescriptor->getLength();
+		for (IOByteCount off = 0; off < len; off += 8) {
+			static const uint64_t zero = 0;
+			args->structureOutputDescriptor->writeBytes(off, &zero, len - off < 8 ? len - off : 8);
+		}
+	} else if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+
+	if (selector >= 64 || !(sweet_wdt_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_wdt_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET WDT: %s sel %u in %u/%u out %u/%u -> ok\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/UmiFramePacing.h b/iokit/Kernel/arm/UmiFramePacing.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/UmiFramePacing.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <stdint.h>
+// Advance a periodic absolute deadline, skipping missed frames. Work duration
+// does not add to every period, and overdue work never creates a catch-up loop.
+static inline uint64_t umi_vsync_next(uint64_t previous,uint64_t period,uint64_t now) {
+ if(!period)period=1;
+ if(!previous)return now>UINT64_MAX-period?UINT64_MAX:now+period;
+ if(previous>UINT64_MAX-period)return UINT64_MAX;
+ uint64_t next=previous+period;
+ if(next<=now){uint64_t skipped=(now-next)/period;
+  if(skipped==UINT64_MAX || skipped+1>(UINT64_MAX-next)/period)return UINT64_MAX;
+  next+=(skipped+1)*period;
+ }
+ return next;
+}
+static inline bool umi_frame_due(uint64_t now,uint64_t start,uint64_t period) {
+ return now>=start && now-start>=period;
+}
+
+// IOMobileFramebufferVsyncNotifyFunc reconstructs three64-bit numbers from
+// six64-bit arguments holding32-bit halves: refresh time, presented time, counter.
+static inline void umi_fb_vsync_values(uint64_t now,uint64_t presented,uint64_t count,uint64_t values[6]) {
+ values[0]=(uint32_t)now;values[1]=(uint32_t)(now>>32);
+ values[2]=(uint32_t)presented;values[3]=(uint32_t)(presented>>32);
+ values[4]=(uint32_t)count;values[5]=(uint32_t)(count>>32);
+}
+static inline bool umi_fb_mode_block(uint64_t block,uint8_t *bytes,uint64_t length) {
+ if(!bytes || length>4096 || (block==0x40 && length<12))return false;
+ for(uint64_t i=0;i<length;++i)bytes[i]=0;
+ if(block==0x40){bytes[4]=1;bytes[8]=1;}
+ return true;
+}
+
+static inline bool umi_present_due(uint64_t now,uint64_t deadline) {
+ return deadline==0 || now>=deadline;
+}
diff --git a/iokit/Kernel/arm/UmiFtsCore.h b/iokit/Kernel/arm/UmiFtsCore.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/UmiFtsCore.h
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// ST FTM5 wire format: LineageOS SM8250 71b13e62f057a649b77fe4062feb73ee72ad609c.
+// Independent decoder. Coordinates and contact IDs stay in native portrait axes.
+#pragma once
+#include <stdint.h>
+#include <string.h>
+struct UmiTouchPoint { uint16_t x,y; uint8_t active; };
+struct UmiTouchFrame { uint32_t sequence; UmiTouchPoint points[10]; };
+enum { UMI_FTS_NONE=0, UMI_FTS_POINT=1, UMI_FTS_RESET=2, UMI_FTS_FAULT=3, UMI_FTS_BAD=4 };
+// Native fts interrupt dispatch uses event[0] >> 4. The low nibble can
+// carry contact-size bits; it is not a fixed 0x3 protocol signature.
+static inline bool umi_fts_point_event(uint8_t code) {
+    unsigned kind=code>>4;return kind>=1 && kind<=3;
+}
+static inline unsigned umi_fts_parse(UmiTouchFrame *f,const uint8_t e[8]) {
+    if(!e[0])return UMI_FTS_NONE;
+    if(e[0]==3 || e[0]==0xf3) {
+        for(unsigned i=0;i<10;++i)f->points[i].active=0;
+        return e[0]==3?UMI_FTS_RESET:UMI_FTS_FAULT;
+    }
+    // Native fts dispatch indexes the upper nibble. Slot zero is the no-op
+    // handler, including observed 0d000c... packets; READY 03 stays above.
+    if((e[0]>>4)==0)return UMI_FTS_NONE;
+    if(!umi_fts_point_event(e[0]))return (e[0]&15)==3?UMI_FTS_NONE:UMI_FTS_BAD;
+    // LineageOS FTS leave handler: 0xb5 is the separate FOD release,
+    // not ordinary touch slot11. It must not cancel active display contacts.
+    if((e[0]>>4)==3 && e[1]==0xb5)return UMI_FTS_NONE;
+    unsigned id=e[1]>>4,type=e[1]&15;
+    if(id>=10)return UMI_FTS_BAD;
+    UmiTouchPoint *p=&f->points[id];
+    if((e[0]>>4)==3 || (type!=1 && type!=2)) {
+        unsigned changed=p->active;p->active=0;return changed?UMI_FTS_POINT:UMI_FTS_NONE;
+    }
+    unsigned x=((unsigned)(e[3]&15)<<8)|e[2],y=((unsigned)e[4]<<4)|(e[3]>>4);
+    if(x>1079 || y>2339)return UMI_FTS_BAD;
+    unsigned changed=!p->active||p->x!=x||p->y!=y;
+    p->x=(uint16_t)x;p->y=(uint16_t)y;p->active=1;return changed?UMI_FTS_POINT:UMI_FTS_NONE;
+}
+// Fixed HID collection per hardware ID: lifting ID 0 cannot overwrite ID 1's
+// previous state. Every disappearing ID carries its own last coordinate.
+static inline unsigned umi_fts_report(const UmiTouchFrame *previous,const UmiTouchFrame *next,uint8_t report[62]) {
+    memset(report,0,62);report[0]=3;unsigned count=0;
+    for(unsigned id=0;id<10;++id) {
+        const UmiTouchPoint *p=next->points[id].active?&next->points[id]:&previous->points[id];
+        uint8_t *out=report+1+id*6;out[1]=(uint8_t)id;
+        if(!next->points[id].active && !previous->points[id].active)continue;
+        unsigned x=(unsigned)p->x*32767/1079,y=(unsigned)p->y*32767/2339;
+        // Bit 1 is TouchValid/confidence, including on the release report.
+        out[0]=next->points[id].active?3:2;out[2]=(uint8_t)x;out[3]=(uint8_t)(x>>8);out[4]=(uint8_t)y;out[5]=(uint8_t)(y>>8);++count;
+    }
+    report[61]=(uint8_t)count;return count;
+}
diff --git a/iokit/Kernel/arm/UmiFtsIdentity.h b/iokit/Kernel/arm/UmiFtsIdentity.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/UmiFtsIdentity.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+// Native fts_get_lockdown_info: read factory record0x70, never program NVM.
+// The fixed8-byte identity selects umi's st_fts_j2_2.ftb profile. The caller
+// has already qualified chip/FW/AFE and performs GPIO resets2/3 afterwards.
+struct UmiFtsIdentity {
+    unsigned result,flags,readResult,writeResult,polls;
+    uint8_t before[8],after[8],identity[8],event[8];
+};
+template<class Transfer,class Sleep,class Now>
+static UmiFtsIdentity umi_fts_read_identity(Transfer transfer,Sleep sleep,Now now,const uint8_t *qualifiedIdentity=nullptr) {
+    UmiFtsIdentity r={};r.readResult=r.writeResult=0x100;
+    const uint8_t address[]={0xa6,0,0},request[]={0xa4,0x06,0x70},fifo=0x86;
+    uint8_t header[28]={};
+    r.readResult=transfer(address,sizeof(address),header,4);
+    if(r.readResult){r.result=1;return r;}
+    for(unsigned n=0;n<4;++n)r.before[n]=header[n];r.flags|=1;
+    if(header[0]!=0xa5){r.result=2;return r;}
+    unsigned before=unsigned(header[2])|(unsigned(header[3])<<8);
+    r.writeResult=transfer(request,sizeof(request),nullptr,0);
+    if(r.writeResult){r.result=3;return r;}r.flags|=2;
+    sleep(10);uint64_t started=now();
+    for(unsigned n=0;n<50 && now()-started<100000000ULL;++n){
+        uint8_t event[8]={};++r.polls;
+        r.readResult=transfer(&fifo,1,event,8);
+        if(r.readResult){r.result=4;return r;}
+        for(unsigned j=0;j<8;++j)r.event[j]=event[j];
+        if(event[0]==0xf3 || event[0]==3){r.result=5;return r;}
+        if(event[0]==0x43 && event[1]==1 && event[2]==0xa4 && event[3]==6 && event[4]==0x70){r.flags|=4;break;}
+        sleep(2);
+    }
+    if(!(r.flags&4)){r.result=6;return r;}
+    r.readResult=transfer(address,sizeof(address),header,sizeof(header));
+    if(r.readResult){r.result=7;return r;}
+    for(unsigned n=0;n<8;++n){r.after[n]=header[n];r.identity[n]=header[n+20];}r.flags|=8;
+    unsigned after=unsigned(header[2])|(unsigned(header[3])<<8);
+    if(header[0]!=0xa5 || header[1]!=0x70 || header[4]!=0 || after!=((before+1)&65535U)){r.result=8;return r;}r.flags|=16;
+    const uint8_t expected[]={0x53,0x42,0x32,1,0x74,2,0x32,1};
+    for(unsigned n=0;n<8;++n)if(r.identity[n]!=(qualifiedIdentity?qualifiedIdentity[n]:expected[n])){r.result=9;return r;}
+    r.flags|=32;return r;
+}
diff --git a/iokit/Kernel/arm/UmiFtsMalformed.h b/iokit/Kernel/arm/UmiFtsMalformed.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/UmiFtsMalformed.h
@@ -0,0 +1,10 @@
+#pragma once
+#include <stdint.h>
+struct UmiFtsMalformedWindow { uint64_t startNs; unsigned count; bool started; };
+// Never turn invalid data into a contact. Permit at most three cancellations
+// per second only after the qualified controller has entered sensing state.
+static inline bool umi_fts_malformed_retry(UmiFtsMalformedWindow *w,unsigned stage,uint64_t now) {
+    if(stage!=6)return false;
+    if(!w->started || now<w->startNs || now-w->startNs>=1000000000ULL){w->startNs=now;w->count=0;w->started=true;}
+    return ++w->count<=3;
+}
diff --git a/iokit/Kernel/arm/UmiFtsStartup.h b/iokit/Kernel/arm/UmiFtsStartup.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/UmiFtsStartup.h
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Same 100 ms reset/READY window as umi's fts_521 GENERAL_TIMEOUT.
+#pragma once
+#include "UmiFtsCore.h"
+#include "UmiFtsSysInfo.h"
+// Native fts_init -> fts_crc_check -> post-version-check reset. All three
+// GPIO resets must produce READY before sensing. Reject unsupported identity,
+// CRC or AFE state instead of attempting native firmware/calibration writes.
+static inline unsigned umi_fts_native_identity_check(const UmiFtsControllerRead &r,
+                                             const UmiFtsSysInfo &s) {
+    if(r.sysResult || r.bytesRead!=UMI_FTS_SYSINFO_SIZE || r.chunkMask!=0x1fff)return 1;
+    if(!s.valid)return 2;
+    if(r.crcResult)return 3;
+    if(r.crc&3)return 4;
+    // Two explicitly qualified umi modules. Current handset fw/config/chip
+    // independently read through TWRP native driver; factory record checked
+    // separately before sensing. Never update controller NVM to match a donor.
+    bool donor=s.fw==0x128 && s.svn==0x4053 && s.config==0x4b;
+    bool handset=s.fw==0x123 && s.config==0x4f && s.cfgAfe==8 &&
+        s.resX==2339 && s.resY==1079 && s.tx==16 && s.rx==35;
+    if(s.chip0!=0x3639 || (!donor && !handset))return 5;
+    if(s.cfgAfe!=s.cxAfe || s.cfgAfe!=s.panelAfe)return 6;
+    return 0;
+}
+// Require identical complete responses, independently qualifying every repeat.
+static inline bool umi_fts_same_controller(const UmiFtsControllerRead &a,const UmiFtsControllerRead &b) {
+    UmiFtsSysInfo info=umi_fts_sysinfo(b.bytes,b.bytesRead);
+    return !umi_fts_native_identity_check(b,info) && a.crc==b.crc &&
+        !memcmp(a.bytes,b.bytes,UMI_FTS_SYSINFO_SIZE);
+}
+enum { UMI_FTS_WAIT_READY=5, UMI_FTS_READY_TIMEOUT=6 };
+// ftsCore.c fts_system_reset fallback / ftsHardware.h FTM5 definition.
+// This resets volatile IC state; it does not program flash or calibration.
+template<class Write,class StartWait>
+static unsigned umi_fts_software_reset(Write write,StartWait startWait) {
+    const uint8_t command[]={0xfa,0x20,0x00,0x00,0x24,0x80};
+    unsigned result=write(command,sizeof(command));
+    if(!result)startWait(); // A successful write still requires a fresh READY.
+    return result;
+}
+static inline bool umi_fts_ready_expired(uint64_t elapsedNs) {
+    return elapsedNs>=100000000ULL;
+}
+static inline unsigned umi_fts_startup_event(UmiTouchFrame *frame,const uint8_t event[8],
+                                             bool awaitingReady,uint64_t elapsedNs) {
+    if(awaitingReady) {
+        if(umi_fts_ready_expired(elapsedNs))return UMI_FTS_READY_TIMEOUT;
+        // Until READY, never interpret reset-time bytes as contacts or as a
+        // normal-mode protocol violation. Real controller errors still fail.
+        if(event[0]!=0x03 && event[0]!=0xf3)return UMI_FTS_WAIT_READY;
+    }
+    return umi_fts_parse(frame,event);
+}
diff --git a/iokit/Kernel/arm/UmiFtsTouch.cpp b/iokit/Kernel/arm/UmiFtsTouch.cpp
