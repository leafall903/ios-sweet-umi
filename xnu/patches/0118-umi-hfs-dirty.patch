--- a/bsd/sweet_hfs/core/hfs_vfsutils.c
+++ b/bsd/sweet_hfs/core/hfs_vfsutils.c
@@ -84,6 +84,67 @@
 
 #define HFS_MOUNT_DEBUG 1
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET dirty-volume takeover policy.
+ *
+ * 0031 let a dirty (not cleanly unmounted), non-journaled root be mounted
+ * read-write because this port has no clean shutdown path.  That check
+ * also skipped the persistent kHFSVolumeInconsistentMask, so a volume the
+ * kernel had already detected corruption on was taken read-write again.
+ *
+ * Boot arguments:
+ *   hfsdirty=auto    (default) dirty + inconsistent -> read-only;
+ *                    dirty only -> read-write, because with no clean
+ *                    unmount path the root is dirty on every boot.
+ *   hfsdirty=ro      dirty -> read-only.  This is the strict rule; the
+ *                    root will not finish booting, which is the point.
+ *   hfsdirty=rw      legacy 0031 behaviour, for A/B comparison only.
+ *   hfsdirty=repair  accepted for forward compatibility; in-kernel repair
+ *                    is not implemented, so it behaves like auto.
+ */
+static int sweet_hfs_dirty_mode = -1;
+
+int
+sweet_hfs_dirty_policy(void)
+{
+	char arg[16];
+
+	if (sweet_hfs_dirty_mode >= 0)
+		return sweet_hfs_dirty_mode;
+
+	sweet_hfs_dirty_mode = SWEET_HFS_DIRTY_AUTO;
+
+	if (PE_parse_boot_argn("hfsdirty", arg, sizeof(arg))) {
+		if (strcmp(arg, "ro") == 0) {
+			sweet_hfs_dirty_mode = SWEET_HFS_DIRTY_RO;
+		} else if (strcmp(arg, "rw") == 0) {
+			sweet_hfs_dirty_mode = SWEET_HFS_DIRTY_RW;
+		} else if (strcmp(arg, "repair") == 0) {
+			sweet_hfs_dirty_mode = SWEET_HFS_DIRTY_REPAIR;
+		} else if (strcmp(arg, "auto") != 0) {
+			printf("hfs: unknown hfsdirty=%s, using auto\n", arg);
+		}
+	}
+	return sweet_hfs_dirty_mode;
+}
+
+const char *
+sweet_hfs_dirty_mode_name(int mode)
+{
+	switch (mode) {
+	case SWEET_HFS_DIRTY_RO:
+		return "ro";
+	case SWEET_HFS_DIRTY_RW:
+		return "rw";
+	case SWEET_HFS_DIRTY_REPAIR:
+		return "repair";
+	default:
+		return "auto";
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 
