+/* One SMC call, returning all four result registers. */
+static uint64_t
+sweet_smc(uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t *r1,
+    uint64_t *r2, uint64_t *r3)
+{
+	register uint64_t x0 __asm__("x0") = a0;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	if (r1 != NULL) { *r1 = x1; }
+	if (r2 != NULL) { *r2 = x2; }
+	if (r3 != NULL) { *r3 = x3; }
+	return x0;
+}
+
+/*
+ * Ask the secure monitor for download mode, then reset. Qualcomm's SCM takes
+ * (svc << 8) | cmd in x0 and (nargs << 24) | 1 in x1; the DLOAD service is
+ * svc 2 and "set download mode" is cmd 3. The argument shape moved between
+ * generations, so try the candidates, print every result, and reset anyway:
+ * without the flag the phone simply boots iOS again and retries, with it the
+ * bootloader comes up in 9008.
+ */
+static void
+sweet_enter_edl(void)
+{
+	uint64_t r1 = 0, r2 = 0, r3 = 0, x0;
+	int ok = 0;
+
+	printf("SWEET EDL: asking SCM for download mode\n");
+	x0 = sweet_smc((2ULL << 8) | 3ULL, (1ULL << 24) | 1ULL, 1, 0, &r1, &r2, &r3);
+	printf("SWEET EDL: nargs=1 mode=1 -> 0x%llx (r1 0x%llx r2 0x%llx r3 0x%llx)\n",
+	    (unsigned long long)x0, (unsigned long long)r1,
+	    (unsigned long long)r2, (unsigned long long)r3);
+	ok = ((int64_t)x0 >= 0);
+
+	if (!ok) {
+		x0 = sweet_smc((2ULL << 8) | 3ULL, (3ULL << 24) | 1ULL, 1, 0, &r1, &r2, &r3);
+		printf("SWEET EDL: nargs=3 mode=1 -> 0x%llx (r1 0x%llx r2 0x%llx r3 0x%llx)\n",
+		    (unsigned long long)x0, (unsigned long long)r1,
+		    (unsigned long long)r2, (unsigned long long)r3);
+		ok = ((int64_t)x0 >= 0);
+	}
+	if (!ok) {
+		x0 = sweet_smc((2ULL << 8) | 4ULL, (1ULL << 24) | 1ULL, 1, 0, &r1, &r2, &r3);
+		printf("SWEET EDL: cmd=4 mode=1 -> 0x%llx (r1 0x%llx r2 0x%llx r3 0x%llx)\n",
+		    (unsigned long long)x0, (unsigned long long)r1,
+		    (unsigned long long)r2, (unsigned long long)r3);
+		ok = ((int64_t)x0 >= 0);
+	}
+	printf("SWEET EDL: %s; resetting\n", ok ? "accepted" : "all rejected");
+	(void)sweet_smc(0x84000009ULL, 0, 0, 0, &r1, &r2, &r3);   /* PSCI SYSTEM_RESET */
+	printf("SWEET EDL: reset returned (not supported?)\n");
+}
