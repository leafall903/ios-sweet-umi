+           GetTimeInNanoSecond(GetPerformanceCounter()-chargeStarted)>=50000000){
+            chargeObserved=true;if(!recordModes(3)){stop(21);return;}
+        }
+        // Passive reads only: active LOAD_DATA diagnostics can block and
+        // must not perturb normal input startup.
+        if(stage==6 && !native_touch_count && bus::High(39) && sampleNumber<ARRAY_SIZE(sampleTimes)){
+            bool ready=false;
+            if(!frameSample.active && seconds()>=sampleTimes[sampleNumber]){
+                sampleStarted=GetPerformanceCounter();
+                if(!pointCount && !native_touch_hid_reports){
+                    // Mode parity was captured before/after the startup command.
+                    // Keep this slot for the board-boost enable/readback record.
+                    recordScan(sampleNumber+1);
+                    if(!bus::ControlReady()){stop(18);return;}
+                }
+                if(!frameSample.begin(controllerInfo))ready=true;
+            }
+            if(frameSample.active)ready=frameSample.step(
+                [](const uint8_t *w,unsigned wn,uint8_t *r,unsigned rn){return transfer(w,wn,r,rn);});
+            if(ready){recordFrameSample(++sampleNumber,GetTimeInNanoSecond(GetPerformanceCounter()-sampleStarted));
+                if(!pointCount && !native_touch_hid_reports){
+                    if(sampleNumber==1){recordHardware(sampleNumber);recordBoardRail(1);}
+                    recordDataPath(sampleNumber);
+                }
+                if(bus::mLastLines!=3){stop(15);return;}}
+        }
+        if(stage==6 && healthRecord<ARRAY_SIZE(healthTimes) && seconds()>=healthTimes[healthRecord]){
+            recordSensing();if(healthRecord<2)recordGpi(0);++healthRecord;
+        }
+        IOSleep(sleepMs);
+    }
+}
+static void workerEntry(void *p,wait_result_t w) { worker(p,w); thread_terminate(current_thread()); }
+extern "C" void native_touch_probe(void) {
+    unsigned enabled=0;if(!PE_parse_boot_argn("umi-fts",&enabled,sizeof(enabled)) || enabled!=1 || stage)return;
+    __asm__ volatile("mrs %0,cntfrq_el0":"=r"(frequency));if(!frequency)return;epoch=GetPerformanceCounter();
+    native_touch_stage_req=1;stage=1;thread_t t;
+    if(kernel_thread_start(workerEntry,nullptr,&t)==KERN_SUCCESS)thread_deallocate(t);else{stage=90;failure=12;}
+}
+
+extern "C" bool umi_input_is_umi(void) { return isUmi(); }
diff --git a/iokit/Kernel/arm/UmiImageSpan.h b/iokit/Kernel/arm/UmiImageSpan.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/UmiImageSpan.h
@@ -0,0 +1,21 @@
+#pragma once
+#include <stdint.h>
+
+/* A client image needs its pixels, not padding after the final scanline.
+ * Owned allocations still reserve full rows. Multi-plane policy is unchanged.
+ */
+static inline bool umi_image_minimum_span(uint32_t width, uint32_t height,
+    uint32_t bpe, uint32_t ew, uint32_t eh, uint32_t row,
+    uint32_t offset, uint64_t *result)
+{
+    if (!result || !width || !height || width > 16384 || height > 16384 ||
+        !bpe || bpe > 64 || !ew || !eh || ew > 255 || eh > 255) return false;
+    uint64_t pixels = ((uint64_t)width + ew - 1) / ew;
+    uint64_t rows = ((uint64_t)height + eh - 1) / eh;
+    uint64_t tail = pixels * bpe;
+    if (row < tail) return false;
+    uint64_t used = (uint64_t)offset + (rows - 1) * row + tail;
+    if (!used || used > (256ULL << 20)) return false;
+    *result = used;
+    return true;
+}
diff --git a/iokit/Kernel/arm/UmiKeyState.h b/iokit/Kernel/arm/UmiKeyState.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/UmiKeyState.h
@@ -0,0 +1,21 @@
+// Mi10 observer bits to the existing iOS16 HID consumer usages.
+#pragma once
+struct UmiKeyState {
+    unsigned delivered=0, candidate=0, samples=0;
+    bool synced=false;
+    template<class Emit> void reset(Emit emit) {
+        for(unsigned b=0;b<3;++b) if(delivered&(1U<<b)) emit(b==2?0:b==0?1:2,0);
+        delivered=candidate=samples=0; synced=false;
+    }
+    template<class Emit> void update(unsigned mask,Emit emit) {
+        mask&=7;
+        // Startup/recovery keys held during boot must be released first.
+        if(!synced) { if(mask==0) synced=true; return; }
+        if(mask!=candidate) { candidate=mask; samples=1; return; }
+        if(samples<3) ++samples;
+        if(samples!=3 || mask==delivered) return;
+        for(unsigned b=0;b<3;++b) if((mask^delivered)&(1U<<b))
+            emit(b==2?0:b==0?1:2,(mask>>b)&1);
+        delivered=mask;
+    }
+};
diff --git a/iokit/Kernel/arm/UmiKeys.cpp b/iokit/Kernel/arm/UmiKeys.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/UmiKeys.cpp
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Port of UniXNU-umi UmiButtonsDxe observer reads. No PMIC writes/IRQ ACK.
+#include <IOKit/IOLib.h>
+#include <IOKit/IODeviceMemory.h>
+#include <pexpert/pexpert.h>
+#include "UmiSmpMode.h"
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include "UmiKeyState.h"
+extern "C" bool umi_input_is_umi(void);
+extern "C" void sweet_hid_key(int,int);
+static uintptr_t core,config,observer;
+struct KeyChannel { unsigned index; uint32_t mapping,owner; };
+static uint32_t read32(uintptr_t a) { uint32_t v=*(volatile uint32_t *)a; __asm__ volatile("dsb sy":::"memory"); return v; }
+static bool mapRegion(uint64_t pa,unsigned bytes,uintptr_t &va) {
+    IODeviceMemory *m=IODeviceMemory::withRange(pa,bytes); if(!m)return false;
+    IOMemoryMap *r=m->map(kIOMapAnywhere|kIOMapInhibitCache); m->release();
+    if(!r)return false; va=r->getVirtualAddress(); return true;
+}
+static bool findChannel(unsigned ppid,KeyChannel &out) {
+    bool found=false;
+    for(unsigned i=0;i<512;++i) {
+        uint32_t m=read32(core+0x900+4*i),o=read32(config+0x700+4*i)&7;
+        if(m && ((m>>8)&0xfff)==ppid && (!found || !o)) { out={i,m,o}; found=true; }
+    }
+    return found;
+}
+static bool statusByte(const KeyChannel &c,unsigned &v) {
+    if(read32(core+0x900+4*c.index)!=c.mapping || (read32(config+0x700+4*c.index)&7)!=c.owner)return false;
+    uintptr_t a=observer+0x80*c.index;
+    // Observer EXT_READL offset 0x10 length 1; no peripheral writes.
+    __asm__ volatile("dsb sy":::"memory");
+    *(volatile uint32_t *)a=(1U<<27)|(0x10U<<4);
+    __asm__ volatile("dsb sy":::"memory");
+    for(unsigned n=0;n<1000;++n) {
+        uint32_t s=read32(a+8);
+        if(s&1) { if(s&14)return false; v=read32(a+0x18)&255; return true; }
+        IODelay(1);
+    }
+    return false;
+}
+static void keysWorker(void *,wait_result_t) {
+    thread_set_thread_name(current_thread(),"umi_keys16");
+    if(!umi_input_is_umi() || !mapRegion(0xc440000,0x2000,core) ||
+       !mapRegion(0xc40a000,0x1000,config) || !mapRegion(0xe600000,0x10000,observer)) {
+        IOLog("UMI keys: board/map refused\n");return;
+    }
+    KeyChannel pon={},gpio={};
+    if(!findChannel(0x008,pon) || !findChannel(0x0c5,gpio) || pon.index==gpio.index) {
+        IOLog("UMI keys: observer routes unavailable\n");return;
+    }
+    IOLog("UMI keys: observer-only PON=%u GPIO6=%u\n",pon.index,gpio.index);
+    UmiKeyState state;unsigned errors=0;
+    auto emit=[](int k,int down){sweet_hid_key(k,down);};
+    for(;;) {
+        unsigned p=0,g=0;
+        if(!statusByte(pon,p) || !statusByte(gpio,g)) {
+            state.reset(emit);
+            if(++errors>=8){IOLog("UMI keys: read/ownership failure; stopped with releases\n");return;}
+        } else {
+            errors=0; state.update(((g&1)?0:1)|(p&2)|((p&1)<<2),emit);
+        }
+        IOSleep(20);
+    }
+}
+static void keysEntry(void *p,wait_result_t w) { keysWorker(p,w); thread_terminate(current_thread()); }
+extern "C" void umi_keys_start(void) {
+    unsigned enabled=0,cpus=0;
+    if(!PE_parse_boot_argn("umi-keys",&enabled,4)||enabled!=1 ||
+       !PE_parse_boot_argn("cpus",&cpus,4)||!umi_cpu_boot_valid(cpus))return;
+    thread_t t; if(kernel_thread_start(keysEntry,nullptr,&t)==KERN_SUCCESS)thread_deallocate(t);
+}
diff --git a/iokit/Kernel/arm/UmiSmpMode.h b/iokit/Kernel/arm/UmiSmpMode.h
