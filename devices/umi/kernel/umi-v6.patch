+static volatile bool umi_paniclog_entered;
+static unsigned umi_paniclog_remaining;
+static uint32_t umi_ramlog_busy;
+static uint64_t umi_ramlog_dropped;
+static bool umi_ramlog_try_enter(void) {
+ if(__atomic_exchange_n(&umi_ramlog_busy,1,__ATOMIC_ACQUIRE)){
+  __atomic_fetch_add(&umi_ramlog_dropped,1,__ATOMIC_RELAXED);return false;
+ }
+ return true;
+}
+static void umi_ramlog_leave(void){__atomic_store_n(&umi_ramlog_busy,0,__ATOMIC_RELEASE);}
+
+
+static uint64_t
+umi_ramlog_irq_save(void)
+{
+    uint64_t saved;
+    __asm__ volatile("mrs %0, daif\nmsr daifset, #3" : "=r"(saved) :: "memory");
+    return saved;
+}
+
+static void
+umi_ramlog_irq_restore(uint64_t saved)
+{
+    __asm__ volatile("msr daif, %0" :: "r"(saved) : "memory");
+}
+
+static void
+umi_ramlog_putc(uint8_t c)
+{
+    if (umi_ramlog == NULL) return;
+    uint64_t saved = umi_ramlog_irq_save();
+    if(!umi_ramlog_try_enter()){umi_ramlog_irq_restore(saved);return;}
+    umi_ramlog_append(umi_ramlog, &c, 1);
+    umi_ramlog_leave();
+    umi_ramlog_irq_restore(saved);
