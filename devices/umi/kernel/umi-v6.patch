+void
+fillPage(
+	ppnum_t pn,
+	unsigned int fill)
+{
+	unsigned int   *addr;
+	int             count;
+
+	addr = (unsigned int *) phystokv(ptoa(pn));
+	count = PAGE_SIZE / sizeof(unsigned int);
+	while (count--) {
+		*addr++ = fill;
+	}
