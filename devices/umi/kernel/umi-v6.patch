+
+#define NX_SUBTYPE_STICKYKEYS_ON			100
+#define NX_SUBTYPE_STICKYKEYS_OFF			101
+#define NX_SUBTYPE_STICKYKEYS_SHIFT			102
+#define NX_SUBTYPE_STICKYKEYS_CONTROL			103
