+/*
+ * The AOSP bootloader_message lives in "misc" (GPT: 0x400000, 4 MiB). Writing
+ * "bootonce-bootloader" into its command field makes the bootloader bring up
+ * fastboot once, which gives the host a channel without any key presses.
+ */
+#define SWEET_MISC_LBA   1024u
+
+static void
+sweet_enter_fastboot(void)
+{
+	uint8_t *buf = (uint8_t *)(su.dma + DMA_BOUNCE);
+	int error;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_read_raw(SWEET_MISC_LBA, 1);
+	if (!error) {
+		bzero(buf, 32);
+		memcpy(buf, "bootonce-bootloader", 19);
+		error = ufs_write_raw(SWEET_MISC_LBA, 1);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	printf("SWEET FASTBOOT: misc command write -> %d\n", error);
+
+	uint64_t r1, r2, r3;
+	(void)sweet_smc(0x84000009ULL, 0, 0, 0, &r1, &r2, &r3);
+	printf("SWEET FASTBOOT: reset returned\n");
+}
