diff -ruN a/bsd/kern/kern_cs.c b/bsd/kern/kern_cs.c
--- a/bsd/kern/kern_cs.c	2026-10-21 13:07:31.000000000 +0000
+++ b/bsd/kern/kern_cs.c	2026-10-21 15:52:45.758808400 +0000
@@ -136,6 +136,15 @@
 #endif /* !SECURE_KERNEL */
 int cs_all_vnodes = 0;
 
+/*
+ * SWEET bring-up: when set with the "sweetnocachecs=1" boot-arg, the kernel
+ * does not look up the dyld shared cache in the trust cache and does not
+ * hash/validate its pages. This is a debug-only bypass for kernels whose
+ * code-signing enforcement is already disabled and which have no Image4/AMFI
+ * trust cache runtime. Default 0: behavior is unchanged without the boot-arg.
+ */
+int sweet_nocache_cs = 0;
+
 SYSCTL_INT(_vm, OID_AUTO, cs_force_kill, CTLFLAG_RW | CTLFLAG_LOCKED, &cs_force_kill, 0, "");
 SYSCTL_INT(_vm, OID_AUTO, cs_force_hard, CTLFLAG_RW | CTLFLAG_LOCKED, &cs_force_hard, 0, "");
 SYSCTL_INT(_vm, OID_AUTO, cs_debug, CTLFLAG_RW | CTLFLAG_LOCKED, &cs_debug, 0, "");
@@ -162,6 +171,8 @@
 static void
 cs_init(void)
 {
+	int nocache_cs = 0;
+
 #if !SECURE_KERNEL
 	int disable_cs_enforcement = 0;
 	PE_parse_boot_argn("cs_enforcement_disable", &disable_cs_enforcement,
@@ -186,6 +197,18 @@
 	    sizeof(cs_library_val_enable));
 #endif
 #endif /* !SECURE_KERNEL */
+
+	/*
+	 * SWEET debug bypass, independent of SECURE_KERNEL: with
+	 * "sweetnocachecs=1", skip the shared cache trust-cache lookup and
+	 * the per-page code-signing hash validation.
+	 */
+	PE_parse_boot_argn("sweetnocachecs", &nocache_cs, sizeof(nocache_cs));
+	if (nocache_cs != 0) {
+		sweet_nocache_cs = 1;
+		printf("SWEET: shared cache code-signing checks disabled "
+		    "(sweetnocachecs=1)\n");
+	}
 }
 STARTUP(CODESIGNING, STARTUP_RANK_FIRST, cs_init);
 
