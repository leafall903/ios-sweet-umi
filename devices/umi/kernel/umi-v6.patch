+static bool cp_needs_pers_key(cprotect_t cpr)
+{
+	if (CP_CLASS(cpr->cp_pclass) == PROTECTION_CLASS_F)
+		return !cpx_has_key(cpkp_cpx(cpr->cp_keys));
+	else
+		return !cpkp_has_pers_key(cpr->cp_keys);
+}
