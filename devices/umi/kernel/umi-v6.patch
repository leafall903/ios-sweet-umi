+typedef struct BTreeControlBlock {					// fields specific to BTree CBs
+
+	u_int8_t		keyCompareType;   /* Key string Comparison Type */
+	u_int8_t					 btreeType;
+	u_int16_t					 treeDepth;
+	FileReference				 fileRefNum;		// refNum of btree file
+	KeyCompareProcPtr			 keyCompareProc;
