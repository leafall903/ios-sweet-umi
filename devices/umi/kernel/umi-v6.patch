+static cp_key_revision_t cp_initial_key_revision(__unused hfsmount_t *hfsmp)
+{
+	return 1;
+}
+
+cp_key_revision_t cp_next_key_revision(cp_key_revision_t rev)
+{
+	rev = (rev + 0x0100) ^ (mach_absolute_time() & 0xff);
+	if (!rev)
+		rev = 1;
+	return rev;
+}
