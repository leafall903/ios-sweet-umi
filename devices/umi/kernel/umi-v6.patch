+ *	This is the straight GMT conversion constant:
+ *	00:00:00 January 1, 1970 - 00:00:00 January 1, 1904
+ *	(3600 * 24 * ((365 * (1970 - 1904)) + (((1970 - 1904) / 4) + 1)))
+ */
+#define MAC_GMT_FACTOR		2082844800UL
