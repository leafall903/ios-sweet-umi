+};
+
+OSDefineMetaClassAndStructors(SweetGPU, IOService);
+
+bool
+SweetGPU::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "SweetGPUUserClient");
+	setName("SweetGPU");
+	registerService();
+	IOLog("SweetGPU: registered: the GPU is offered to programs\n");
+	return true;
+}
+
+/* From sweet_gpu.c once the GPU is kept on. */
+void
+SweetGPUStart(void)
+{
+	IOService *provider = IOService::getPlatform();
+	SweetGPU *gpu;
+
+	gGPULock = IOLockAlloc();
+	gpu = OSTypeAlloc(SweetGPU);
+	if (gGPULock == NULL || gpu == NULL || provider == NULL || !gpu->init() || !gpu->attach(provider)) {
+		OSSafeReleaseNULL(gpu);
+		IOLog("SweetGPU: cannot create the service\n");
+		return;
+	}
+	if (!gpu->start(provider)) {
+		gpu->detach(provider);
+		IOLog("SweetGPU: the service did not start\n");
+	}
+	gpu->release();
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+struct gpu_buffer {
+	IOMemoryDescriptor *memory;             /* NULL: this handle is free */
+    uintptr_t kernel;                     /* base of the GPU-mapped pixels */
+    struct gpu_surface_sync *sync;         /* retained IOSurface, if imported */
+    bool prepared;
+	uint64_t address;                       /* the GPU's for it */
+	uint64_t size;
+	uint32_t flags;
+	uint32_t fence;                         /* the last submission that names it (0: none has) */
+};
+
+class SweetGPUUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(SweetGPUUserClient);
+
+	struct gpu_buffer *fBuffers;            /* handle n is fBuffers[n - 1] */
+    IOLock *fCallLock;                     /* serialize handles while gpuWait drops gGPULock */
+    bool fClosing;
+	uint32_t fNextBuffer;                   /* where the search for a free handle starts */
+	uint32_t fNextQueue;
+	uint32_t fSubmits;
+	uint32_t fStrangers;                    /* requests that named a buffer the client does not have */
+
+	struct gpu_buffer *buffer(uint32_t handle);
+	void freeBuffer(struct gpu_buffer *b);
+	IOReturn gemNew(struct msm_gem_new *request);
+	IOReturn gemInfo(struct msm_gem_info *request);
+    IOReturn surfaceBuffer(struct sweet_gpu_surface *request);
+    IOReturn cpuPrep(const struct msm_gem_cpu_prep *request);
+    IOReturn call(uint32_t selector, IOExternalMethodArguments *args);
+	IOReturn submit(struct msm_gem_submit *request);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetGPUUserClient, IOUserClient);
+
+bool
+SweetGPUUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+    if (!IOUserClient::initWithTask(owningTask, securityID, type)) return false;
+    fCallLock = IOLockAlloc();
+    return fCallLock != NULL;
+}
+
+bool
+SweetGPUUserClient::start(IOService *provider)
+{
+	if (gGPULock == NULL || !sweet_gpu_ready() || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fBuffers = IONewZero(struct gpu_buffer, GPU_BUFFERS);
+	return fBuffers != NULL;
+}
+
+struct gpu_buffer *
+SweetGPUUserClient::buffer(uint32_t handle)
+{
+	if (handle == 0 || handle > GPU_BUFFERS || fBuffers[handle - 1].memory == NULL) {
+		if (handle != 0 && fStrangers++ < 16) {
+			IOLog("SweetGPU: buffer %u is asked for and is not there\n", handle);
+		}
+		return NULL;
+	}
+	return &fBuffers[handle - 1];
+}
+
+/*
+ * With the lock held. A buffer the core may still be using (it has stopped
+ * answering) stays the GPU's for good: its memory may yet be written, and
+ * must not be somebody else's by then.
+ */
+void
+SweetGPUUserClient::freeBuffer(struct gpu_buffer *b)
+{
+	if (b->fence != 0 && !gpuWait(b->fence, 1000)) {
+		static uint32_t said;
+
+		if (said++ < 8) {
+			IOLog("SweetGPU: the GPU is not done with a buffer of %llu bytes: it stays its own\n", b->size);
+		}
+	} else {
+		sweet_gpu_unmap(b->address, b->size);
+		sweet_gpu_address_free(b->address, b->size);
+        if (b->prepared) (void)b->memory->complete();
+        b->memory->release();
+        if (b->sync != NULL) gpuSurfaceUnlink(b->sync);
+    }
+    /* If the fence timed out, memory, preparation and surface ref deliberately
+     * remain live. Do not let free() or a reused handle release in-flight DMA. */
+    bzero(b, sizeof(*b));
+}
+
+IOReturn
+SweetGPUUserClient::clientClose(void)
+{
+    IOLockLock(fCallLock);
+    fClosing = true;
+	if (fBuffers != NULL) {
+		IOLockLock(gGPULock);
+		for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+			if (fBuffers[i].memory != NULL) {
+				freeBuffer(&fBuffers[i]);
+			}
+		}
+		IOLockUnlock(gGPULock);
+	}
+    IOLockUnlock(fCallLock);
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+SweetGPUUserClient::free(void)
+{
+	if (fBuffers != NULL) {
+        /* clientClose is normal but not the only destruction route. */
+        IOLockLock(gGPULock);
+        for (uint32_t i = 0; i < GPU_BUFFERS; ++i)
+            if (fBuffers[i].memory != NULL) freeBuffer(&fBuffers[i]);
+        IOLockUnlock(gGPULock);
+		IODelete(fBuffers, struct gpu_buffer, GPU_BUFFERS);
+		fBuffers = NULL;
+	}
+    if (fCallLock != NULL) { IOLockFree(fCallLock); fCallLock = NULL; }
+	IOUserClient::free();
+}
+
+IOReturn
+SweetGPUUserClient::gemNew(struct msm_gem_new *request)
+{
+	uint64_t size = round_page_64(request->size);
+	struct gpu_buffer *b = NULL;
+	IOBufferMemoryDescriptor *memory;
+	bool mapped = true;
+
+	if (size == 0 || size > GPU_BUFFER_MAX) {
+		return kIOReturnBadArgument;
+	}
+	/* write-combined, as Linux maps freedreno's buffers: the program's writes go to memory, where the GPU reads */
+	memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMapWriteCombineCache, (vm_size_t)size, PAGE_SIZE);
+	if (memory == NULL) {
+		IOLog("SweetGPU: no memory for a buffer of %llu bytes\n", size);
+		return kIOReturnNoMemory;
+	}
+
+	IOLockLock(gGPULock);
+	for (uint32_t n = 0; n < GPU_BUFFERS; n++) {
+		uint32_t i = (fNextBuffer + n) % GPU_BUFFERS;
+
+		if (fBuffers[i].memory == NULL) {
+			b = &fBuffers[i];
+			request->handle = i + 1;
+			fNextBuffer = i + 1;
+			break;
+		}
+	}
+	if (b == NULL || (b->address = sweet_gpu_address(size)) == 0) {
+		IOLockUnlock(gGPULock);
+		IOLog("SweetGPU: no %s left for a buffer of %llu bytes\n", b ? "addresses" : "handles", size);
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	for (uint64_t offset = 0; offset < size && mapped; offset += 4096) {
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(offset, &length, kIOMemoryMapperNone);
+
+		mapped = phys != 0 && sweet_gpu_map(b->address + offset, phys, (request->flags & MSM_BO_GPU_READONLY) != 0);
+	}
+	sweet_gpu_mapped();
+	if (!mapped) {
+		sweet_gpu_unmap(b->address, size);
+		sweet_gpu_address_free(b->address, size);
+		IOLockUnlock(gGPULock);
+		IOLog("SweetGPU: a buffer of %llu bytes cannot be entered into the GPU's address space\n", size);
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	b->memory = memory;
+    b->kernel = (uintptr_t)memory->getBytesNoCopy();
+    b->sync = NULL;
+    b->prepared = false;
+	b->size = size;
+	b->flags = request->flags;
+	b->fence = 0;
+	IOLockUnlock(gGPULock);
+	return kIOReturnSuccess;
+}
+
+/* Import only complete 4 KiB pages owned by the descriptor. Never round
+ * beyond its length and never map the separate state page as image pixels. */
+static bool
+gpuSurfaceRange(uint64_t length, uint64_t delta, uint64_t alloc, uint64_t *rounded)
+{
+    if (alloc == 0 || alloc > GPU_BUFFER_MAX || (delta & 4095u) != 0 ||
+        delta > length || alloc > length - delta || alloc > UINT64_MAX - 4095u) return false;
+    uint64_t size = (alloc + 4095u) & ~4095ull;
+    if (size > length - delta) return false;
+    *rounded = size;
+    return true;
+}
+
+IOReturn
+SweetGPUUserClient::surfaceBuffer(struct sweet_gpu_surface *request)
+{
+    SweetSurface *surface = sweet_surface_copy(request->surface);
+    IOMemoryDescriptor *memory = NULL;
+    struct gpu_surface_sync *sync = NULL;
+    struct gpu_buffer *b = NULL;
+    uint64_t size = 0, address = 0;
+    uintptr_t kernel = 0;
+    IOReturn ret = kIOReturnBadArgument;
+    bool prepared = false, entered = false;
+
+    if (surface == NULL) return kIOReturnNotFound;
+    /* Layout is immutable while the retained surface exists. Describe does
+     * not pin memory or create a handle, including unsupported wrap layouts. */
+    if (surface->memory == NULL || surface->width == 0 || surface->height == 0 ||
+        surface->bytesPerRow == 0 || surface->allocSize == 0 ||
+        surface->offset >= surface->allocSize ||
+        surface->wrapDelta > surface->memory->getLength() ||
+        surface->allocSize > surface->memory->getLength() - surface->wrapDelta) goto out;
+    request->size = surface->allocSize;
+    request->offset = surface->offset;
+    request->rowBytes = surface->bytesPerRow;
+    request->width = surface->width;
+    request->height = surface->height;
+    request->pixelFormat = surface->pixelFormat;
+    request->planes = surface->planeCount;
+    if (request->handle == SWEET_GPU_DESCRIBE) {
+        request->handle = 0;
+        ret = kIOReturnSuccess;
+        goto out;
+    }
+    if ((surface->mapCache & kIOMapReadOnly) != 0 ||
+        !gpuSurfaceRange(surface->memory->getLength(), surface->wrapDelta, surface->allocSize, &size)) {
+        ret = kIOReturnUnsupported;
+        goto out;
+    }
+    IOLockLock(gGPULock);
+    for (uint32_t i = 0; i < GPU_BUFFERS; ++i) {
+        if (fBuffers[i].memory != NULL && fBuffers[i].sync != NULL && fBuffers[i].sync->surface == surface) {
+            request->handle = i + 1;
+            request->size = fBuffers[i].size;
+            IOLockUnlock(gGPULock);
+            ret = kIOReturnSuccess;
+            goto out;
+        }
+    }
+    IOLockUnlock(gGPULock);
+    memory = IOSubMemoryDescriptor::withSubRange(surface->memory, surface->wrapDelta, size, kIODirectionInOut);
+    if (memory == NULL) { ret = kIOReturnNoMemory; goto out; }
+    ret = memory->prepare();
+    if (ret != kIOReturnSuccess) goto out;
+    prepared = true;
+    kernel = surface->kernelAddress();
+    if (kernel == 0) { ret = kIOReturnNoMemory; goto out; }
+    sync = IONewZero(struct gpu_surface_sync, 1);
+    if (sync == NULL) { ret = kIOReturnNoMemory; goto out; }
+    IOLockLock(gGPULock);
+    /* Another import can have arrived while memory was being prepared. */
+    for (uint32_t i = 0; i < GPU_BUFFERS; ++i) {
+        if (fBuffers[i].memory != NULL && fBuffers[i].sync != NULL && fBuffers[i].sync->surface == surface) {
+            request->handle = i + 1;
+            request->size = fBuffers[i].size;
+            IOLockUnlock(gGPULock);
+            ret = kIOReturnSuccess;
+            goto out;
+        }
+    }
+    for (uint32_t n = 0; n < GPU_BUFFERS; ++n) {
+        uint32_t i = (fNextBuffer + n) % GPU_BUFFERS;
+        if (fBuffers[i].memory == NULL) {
+            b = &fBuffers[i]; request->handle = i + 1; fNextBuffer = i + 1; break;
+        }
+    }
+    address = b != NULL ? sweet_gpu_address(size) : 0;
+    if (address == 0) { IOLockUnlock(gGPULock); ret = kIOReturnNoMemory; goto out; }
+    entered = true;
+    for (uint64_t offset = 0; offset < size; offset += 4096) {
+        IOByteCount segment = 0;
+        addr64_t phys = memory->getPhysicalSegment(offset, &segment, kIOMemoryMapperNone);
+        if (phys == 0 || (phys & 4095u) != 0 || segment < 4096 || !sweet_gpu_map(address + offset, phys, false)) {
+            sweet_gpu_unmap(address, size); sweet_gpu_address_free(address, size);
+            entered = false; IOLockUnlock(gGPULock); ret = kIOReturnNoMemory; goto out;
+        }
+    }
+    sweet_gpu_mapped();
+    bzero(b, sizeof(*b));
+    b->memory = memory; b->kernel = kernel; b->prepared = true;
+    b->address = address; b->size = size; b->sync = sync;
+    sync->surface = surface; sync->next = gSurfaceSync; gSurfaceSync = sync;
+    request->size = size;
+    IOLockUnlock(gGPULock);
+    /* Ownership moves to the live BO/sync record, released only after fence. */
+    memory = NULL; surface = NULL; sync = NULL; prepared = false;
+    ret = kIOReturnSuccess;
+out:
+    (void)entered;
+    if (prepared) (void)memory->complete();
+    OSSafeReleaseNULL(memory);
+    if (sync != NULL) IODelete(sync, struct gpu_surface_sync, 1);
+    OSSafeReleaseNULL(surface);
+    return ret;
+}
+
+/* fCallLock is held by call's wrapper. Regular BOs are WC; imported
+ * surfaces are cached and may also be used by another GPU client. Join all
+ * outstanding imports of that surface and invalidate before CPU access. */
+IOReturn
+SweetGPUUserClient::cpuPrep(const struct msm_gem_cpu_prep *request)
+{
+    IOLockLock(gGPULock);
+    struct gpu_buffer *b = buffer(request->handle);
+    if (b == NULL) { IOLockUnlock(gGPULock); return kIOReturnBadArgument; }
+    uint64_t patience = (request->op & MSM_PREP_NOSYNC) ? 0 : millisecondsUntil(&request->timeout);
+    if (b->sync != NULL) {
+        SweetSurface *surface = b->sync->surface;
+        surface->retain();
+        IOLockUnlock(gGPULock);
+        bool done = SweetGPUWaitForSurface(surface, patience);
+        surface->release();
+        return done ? kIOReturnSuccess : kIOReturnBusy;
+    }
+    bool done = b->fence == 0 || gpuWait(b->fence, patience);
+    IOLockUnlock(gGPULock);
+    return done ? kIOReturnSuccess : kIOReturnBusy;
+}
+
+IOReturn
+SweetGPUUserClient::gemInfo(struct msm_gem_info *request)
+{
+	struct gpu_buffer *b;
+	IOReturn ret = kIOReturnSuccess;
+
+	IOLockLock(gGPULock);
+	b = buffer(request->handle);
+	if (b == NULL) {
+		ret = kIOReturnBadArgument;
+	} else if (request->info == MSM_INFO_GET_OFFSET) {
+		request->value = (uint64_t)request->handle << 32;       /* nobody maps by it here */
+	} else if (request->info == MSM_INFO_GET_IOVA) {
+		request->value = b->address;    /* the buffer's until it is given back (freedreno asks once) */
+	} else if (request->info == MSM_INFO_GET_FLAGS) {
+		request->value = b->flags;
+	} else if (request->info != MSM_INFO_SET_NAME) {
+		ret = kIOReturnUnsupported;     /* SET_IOVA among them: addresses are the kernel's to give */
+	}
+	IOLockUnlock(gGPULock);
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::submit(struct msm_gem_submit *request)
+{
+	struct msm_gem_submit_bo *bos = NULL;
+	struct msm_gem_submit_cmd *cmds = NULL;
+	uint64_t addresses[GPU_SUBMIT_CMDS];
+	uint32_t words[GPU_SUBMIT_CMDS], count = 0, nr_bos = request->nr_bos, nr_cmds = request->nr_cmds;
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (nr_cmds == 0 || nr_cmds > GPU_SUBMIT_CMDS || nr_bos == 0 || nr_bos > GPU_SUBMIT_BOS) {
+		IOLog("SweetGPU: a submission of %u command buffers in %u buffers: not taken\n", nr_cmds, nr_bos);
+		return kIOReturnBadArgument;
+	}
+	bos = IONew(struct msm_gem_submit_bo, nr_bos);
+	cmds = IONew(struct msm_gem_submit_cmd, nr_cmds);
+	if (bos == NULL || cmds == NULL) {
+		ret = kIOReturnNoMemory;
+		goto out;
+	}
+	if (copyin((user_addr_t)request->bos, bos, nr_bos * sizeof(*bos)) != 0 ||
+	    copyin((user_addr_t)request->cmds, cmds, nr_cmds * sizeof(*cmds)) != 0) {
+		ret = kIOReturnVMError;
+		goto out;
+	}
+	IOLockLock(gGPULock);
+    /* Cached SweetSurface pixels need clean/invalidate before GPU reads;
+     * private WC BOs need only the existing ordering barrier. */
+    for (uint32_t i = 0; i < nr_bos; ++i) {
+        struct gpu_buffer *b = buffer(bos[i].handle);
+        if (b == NULL) { IOLockUnlock(gGPULock); goto out; }
+        if (b->sync != NULL) sweet_gpu_to_memory((void *)b->kernel, b->size);
+    }
+	sweet_gpu_to_memory(NULL, 0);           /* what the program wrote last is in memory (a barrier) */
+	for (uint32_t i = 0; i < nr_cmds; i++) {
+		struct gpu_buffer *b = cmds[i].submit_idx < nr_bos ? buffer(bos[cmds[i].submit_idx].handle) : NULL;
+
+		if (cmds[i].type != MSM_SUBMIT_CMD_BUF) {
+			continue;                       /* the other kinds are for a GPU shared between address spaces */
+		}
+		if (b == NULL || cmds[i].nr_relocs != 0 || (cmds[i].size & 3) || (cmds[i].submit_offset & 3) ||
+		    (uint64_t)cmds[i].submit_offset + cmds[i].size > b->size) {
+			IOLog("SweetGPU: command buffer %u of a submission: buffer %u, offset %u, %u bytes, %u relocations: not taken\n",
+			    i, cmds[i].submit_idx, cmds[i].submit_offset, cmds[i].size, cmds[i].nr_relocs);
+			IOLockUnlock(gGPULock);
+			goto out;
+		}
+		addresses[count] = b->address + cmds[i].submit_offset;
+		words[count++] = cmds[i].size / 4;
+	}
+	request->fence = (count != 0 && !gGPUStopped) ? sweet_gpu_submit(addresses, words, count) : 0;
+	if (request->fence == 0 && count != 0 && !gGPUStopped) {
+		sweet_gpu_report("the ring stays full");
+		gGPUStopped = true;
+	}
+	if (request->flags & MSM_SUBMIT_FENCE_FD_OUT) {
+		request->fence_fd = -1;
+	}
+	for (uint32_t i = 0; request->fence != 0 && i < nr_bos; i++) {
+		struct gpu_buffer *b = buffer(bos[i].handle);
+
+		if (b != NULL) {
+			b->fence = request->fence;
+            if (b->sync != NULL) b->sync->fence = request->fence;
+		}
+	}
+	if (request->fence != 0 && fSubmits++ < 4) {
+		IOLog("SweetGPU: submission %u: %u command buffers, the first at %#llx, %u words\n", request->fence, count,
+		    addresses[0], words[0]);
+	}
+	IOLockUnlock(gGPULock);
+	ret = request->fence != 0 ? kIOReturnSuccess : kIOReturnTimeout;
+out:
+	if (bos != NULL) {
+		IODelete(bos, struct msm_gem_submit_bo, nr_bos);
+	}
+	if (cmds != NULL) {
+		IODelete(cmds, struct msm_gem_submit_cmd, nr_cmds);
+	}
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	struct gpu_buffer *b;
+	IOReturn ret = kIOReturnBadArgument;
+
+	IOLockLock(gGPULock);
+	b = buffer(type);
+	if (b != NULL) {
+		b->memory->retain();
+		*memory = b->memory;
+		*options = 0;
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gGPULock);
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+    if (fCallLock == NULL) return kIOReturnNotReady;
+    IOLockLock(fCallLock);
+    IOReturn result = fClosing ? kIOReturnNotReady : call(selector, args);
+    IOLockUnlock(fCallLock);
+    return result;
+}
+
+IOReturn
+SweetGPUUserClient::call(uint32_t selector, IOExternalMethodArguments *args)
+{
+	union {
+		struct msm_param param;
+		struct msm_gem_new gemNew;
+		struct msm_gem_info gemInfo;
+		struct msm_gem_cpu_prep cpuPrep;
+		struct msm_gem_submit submit;
+		struct msm_wait_fence waitFence;
+		struct msm_gem_madvise madvise;
+		struct msm_submitqueue queue;
+		struct msm_submitqueue_query query;
+		struct drm_gem_close close;
+        struct sweet_gpu_surface surface;
+	} r;
+	size_t size = args->structureInputSize;
+	struct gpu_buffer *b;
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t zero = 0;
+
+	if (args->structureInput == NULL || size > sizeof(r) || fBuffers == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!sweet_gpu_ready()) {
+		return kIOReturnNotReady;
+	}
+	bzero(&r, sizeof(r));
+	memcpy(&r, args->structureInput, size);
+
+	switch (selector) {
+	case kMsmGetParam:
+		IOLockLock(gGPULock);
+		ret = sweet_gpu_parameter(r.param.param, &r.param.value) ? kIOReturnSuccess : kIOReturnBadArgument;
+		IOLockUnlock(gGPULock);
+		break;
+	case kMsmSetParam:                      /* the program's name, for Linux's lists of who uses the GPU */
+	case kMsmGemCpuFini:
+	case kMsmSubmitQueueClose:
+		break;
+	case kMsmGemNew:
+		ret = gemNew(&r.gemNew);
+		break;
+	case kMsmGemInfo:
+		ret = gemInfo(&r.gemInfo);
+		break;
+    case kSweetSurface:
+        if (size != sizeof(r.surface) || args->structureOutput == NULL || args->structureOutputSize < sizeof(r.surface))
+            return kIOReturnBadArgument;
+        ret = surfaceBuffer(&r.surface);
+        break;
+    case kMsmGemCpuPrep:
+        ret = cpuPrep(&r.cpuPrep);
+        break;
+	case kMsmGemSubmit:
+		ret = submit(&r.submit);
+		break;
+	case kMsmWaitFence:
+		IOLockLock(gGPULock);
+		if (!gpuWait(r.waitFence.fence, millisecondsUntil(&r.waitFence.timeout))) {
+			ret = kIOReturnTimeout;
+		}
+		IOLockUnlock(gGPULock);
+		break;
+	case kMsmGemMadvise:
+		r.madvise.retained = 1;
+		break;
+	case kMsmSubmitQueueNew:
+		r.queue.id = ++fNextQueue;
+		break;
+	case kMsmSubmitQueueQuery:              /* how often the GPU has faulted on this client's commands */
+		if (r.query.data != 0 && r.query.len >= sizeof(zero)) {
+			(void)copyout(&zero, (user_addr_t)r.query.data, sizeof(zero));
+		}
+		break;
+	case kDrmGemClose:
+		IOLockLock(gGPULock);
+		b = buffer(r.close.handle);
+		if (b == NULL) {
+			ret = kIOReturnBadArgument;
+		} else {
+			freeBuffer(b);
+		}
+		IOLockUnlock(gGPULock);
+		break;
+	default:
+		IOLog("SweetGPU: request %#x (%zu bytes) is not known here\n", selector, size);
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	if (ret == kIOReturnSuccess && args->structureOutput != NULL) {
+		if (args->structureOutputSize > size) {
+			args->structureOutputSize = (uint32_t)size;
+		}
+		memcpy(args->structureOutput, &r, args->structureOutputSize);
+	}
+	return ret;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -0,0 +1,241 @@
+/*
+ * Built-in AppleKeyStore for SWEET: a device without a passcode whose
+ * system keybag is always loaded and unlocked.
+ *
+ * Apple's AppleKeyStore kext (closed, SEP-backed) owns the keybags behind
+ * data protection. libaks (AppleKeyStore.framework, statically in keybagd)
+ * opens IOServiceMatching("AppleKeyStore") with type 0, calls selector 0,
+ * then one selector per aks_* function (iOS 16.7 numbering below). keybagd
+ * --init asks for the system bag (14) and only loads systembag.kb when the
+ * answer is kIOReturnNotFound; answering with a handle is the path a
+ * userspace reboot takes, so no bag file is needed.
+ *
+ * Every call is logged (selector, caller, argument shapes, result) so the
+ * next selectors the system needs show up on the console; unknown ones fail
+ * with kIOReturnUnsupported.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <libkern/c++/OSString.h>
+#include <sys/proc.h>
+
+/* libaks selectors (AppleKeyStore.framework, iOS 16.7). */
+enum {
+	kAKSOpen             = 0,
+	kAKSCreateBag        = 2,
+	kAKSSaveBag          = 3,
+	kAKSUnloadBag        = 4,
+	kAKSSetSystem        = 5,
+	kAKSLoadBag          = 6,
+	kAKSGetLockState     = 7,
+	kAKSUnlockDevice     = 9,
+	kAKSWrapKey          = 10,
+	kAKSUnwrapKey        = 11,
+	kAKSUnlockBag        = 12,
+	kAKSLockBag          = 13,
+	kAKSGetSystem        = 14,
+	kAKSGetDeviceState   = 17,
+	kAKSGetExtDeviceState = 35,     /* aks_get_extended_device_state */
+	kAKSAssertHold       = 26,
+	kAKSAssertDrop       = 27,
+	kAKSUnloadSessionBags = 55,
+	kAKSNotifyStateSet   = 102,
+	kAKSNotifyStateIsSet = 103,
+	kAKSAssertConsume    = 101,     /* aks_assert_consume */
+};
+
+/* The system (device) bag handle. */
+#define SWEET_AKS_SYSTEM_HANDLE 0
+
+/*
+ * aks lock state bits (aks_get_lock_state): bit 2 is "unlocked since boot"
+ * (MobileKeyBag MKBDeviceUnlockedSinceBoot); clear lock bits = unlocked.
+ */
+#define SWEET_AKS_LOCK_STATE    0x4
+
+class AppleKeyStore : public IOService {
+	OSDeclareDefaultStructors(AppleKeyStore);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStore, IOService);
+
+bool
+AppleKeyStore::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleKeyStoreUserClient");
+	registerService();
+	IOLog("SWEET AKS: AppleKeyStore registered (no passcode, unlocked)\n");
+	return true;
+}
+
+class AppleKeyStoreUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleKeyStoreUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStoreUserClient, IOUserClient);
+
+IOReturn
+AppleKeyStoreUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/* Copy len bytes to the caller's output structure (inband or descriptor). */
+static IOReturn
+sweet_aks_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		if (len > args->structureOutputDescriptor->getLength()) {
+			return kIOReturnNoSpace;
+		}
+		args->structureOutputDescriptor->writeBytes(0, buf, len);
+		args->structureOutputDescriptorSize = len;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || len > args->structureOutputSize) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, buf, len);
+	args->structureOutputSize = len;
+	return kIOReturnSuccess;
+}
+
+/* Append SEQUENCE { UTF8String key, INTEGER value } (short forms only). */
+static uint32_t
+sweet_aks_der_pair(uint8_t *p, const char *key, uint8_t value)
+{
+	uint32_t klen = (uint32_t)strlen(key);
+	uint32_t n = 0;
+	p[n++] = 0x30;
+	p[n++] = (uint8_t)(2 + klen + 3);
+	p[n++] = 0x0c;
+	p[n++] = (uint8_t)klen;
+	memcpy(p + n, key, klen);
+	n += klen;
+	p[n++] = 0x02;
+	p[n++] = 0x01;
+	p[n++] = value;
+	return n;
+}
+
+/*
+ * Device state (selector 17): a DER SET of key/INTEGER pairs that libaks
+ * decode_extended_state reads: ss state, sls lock state (MKBGetDeviceLockState:
+ * 0 = unlocked), sb backoff, sfa failed attempts, sgs generation, sas
+ * assertions, sgpe grace period, srcd recovery countdown.
+ */
+static IOReturn
+sweet_aks_device_state(IOExternalMethodArguments *args)
+{
+	static const struct {
+		const char *key;
+		uint8_t value;
+	} fields[] = {
+		{ "ss", SWEET_AKS_LOCK_STATE }, { "sls", 0 }, { "sb", 0 }, { "sfa", 0 },
+		{ "sgs", 0 }, { "sas", 0 }, { "sgpe", 0 }, { "srcd", 0 },
+	};
+	uint8_t buf[128];
+	uint32_t n = 2;
+	for (unsigned int i = 0; i < sizeof(fields) / sizeof(fields[0]); i++) {
+		n += sweet_aks_der_pair(buf + n, fields[i].key, fields[i].value);
+	}
+	buf[0] = 0x31;
+	buf[1] = (uint8_t)(n - 2);
+	return sweet_aks_struct_out(args, buf, n);
+}
+
+static uint32_t
+sweet_aks_struct_out_size(IOExternalMethodArguments *args)
+{
+	return args->structureOutputDescriptor != NULL ?
+	       (uint32_t)args->structureOutputDescriptor->getLength() : args->structureOutputSize;
+}
+
+IOReturn
+AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t in_scalars = args->scalarInputCount;
+	uint32_t in_struct = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+	uint32_t out_scalars = args->scalarOutputCount;
+	uint32_t out_struct = sweet_aks_struct_out_size(args);
+	uint64_t arg0 = in_scalars > 0 ? args->scalarInput[0] : 0;
+
+	switch (selector) {
+	case kAKSOpen:
+	case kAKSUnloadBag:
+	case kAKSSetSystem:
+	case kAKSUnlockDevice:
+	case kAKSUnlockBag:
+	case kAKSLockBag:
+	case kAKSAssertHold:
+	case kAKSAssertDrop:
+	case kAKSAssertConsume:
+	case kAKSUnloadSessionBags:
+	case kAKSNotifyStateSet:
+		args->scalarOutputCount = 0;
+		break;
+	case kAKSGetSystem:
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = SWEET_AKS_SYSTEM_HANDLE;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSGetLockState:
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = SWEET_AKS_LOCK_STATE;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSNotifyStateIsSet:
+		/* Nothing was ever set: answer "not set". */
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = 0;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSGetDeviceState:
+	case kAKSGetExtDeviceState:
+		args->scalarOutputCount = 0;
+		ret = sweet_aks_device_state(args);
+		break;
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
+	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	return ret;
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -0,0 +1,82 @@
+/*
+ * Minimal device-tree platform expert for Redmi Note 10 Pro (sweet).
+ * Uses XNU's normal platform, power-domain and nub initialization. Hardware
+ * interrupt and power-management services are supplied by separate drivers.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+
+class SweetPlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(SweetPlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
+
+bool
+SweetPlatformExpert::start(IOService *provider)
+{
+	IOLog("SWEET: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("SWEET: platform expert registered\n");
+	return true;
+}
+
+const char *
+SweetPlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+SweetPlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+SweetPlatformExpert::processTopLevel(IORegistryEntry *root)
+{
+	/*
+	 * The stock implementation requires an Apple NVRAM /options node.
+	 * SWEET has no NVRAM controller; publish real CPU/device nodes without
+	 * inventing one. createNubs adds the topology's logical CPU/cluster IDs.
+	 */
+	IORegistryEntry *cpus = root->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
+
+	/*
+	 * No AppleARMIO driver publishes the /arm-io children: do it here so
+	 * built-in drivers (the display, AppleCLCD) can match them. The GIC is
+	 * driven by the platform code and gets no nub. The nubs hang off this
+	 * platform expert: IOPlatformDevice::compareName asks its provider.
+	 */
+	IORegistryEntry *armio = root->childFromPath("arm-io", gIODTPlane);
+	if (armio != NULL) {
+		createNubs(this, IODTFindMatchingEntries(armio, kIODTExclusive, "('gic')"));
+		armio->release();
+	}
+}
+
+/*
+ * hw.target / hw.product come from IODTPlatformExpert: the first root
+ * "compatible" string and "model" (D22AP / iPhone10,3 in the ADT), which
+ * is what the iPhone userland (MobileGestalt) expects.
+ */
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -0,0 +1,1309 @@
+#include "UmiSurfaceRange.h"
+#include "UmiImageSpan.h"
+/*
+ * Built-in IOSurface for SWEET.
+ *
+ * Apple's IOSurface kext is closed. IOSurface.framework (iOS 16.7) finds
+ * IOServiceNameMatching("IOCoreSurfaceRoot"), opens it with type 0 and
+ * talks to the user client below:
+ *
+ *   sel 13  limits: struct out 0x18, u16 at +0x16 must be 1 (ABI version),
+ *           +0 offset alignment mask, +4 bytes-per-row alignment mask
+ *   sel 0   create: scalar [parent id], struct in = serialized property
+ *           dictionary (binary or XML), struct out = lock result (0xa68)
+ *   sel 4   lookup by id: scalar [id], struct out = lock result
+ *   sel 34  lookup by mach port: scalar [port name], struct out = lock result
+ *   sel 35  create mach port: scalars [id, options], scalar out [port name]
+ *   traps   0/1 use count +/- (id, category), 2 lock / 3 unlock
+ *           (id, options, &seed), 4/5 release (id)
+ *
+ * The lock result tells the library where the surface lives in the
+ * caller's address space: +0 pixels, +8 shared state page (registry id,
+ * seed at +0xc), +0x10 timestamps, then id, sizes and geometry (layout in
+ * sweet_surface_fill_result). Every surface is wired kernel memory mapped
+ * into each task that creates or looks it up; mappings are counted per
+ * client and dropped on release or close.
+ *
+ * Values and bulk colour attachments follow ios-topaz 0133. Accelerator
+ * binding stores identity only; no GPU execution is provided. Other calls
+ * remain diagnostic stubs.
+ */
+#include "SweetSurface.h"
+
+#if defined(SWEET)
+extern "C" bool SweetGPUWaitForSurface(SweetSurface *, uint64_t);
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/system.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <libkern/c++/OSSerialize.h>
+#include <libkern/c++/OSString.h>
+#include <sys/proc.h>
+
+enum {
+	kSweetSurfaceCreate             = 0,
+	kSweetSurfaceLookup             = 4,
+    kSweetSurfaceWrapClientImage=6,
+    kSweetSurfaceWrapClientMemory=7,
+	kSweetSurfaceSetYCbCrMatrix = 5,
+	kSweetSurfaceSetValue = 9,
+	kSweetSurfaceCopyValue = 10,
+	kSweetSurfaceRemoveValue = 11,
+	kSweetSurfaceBindAccel = 12,
+	kSweetSurfaceSetPurgeable = 20,
+	kSweetSurfaceSetBulkAttachments = 27,
+	kSweetSurfaceLimits             = 13,
+	kSweetSurfaceLookupFromPort     = 34,
+	kSweetSurfaceCreatePort         = 35,
+};
+
+enum {
+	kSweetSurfaceTrapIncrementUse   = 0,
+	kSweetSurfaceTrapDecrementUse   = 1,
+	kSweetSurfaceTrapLock           = 2,
+	kSweetSurfaceTrapUnlock         = 3,
+	kSweetSurfaceTrapRelease        = 4,
+	kSweetSurfaceTrapReleaseFailed  = 5,
+};
+
+#define SWEET_SURFACE_RESULT_SIZE       0xa68
+#define SWEET_SURFACE_MAX_ID            4096
+#define SWEET_SURFACE_MAX_DIM           16384
+#define SWEET_SURFACE_MAX_ALLOC         (256u << 20)
+#define SWEET_SURFACE_MAX_PROPS         (64u << 10)
+#define SWEET_SURFACE_ROW_ALIGN         64
+#define SWEET_SURFACE_TIMESTAMPS        0x800   /* offset in the state page */
+#define SWEET_SURFACE_STATE_SEED        0xc     /* u32 in the state page */
+#define SWEET_SURFACE_STATE_ACCEL       0x8     /* u16 accelerator id, u16 sub id */
+#define SWEET_SURFACE_STATE_VSEED       0x20    /* u32 values seed */
+#define SWEET_SURFACE_STATE_YCBCR       0x24    /* u32 */
+#define SWEET_SURFACE_STATE_VSIZE       0x28    /* u32 room the values need when fetched, 0: none */
+#define SWEET_SURFACE_STATE_BULK        0x30    /* 0x70 bytes of bulk attachments */
+#define SWEET_SURFACE_BULK_SIZE         0x70
+#define kIOSurfaceLockReadOnly          0x1
+
+static IOLock       *sweet_surface_lock;
+static SweetSurface *sweet_surface_table[SWEET_SURFACE_MAX_ID];
+static uint32_t      sweet_surface_users[SWEET_SURFACE_MAX_ID];
+static uint32_t      sweet_surface_next_id = 1;
+static uint32_t      sweet_surface_creates_logged;
+static uint64_t      sweet_surface_wired;       /* bytes of buffer surfaces */
+#define SWEET_SURFACE_WIRED_MAX         (1536ull << 20)
+
+OSDefineMetaClassAndStructors(SweetSurface, OSObject);
+
+void
+SweetSurface::free()
+{
+	if (OSDynamicCast(IOBufferMemoryDescriptor, memory) != NULL) {
+		OSAddAtomic64(-(SInt64)allocSize, (volatile SInt64 *)&sweet_surface_wired);
+	}
+	OSSafeReleaseNULL(kernelMap);
+	OSSafeReleaseNULL(values);
+    if(wrapped && memory!=NULL)memory->complete();
+    if(wrapCharge)OSAddAtomic64(-(SInt64)wrapCharge,(volatile SInt64*)&sweet_surface_wired);
+	OSSafeReleaseNULL(memory);
+	OSSafeReleaseNULL(state);
+	OSObject::free();
+}
+
+uintptr_t
+SweetSurface::kernelAddress()
+{
+	IOBufferMemoryDescriptor *buffer = OSDynamicCast(IOBufferMemoryDescriptor, memory);
+	if (buffer != NULL) {
+		return (uintptr_t)buffer->getBytesNoCopy();
+	}
+	IOLockLock(sweet_surface_lock);
+	if (kernelMap == NULL && memory != NULL) {
+		kernelMap = memory->map((wrapped?kIOMapDefaultCache:kIOMapWriteCombineCache)|(mapCache&kIOMapReadOnly));
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return kernelMap != NULL ? (uintptr_t)kernelMap->getVirtualAddress()+wrapDelta : 0;
+}
+
+static uint32_t *
+sweet_surface_seed(SweetSurface *s)
+{
+	return (uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_SEED);
+}
+
+/*
+ * Give the surface an id and a table slot; the table holds one retain and a
+ * user count (creators, client mappings, kernel holders). Lock held.
+ */
+static bool
+sweet_surface_insert_locked(SweetSurface *s)
+{
+	for (uint32_t n = 0; n < SWEET_SURFACE_MAX_ID - 1; n++) {
+		uint32_t id = sweet_surface_next_id;
+		sweet_surface_next_id = id + 1 < SWEET_SURFACE_MAX_ID ? id + 1 : 1;
+		if (sweet_surface_table[id] == NULL) {
+			s->id = id;
+			s->retain();
+			sweet_surface_table[id] = s;
+			sweet_surface_users[id] = 1;
+			*(uint64_t *)s->state->getBytesNoCopy() = id;   /* registry id */
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Add a user to a surface that may have left the table (port lookups). */
+static bool
+sweet_surface_get(SweetSurface *s)
+{
+	bool ok = true;
+	IOLockLock(sweet_surface_lock);
+	if (sweet_surface_table[s->id] == s) {
+		sweet_surface_users[s->id]++;
+	} else if (sweet_surface_table[s->id] == NULL) {
+		s->retain();
+		sweet_surface_table[s->id] = s;
+		sweet_surface_users[s->id] = 1;
+	} else {
+		ok = false;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return ok;
+}
+
+/* Drop a user; the last one removes the surface from the table. */
+static void
+sweet_surface_put(SweetSurface *s)
+{
+	bool drop = false;
+	IOLockLock(sweet_surface_lock);
+	if (sweet_surface_table[s->id] == s && --sweet_surface_users[s->id] == 0) {
+		sweet_surface_table[s->id] = NULL;
+		drop = true;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	if (drop) {
+		s->release();
+	}
+}
+
+SweetSurface *
+sweet_surface_copy(uint32_t id)
+{
+	SweetSurface *s = NULL;
+	if (id == 0 || id >= SWEET_SURFACE_MAX_ID || sweet_surface_lock == NULL) {
+		return NULL;
+	}
+	IOLockLock(sweet_surface_lock);
+	s = sweet_surface_table[id];
+	if (s != NULL) {
+		s->retain();
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return s;
+}
+
+/* The table lock; the framebuffer may publish a surface before the root starts. */
+static void
+sweet_surface_init_lock(void)
+{
+	if (sweet_surface_lock == NULL) {
+		IOLock *lock = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, lock, &sweet_surface_lock)) {
+			IOLockFree(lock);
+		}
+	}
+}
+
+static SweetSurface *
+sweet_surface_alloc(void)
+{
+	sweet_surface_init_lock();
+	SweetSurface *s = OSTypeAlloc(SweetSurface);
+	if (s == NULL || !s->init()) {
+		OSSafeReleaseNULL(s);
+		return NULL;
+	}
+	s->state = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, page_size, page_size);
+	if (s->state == NULL) {
+		s->release();
+		return NULL;
+	}
+	bzero(s->state->getBytesNoCopy(), page_size);
+	return s;
+}
+
+static bool
+sweet_surface_publish(SweetSurface *s)
+{
+	bool ok;
+	IOLockLock(sweet_surface_lock);
+	ok = sweet_surface_insert_locked(s);
+	IOLockUnlock(sweet_surface_lock);
+	return ok;
+}
+
+SweetSurface *
+sweet_surface_create_physical(uint64_t phys, uint32_t width, uint32_t height,
+    uint32_t bytesPerRow, uint32_t pixelFormat)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = bytesPerRow;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page(bytesPerRow * height);
+	s->memory = IOMemoryDescriptor::withPhysicalAddress(phys, s->allocSize, kIODirectionInOut);
+	s->mapCache = kIOMapWriteCombineCache;
+	if (s->memory == NULL || !sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
+
+mach_port_name_t
+sweet_surface_port_in_task(SweetSurface *s, task_t task)
+{
+	mach_port_name_t name = 0;
+	IOUserClient::copyPortNameForObjectInTask(task, s, &name);
+	return name;
+}
+
+static uint32_t
+sweet_dict_u32(OSDictionary *dict, const char *key, uint32_t def)
+{
+	OSNumber *n = OSDynamicCast(OSNumber, dict->getObject(key));
+	return n != NULL ? n->unsigned32BitValue() : def;
+}
+
+static uint32_t
+sweet_div_up(uint32_t a, uint32_t b)
+{
+	return b > 1 ? (a + b - 1) / b : a;
+}
+
+static uint32_t
+sweet_row_bytes(uint32_t width, uint32_t ew, uint32_t bpe)
+{
+	uint64_t row = (uint64_t)sweet_div_up(width, ew) * bpe;
+	return (uint32_t)((row + SWEET_SURFACE_ROW_ALIGN - 1) & ~(uint64_t)(SWEET_SURFACE_ROW_ALIGN - 1));
+}
+
+/* Geometry from the creation properties (IOSurface.h keys). */
+static IOReturn
+sweet_surface_layout(SweetSurface *s, OSDictionary *props)
+{
+	uint64_t end;
+
+	s->width = sweet_dict_u32(props, "IOSurfaceWidth", 0);
+	s->height = sweet_dict_u32(props, "IOSurfaceHeight", 0);
+	s->bytesPerElement = (uint16_t)sweet_dict_u32(props, "IOSurfaceBytesPerElement", 4);
+	s->elementWidth = (uint8_t)sweet_dict_u32(props, "IOSurfaceElementWidth", 1);
+	s->elementHeight = (uint8_t)sweet_dict_u32(props, "IOSurfaceElementHeight", 1);
+	s->pixelFormat = sweet_dict_u32(props, "IOSurfacePixelFormat", 0);
+	s->cacheMode = sweet_dict_u32(props, "IOSurfaceCacheMode", 0);
+	s->offset = sweet_dict_u32(props, "IOSurfaceOffset", 0);
+
+    /* HackiOS MiniIOSurface's allocation-time negotiation: with the GPU on,
+     * CoreAnimation can request b3a8 for the screen. Its two planes contain
+     * wide-range RGB10 and separate A8, which our BGRA panel does not scan.
+     * Allocate genuine BGRA instead, and return that actual geometry below.
+     * Never reinterpret memory supplied by a client, including malformed
+     * address properties. The binary wrap selectors bypass this function.
+     * AddressRanges is not implemented by this driver; do not silently turn
+     * that existing-memory request into a normalized owned allocation.
+     */
+    if (s->pixelFormat == 0x62336138u) { /* 'b3a8' */
+        if (props->getObject("IOSurfaceAddressRanges") != NULL) return kIOReturnUnsupported;
+        if (props->getObject("IOSurfaceAddress") == NULL) {
+            OSNumber *width = OSDynamicCast(OSNumber, props->getObject("IOSurfaceWidth"));
+            OSNumber *height = OSDynamicCast(OSNumber, props->getObject("IOSurfaceHeight"));
+            OSNumber *format = OSDynamicCast(OSNumber, props->getObject("IOSurfacePixelFormat"));
+            OSObject *rawOffset = props->getObject("IOSurfaceOffset");
+            OSNumber *offset = OSDynamicCast(OSNumber, rawOffset);
+            if (width == NULL || height == NULL || format == NULL ||
+                format->unsigned64BitValue() != 0x62336138u ||
+                width->unsigned64BitValue() == 0 || height->unsigned64BitValue() == 0 ||
+                width->unsigned64BitValue() > SWEET_SURFACE_MAX_DIM ||
+                height->unsigned64BitValue() > SWEET_SURFACE_MAX_DIM ||
+                (rawOffset != NULL && offset == NULL) ||
+                (offset != NULL && offset->unsigned64BitValue() > UINT32_MAX)) return kIOReturnBadArgument;
+            s->width = (uint32_t)width->unsigned64BitValue();
+            s->height = (uint32_t)height->unsigned64BitValue();
+            s->offset = offset != NULL ? (uint32_t)offset->unsigned64BitValue() : 0;
+            s->pixelFormat = 0x42475241u; /* 'BGRA', real bytes B G R A */
+            s->bytesPerElement = 4;
+            s->elementWidth = s->elementHeight = 1;
+            s->bytesPerRow = sweet_row_bytes(s->width, 1, 4);
+            s->planeCount = 0;
+            bzero(s->planes, sizeof(s->planes));
+            end = (uint64_t)s->offset + (uint64_t)s->bytesPerRow * s->height;
+            if (end == 0 || end > SWEET_SURFACE_MAX_ALLOC) return kIOReturnNoMemory;
+            uint64_t alloc = round_page(end);
+            if (alloc < end || alloc > SWEET_SURFACE_MAX_ALLOC) return kIOReturnNoMemory;
+            s->allocSize = (uint32_t)alloc;
+            static uint32_t normalized;
+            if (__atomic_fetch_add(&normalized, 1, __ATOMIC_RELAXED) < 16)
+                IOLog("UMI SURFACE v23: owned b3a8 -> BGRA %ux%u row=%u size=%u planes=0\n",
+                    s->width, s->height, s->bytesPerRow, s->allocSize);
+            return kIOReturnSuccess;
+        }
+    }
+	if (s->width > SWEET_SURFACE_MAX_DIM || s->height > SWEET_SURFACE_MAX_DIM ||
+	    s->bytesPerElement > 64 || s->elementWidth == 0 || s->elementHeight == 0) {
+		return kIOReturnBadArgument;
+	}
+	s->bytesPerRow = sweet_dict_u32(props, "IOSurfaceBytesPerRow",
+	    sweet_row_bytes(s->width, s->elementWidth, s->bytesPerElement));
+	if (s->bytesPerRow < (uint64_t)sweet_div_up(s->width, s->elementWidth) * s->bytesPerElement) {
+		return kIOReturnBadArgument;
+	}
+	end = (uint64_t)s->offset + (uint64_t)s->bytesPerRow * sweet_div_up(s->height, s->elementHeight);
+
+	OSArray *planes = OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
+	s->planeCount = 0;
+	if (planes != NULL) {
+		uint64_t next = s->offset;
+		if (planes->getCount() > SWEET_SURFACE_MAX_PLANES) {
+			return kIOReturnBadArgument;
+		}
+		for (unsigned int i = 0; i < planes->getCount(); i++) {
+			OSDictionary *pd = OSDynamicCast(OSDictionary, planes->getObject(i));
+			struct sweet_surface_plane *p = &s->planes[i];
+			if (pd == NULL) {
+				return kIOReturnBadArgument;
+			}
+			p->width = sweet_dict_u32(pd, "IOSurfacePlaneWidth", s->width);
+			p->height = sweet_dict_u32(pd, "IOSurfacePlaneHeight", s->height);
+			p->bytesPerElement = (uint16_t)sweet_dict_u32(pd, "IOSurfacePlaneBytesPerElement", 1);
+			p->elementWidth = (uint8_t)sweet_dict_u32(pd, "IOSurfacePlaneElementWidth", 1);
+			p->elementHeight = (uint8_t)sweet_dict_u32(pd, "IOSurfacePlaneElementHeight", 1);
+			if (p->width > SWEET_SURFACE_MAX_DIM || p->height > SWEET_SURFACE_MAX_DIM ||
+			    p->bytesPerElement > 64 || p->elementWidth == 0 || p->elementHeight == 0) {
+				return kIOReturnBadArgument;
+			}
+			p->bytesPerRow = sweet_dict_u32(pd, "IOSurfacePlaneBytesPerRow",
+			    sweet_row_bytes(p->width, p->elementWidth, p->bytesPerElement));
+			p->offset = sweet_dict_u32(pd, "IOSurfacePlaneOffset", (uint32_t)next);
+			p->size = sweet_dict_u32(pd, "IOSurfacePlaneSize",
+			    p->bytesPerRow * sweet_div_up(p->height, p->elementHeight));
+			next = round_page((uint64_t)p->offset + p->size);
+			if ((uint64_t)p->offset + p->size > end) {
+				end = (uint64_t)p->offset + p->size;
+			}
+		}
+		s->planeCount = planes->getCount();
+	}
+
+	uint64_t alloc = sweet_dict_u32(props, "IOSurfaceAllocSize", 0);
+	if (alloc < end) {
+		alloc = end;
+	}
+	alloc = round_page(alloc);
+	if (alloc == 0 || alloc > SWEET_SURFACE_MAX_ALLOC) {
+		return kIOReturnNoMemory;
+	}
+	s->allocSize = (uint32_t)alloc;
+	return kIOReturnSuccess;
+}
