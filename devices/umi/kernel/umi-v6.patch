+    0, 0,
+    false
+    },
+    { //    kIOHIDEventServiceUserClientCopyMatchingEvent
+    (IOExternalMethodAction) &IOHIDEventServiceUserClient::_copyMatchingEvent,
+    0, kIOUCVariableStructureSize,
+    0, kIOUCVariableStructureSize,
+    false
+    },
+};
