+        umi_ramlog_append(umi_ramlog, limit, sizeof(limit) - 1);
+    }
+    static const uint8_t end[] = "\nUMI PANIC ENTRY RAM END\n";
+    umi_ramlog_append(umi_ramlog, end, sizeof(end) - 1);
+    umi_ramlog_leave();
+    umi_ramlog_irq_restore(saved);
+}
+
+bool
+umi_ramlog_panic_control_enabled(void)
+{
+    return umi_paniclog_armed && umi_ramlog != NULL &&
+        umi_panic_control_requested && !umi_paniclog_entered;
+}
+
+static void
+umi_ramlog_probe(void)
+{
+    if (umi_ramlog_attempted) return;
+    umi_ramlog_attempted = true;
+    uint32_t enabled = 0, cpus = 0;
+    if (!PE_parse_boot_argn("umi-ramlog", &enabled, sizeof(enabled)) || enabled != 1 ||
+        !PE_parse_boot_argn("cpus", &cpus, sizeof(cpus)) || !umi_cpu_boot_valid(cpus)) return;
+    DTEntry root;
+    void const *compatible;
+    unsigned int length;
+    if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+        SecureDTGetProperty(root, "compatible", &compatible, &length) != kSuccess ||
+        !umi_ramlog_allowed(enabled, cpus, compatible, length)) return;
+    vm_offset_t mapped = ml_io_map_wcomb(UMI_RAMLOG_BASE, UMI_RAMLOG_BYTES);
+    if (mapped == 0) return;
+    uint64_t saved = umi_ramlog_irq_save();
+    umi_ramlog = (volatile struct umi_ramlog_header *)mapped;
+    umi_ramlog_prepare(umi_ramlog);
+    static const uint8_t banner[] = "\nUMI XNU RAMLOG BEGIN: console RAM only, UFS logging unchanged\n";
+    umi_ramlog_append(umi_ramlog, banner, sizeof(banner) - 1);
+    uint32_t panic_enabled = 0, control = 0;
+    umi_paniclog_armed = PE_parse_boot_argn("umi-paniclog", &panic_enabled,
+        sizeof(panic_enabled)) && panic_enabled == 1;
+    umi_panic_control_requested = PE_parse_boot_argn("umi-panic-control", &control,
+        sizeof(control)) && control == 1;
+    if (umi_paniclog_armed) {
+        static const uint8_t armed[] = "UMI PANIC ENTRY RAM ARMED\n";
+        umi_ramlog_append(umi_ramlog, armed, sizeof(armed) - 1);
+    }
+    umi_ramlog_irq_restore(saved);
+}
+
+static volatile uint32_t *fbcon_base;
+static uint32_t fbcon_width, fbcon_height, fbcon_stride;
+static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
+
+static void
+fbcon_clear_row(uint32_t row)
+{
+	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE; y++) {
+		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
+		for (uint32_t x = 0; x < fbcon_width; x++) {
+			line[x] = FBCON_BG;
+		}
+	}
+}
+
+static void
+fbcon_newline(void)
+{
+	fbcon_col = 0;
+	fbcon_row = (fbcon_row + 1) % fbcon_rows;
+	fbcon_clear_row(fbcon_row);
+	fbcon_clear_row((fbcon_row + 1) % fbcon_rows);
+}
+
+static void
+fbcon_init(void)
+{
+	fbcon_cols = fbcon_width / (8 * FBCON_SCALE);
+	fbcon_rows = fbcon_height / (16 * FBCON_SCALE);
+	fbcon_col = fbcon_row = 0;
+	for (uint32_t r = 0; r < fbcon_rows; r++) {
+		fbcon_clear_row(r);
+	}
+}
+
+static unsigned int
+fbcon_transmit_ready(void)
+{
+	return 1;
+}
+
+static void
+fbcon_transmit_data(uint8_t c)
+{
+	umi_ramlog_putc(c);
+	if (c == '\r') {
+		fbcon_col = 0;
+		return;
+	}
+	if (c == '\n') {
+		fbcon_newline();
+		return;
+	}
+	if (fbcon_col >= fbcon_cols) {
+		fbcon_newline();
+	}
+	const unsigned char *glyph = iso_font + c * 16;
+	uint32_t x0 = fbcon_col * 8 * FBCON_SCALE, y0 = fbcon_row * 16 * FBCON_SCALE;
+	for (uint32_t gy = 0; gy < 16; gy++) {
+		for (uint32_t sy = 0; sy < FBCON_SCALE; sy++) {
+			volatile uint32_t *line = fbcon_base + (y0 + gy * FBCON_SCALE + sy) * (fbcon_stride / 4) + x0;
+			for (uint32_t gx = 0; gx < 8; gx++) {
+				uint32_t px = (glyph[gy] & (1u << gx)) ? FBCON_FG : FBCON_BG;
+				for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
+					line[gx * FBCON_SCALE + sx] = px;
+				}
+			}
+		}
+	}
+	fbcon_col++;
+}
+
+static unsigned int
+fbcon_receive_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+fbcon_receive_data(void)
+{
+	return 0;
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) sweet_fbcon_serial_functions =
+{
+	.init = fbcon_init,
+	.transmit_ready = fbcon_transmit_ready,
+	.transmit_data = fbcon_transmit_data,
+	.receive_ready = fbcon_receive_ready,
+	.receive_data = fbcon_receive_data,
+	.device = SERIAL_SWEET_FBCON
+};
+
+static void
+fbcon_probe(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	uint32_t const *val;
+	unsigned int size;
+
+	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		return;
+	}
+	if (SecureDTGetProperty(entry, "width", (void const **)&val, &size) == kSuccess) {
+		fbcon_width = *val;
+	}
+	if (SecureDTGetProperty(entry, "height", (void const **)&val, &size) == kSuccess) {
+		fbcon_height = *val;
+	}
+	if (SecureDTGetProperty(entry, "stride", (void const **)&val, &size) == kSuccess) {
+		fbcon_stride = *val;
+	}
+	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * 4) {
+		return;
+	}
+	sweet_early_mark(17, "fbcon config read; mapping");
+	fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
+	sweet_early_mark(18, "fbcon mapping returned");
+	if (fbcon_base != NULL) {
+		umi_ramlog_probe();
+		register_serial_functions(&sweet_fbcon_serial_functions);
+	}
+}
