+/* Text into the framebuffer without taking the console lock, so the log stays
+ * visible even when the console path is wedged. iso_font is the console font
+ * (8x16 glyphs) defined in osfmk/console/iso_font.c. */
+extern unsigned char iso_font[256 * 16];
+
+static void
+sweet_fb_text(uint32_t *fb, uint32_t width, int x0, int y0, const char *s,
+    uint32_t len, uint32_t colour)
+{
+	int x = x0, y = y0;
+
+	for (uint32_t i = 0; i < len; i++) {
+		unsigned char c = (unsigned char)s[i];
+		if (c == '\n') {
+			x = x0;
+			y += 16;
+			continue;
+		}
+		if (c < 32 || c > 126) {
+			c = ' ';
+		}
+		if (x + 8 >= (int)width) {
+			x = x0;
+			y += 16;
+		}
+		const unsigned char *g = &iso_font[c * 16];
+		for (int row = 0; row < 16; row++) {
+			unsigned char bits = g[row];
+			uint32_t *p = fb + (uint64_t)(y + row) * width + x;
+			for (int col = 0; col < 8; col++) {
+				if (bits & (0x80 >> col)) {
+					p[col] = colour;
+				}
+			}
+		}
+		x += 8;
+	}
+}
+
+/* Draw the tail of the persistent log ring over the top of the screen. */
+static void
+sweet_fb_dump_log(void)
+{
+	PE_Video video;
+	static char text[1024];
+	uint32_t n, start, i;
+
+	PE_current_console(&video);
+	if (video.v_baseAddr == 0 || video.v_rowBytes == 0) {
+		return;
+	}
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total < 64) {
+		return;
+	}
+	n = (uint32_t)MIN(total, (uint64_t)sizeof(text) - 1);
+	start = (uint32_t)((total - n) % SWEET_LOG_SIZE);
+	for (i = 0; i < n; i++) {
+		text[i] = sweet_log_ring[(start + i) % SWEET_LOG_SIZE];
+	}
+	text[n] = 0;
+	/* keep the last ~12 lines */
+	uint32_t begin = 0, lines = 0;
+	for (i = n; i > 0 && lines < 12; i--) {
+		if (text[i - 1] == '\n') {
+			lines++;
+			begin = i;
+		}
+	}
+	uint32_t *fb = (uint32_t *)(video.v_baseAddr);
+	uint32_t w = video.v_rowBytes / 4;
+	uint32_t box = 14 * 16;
+	if (box > video.v_height) {
+		box = video.v_height;
+	}
+	for (uint32_t y = 0; y < box; y++) {
+		uint32_t *row = fb + (uint64_t)y * w;
+		for (uint32_t x = 0; x < w; x++) {
+			row[x] = 0x00000000;
+		}
+	}
+	sweet_fb_text(fb, w, 4, 8, text + begin, n - begin, 0x00ffffff);
+}
