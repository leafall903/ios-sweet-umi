+		hfs_lock_mount (hfsmp);
+		bcopy(&hfsmp->vcbFndrInfo, ap->a_data, sizeof(hfsmp->vcbFndrInfo));
+		hfs_unlock_mount(hfsmp);
+		break;
+
+	/* case HFS_MARK_BOOT_CORRUPT: _IO are the same */
+	case HFSIOC_MARK_BOOT_CORRUPT:
