+		printf("SWEET GPU: step 20: no /sweet-gpu zap-metadata in the ADT (mkadt.py --zap-mdt a650_zap.mdt)\n");
+		goto collapse;
+	}
+
+	/* stage 2: the signature. A yielding call that passes the .mdt, but touches no GPU (HackiOS step 12). */
+	uint64_t zap_header_pa = 0, zap_answer = ~0ull;
+	int32_t sig;
+	if (!gpu_zap_header(zap_mdt, zap_mdt_size, &zap_header_pa))
+		goto collapse;
+	printf("SWEET GPU: step 20: hand TrustZone the zap shader's signature to check (image %u)\n", PAS_GPU);
+	sig = gpu_scm("to take the zap shader's signature", SCM_64 | SCM_SIP | SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER,
+	    PAS_GPU, zap_header_pa, 0, &zap_answer);
+	if (sig != 0 || zap_answer != 0) {
+		printf("UMI GPU: TrustZone refused this exact zap signature (%d/%#llx); no inherited-shader assumption\n", sig,
+		    (unsigned long long)zap_answer);
+		goto collapse;
+	}
+	printf("UMI GPU: TrustZone accepted this device zap signature\n");
+	if (zap_stage < 3) {
+		printf("SWEET GPU: step 20: stopping after the signature (sweetgpuzap=2); =3 loads it and leaves secure mode\n");
+		goto collapse;
+	}
+
+	/* stage 3: where it goes, the segment, authenticate and run; then leave secure mode (HackiOS steps 19, 21) */
+	if (!zap_seg || zap_seg_size == 0 || zap_seg_size > ZAP_MEMORY_SIZE) {
+		printf("SWEET GPU: step 20: no /sweet-gpu zap-segment in the ADT (mkadt.py --zap-seg a650_zap.b02)\n");
+		goto collapse;
+	}
+	if (sig == 0 && zap_answer == 0) {
+		zap_answer = ~0ull;
+		printf("SWEET GPU: step 20: tell TrustZone where the image goes: %#x (%#x bytes)\n", ZAP_MEMORY_PA, ZAP_MEMORY_SIZE);
+		if (gpu_scm("where the image goes", SCM_64 | SCM_SIP | SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_GPU, ZAP_MEMORY_PA,
+		    ZAP_MEMORY_SIZE, &zap_answer) != 0 || zap_answer != 0) {
+			printf("SWEET GPU: step 20: TrustZone does not take the place (answer %#llx)\n", (unsigned long long)zap_answer);
+			goto collapse;
+		}
+		/* only now is that memory ours to write: TrustZone has just said it is not yet its own */
+		{
+			vm_offset_t zap_va = ml_io_map_wcomb(ZAP_MEMORY_PA, ZAP_MEMORY_SIZE);
+			if (!zap_va) { printf("UMI GPU: reserved zap mapping failed\n"); goto collapse; }
+			volatile uint8_t *zap = (volatile uint8_t *)zap_va;
+			printf("SWEET GPU: step 20: reserved memory begins %02x %02x %02x %02x, the segment %02x %02x %02x %02x; "
+			    "writing %u bytes at %#x\n", zap[0], zap[1], zap[2], zap[3], zap_seg[0], zap_seg[1], zap_seg[2],
+			    zap_seg[3], zap_seg_size, ZAP_MEMORY_PA);
+			for (unsigned int i = 0; i < ZAP_MEMORY_SIZE; ++i)
+				zap[i] = (i < zap_seg_size) ? zap_seg[i] : 0;
+			__asm__ volatile("dsb sy" ::: "memory");  /* the write-combine write lands before TrustZone reads it */
+		}
+		zap_answer = ~0ull;
+		printf("SWEET GPU: step 20: ask TrustZone to authenticate the zap shader and run it\n");
+		if (gpu_scm("to authenticate the zap shader and run it", SCM_64 | SCM_SIP | SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE,
+		    PAS_GPU, 0, 0, &zap_answer) != 0 || zap_answer != 0) {
+			printf("SWEET GPU: step 20: TrustZone does not authenticate the zap shader (answer %#llx)\n",
+			    (unsigned long long)zap_answer);
+			goto collapse;
+		}
+		zap_loaded = true;
+		printf("SWEET GPU: step 20: TRUSTZONE HAS AUTHENTICATED AND STARTED THE ZAP SHADER\n");
+	}
+
+	/* command the 3D core out of secure mode; the ring picks up after CP_ME_INIT (wptr 9 -> 11) */
+	printf("SWEET GPU: step 20: command the 3D core out of secure mode (CP_SET_SECURE_MODE 0)\n");
+	ring[at++] = (7u << 28) | 1u | (gpu_parity(1) << 15) | (CP_SET_SECURE_MODE << 16) | (gpu_parity(CP_SET_SECURE_MODE) << 23);
+	ring[at++] = 0;                              /* 0 = not secure */
+	gpu_to_memory(core_ring.mem, 4u * at);
+	gpu_wr(gpu, GPU_CP_RB_WPTR, at);
+	uint32_t srptr = ~0u, sstatus = ~0u;
+	for (unsigned i = 0; i < 20000 && (srptr != at || (sstatus & GPU_BUSY)); ++i) {
+		delay(100);
+		srptr = gpu_rd(gpu, GPU_CP_RB_RPTR);
+		sstatus = gpu_rd(gpu, GPU_RBBM_STATUS);
+	}
+	uint32_t sfault = gpu_rd(gpu, GPU_CP_HW_FAULT);
+	bool srefused = gpu_smmu_faulted(smmu, pg, npg, CORE_CONTEXT, "CORE");
+	printf("SWEET GPU:   rptr %u of %u, status %#x int %#x cp fault %#x cp int %#x protect %#x\n", srptr, at, sstatus,
+	    gpu_rd(gpu, GPU_RBBM_INT_0_STATUS), sfault, gpu_rd(gpu, GPU_CP_INTERRUPT_STATUS), gpu_rd(gpu, GPU_CP_PROTECT_STATUS));
+	if (srptr != at || (sstatus & GPU_BUSY) || sfault || srefused) {
+		printf("SWEET GPU: step 20: the command processor does not get through CP_SET_SECURE_MODE\n");
+		goto collapse;
+	}
+	printf("SWEET GPU: step 20: THE 3D CORE IS OUT OF SECURE MODE\n");
+	if (steps < 21)
+		goto collapse;
+
+	/* ---- step 21: a word written to our memory on command ---- */
+	static struct gpu_block core_scratch, core_target;
+	printf("SWEET GPU: step 21: map a page for the core; have it write %#x there (CP_MEM_WRITE)\n", TEST_WORD);
+	if (!gpu_block_new(&core_space, &core_scratch, CORE_SCRATCH_VA, 4096, PTE_CORE)) {
+		printf("SWEET GPU: step 21: no memory\n");
+		goto collapse;
+	}
+	gpu_smmu_refresh(smmu, pg, npg, CORE_CONTEXT, &core_space);
+	uint32_t from = at;
+	ring_pkt7(ring, &at, CP_MEM_WRITE, 3);
+	ring[at++] = CORE_SCRATCH_VA;
+	ring[at++] = 0;
+	ring[at++] = TEST_WORD;
+	if (!ring_run(gpu, smmu, pg, npg, core_ring.mem, from, at, "CP_MEM_WRITE")) {
+		printf("SWEET GPU: step 21: the command processor does not get through CP_MEM_WRITE\n");
+		goto collapse;
+	}
+	gpu_to_memory(core_scratch.mem, 64);
+	uint32_t word = *(volatile uint32_t *)core_scratch.mem;
+	printf("SWEET GPU: step 21: the page reads %#x: %s\n", word,
+	    word == TEST_WORD ? "THE 3D CORE WRITES OUR MEMORY ON COMMAND" : "not what the core was told to write");
+	if (word != TEST_WORD)
+		goto collapse;
+	/* what the kept GPU needs (sweetgpukeep=1): the core has proven it takes commands and writes memory */
+	kept.gpu = gpu;
+	kept.smmu = smmu;
+	kept.pg = pg;
+	kept.npg = npg;
+	kept.ring_mem = core_ring.mem;
+	kept.scratch = core_scratch.mem;
+	kept.khz = gpu_levels[level].khz;
+	kept.at = at;                                /* the ring as this step leaves it, read to the end */
+	core_proven = true;
+	if (steps < 22)
+		goto collapse;
+
+	/* ---- step 22: a frame filled by the core's 2D engine, on the panel ---- */
+	core_proven = false;                         /* (again, if this step gets through) */
+	printf("SWEET GPU: step 22: a %ux%u picture (%u bytes) for the core, filled in three bands by its 2D engine\n",
+	    TARGET_W, TARGET_H, TARGET_ROW * TARGET_H);
+	if (!gpu_block_new(&core_space, &core_target, CORE_TARGET_VA, TARGET_ROW * TARGET_H, PTE_CORE)) {
+		printf("SWEET GPU: step 22: no memory\n");
+		goto collapse;
+	}
+	gpu_smmu_refresh(smmu, pg, npg, CORE_CONTEXT, &core_space);
+	from = at;
+	ring_pkt7(ring, &at, CP_SET_MARKER, 1);
+	ring[at++] = RM6_BLIT2DSCALE;
+	ring_reg(ring, &at, REG_RB_CCU_CNTL, CCU_CNTL_BYPASS);
+	ring_fill(ring, &at, 0, TARGET_H / 3u, 255, 128, 0);           /* orange */
+	ring_fill(ring, &at, TARGET_H / 3u, 2u * TARGET_H / 3u, 255, 255, 255);      /* white */
+	ring_fill(ring, &at, 2u * TARGET_H / 3u, TARGET_H, 0, 128, 255);   /* blue */
+	/* out of the core's caches into memory; each event writes its word when done (Linux a6xx_submit) */
+	ring_pkt7(ring, &at, CP_EVENT_WRITE, 4);
+	ring[at++] = EVENT_FLUSH_COLOR_TS;
+	ring[at++] = CORE_SCRATCH_VA + 32u;
+	ring[at++] = 0;
+	ring[at++] = 0x0c0c0c0cu;
+	ring_pkt7(ring, &at, CP_EVENT_WRITE, 4);
+	ring[at++] = EVENT_CACHE_FLUSH_TS;
+	ring[at++] = CORE_SCRATCH_VA + 16u;
+	ring[at++] = 0;
+	ring[at++] = 0x0d0e0d0eu;
+	ring_pkt7(ring, &at, CP_WAIT_FOR_IDLE, 0);
+	if (!ring_run(gpu, smmu, pg, npg, core_ring.mem, from, at, "three solid fills, flushes")) {
+		printf("SWEET GPU: step 22: the core does not get through the fills\n");
+		goto collapse;
+	}
+	gpu_to_memory(core_scratch.mem, 64);
+	printf("SWEET GPU:   flush words %#x %#x (told 0xc0c0c0c, 0xd0e0d0e)\n",
+	    ((volatile uint32_t *)core_scratch.mem)[8], ((volatile uint32_t *)core_scratch.mem)[4]);
+	gpu_to_memory(core_target.mem, core_target.size);
+	const volatile uint8_t *px = (const volatile uint8_t *)core_target.mem;
+	const uint32_t mid = (TARGET_H / 2u) * TARGET_ROW + 540u * 4u, last = (TARGET_H - 1u) * TARGET_ROW + 1079u * 4u;
+	printf("SWEET GPU:   pixels (b g r a): first %02x %02x %02x %02x (told 00 80 ff ff), middle %02x %02x %02x %02x "
+	    "(ff ff ff ff), last %02x %02x %02x %02x (ff 80 00 ff)\n", px[0], px[1], px[2], px[3], px[mid], px[mid + 1],
+	    px[mid + 2], px[mid + 3], px[last], px[last + 1], px[last + 2], px[last + 3]);
+	if (px[2] != 0xff || px[1] != 0x80 || px[mid] != 0xff || px[mid + 2] != 0xff || px[last] != 0xff || px[last + 2] != 0) {
+		printf("SWEET GPU: step 22: the picture is not what the core was told to draw\n");
+		goto collapse;
+	}
+	printf("UMI GPU: offscreen 1080x2340 fill verified; not a CoreAnimation acceleration result\n");
+	unsigned show_picture = 0;
+	(void)PE_parse_boot_argn("umi-gpu-show", &show_picture, sizeof(show_picture));
+	if (show_picture != 1) {
+		kept.at = at;
+		core_proven = true;
+		goto collapse;
+	}
+	printf("SWEET GPU: step 22: THE GPU HAS DRAWN A PICTURE; copying it to the panel (%#x)\n", FB_PA);
+	/*
+	 * Boot 25 panicked here: ml_io_map_wcomb takes its addresses from
+	 * io_map's 8 MiB permanent submap (xnu-8796 arm/io_map.c IO_MAP_SIZE),
+	 * which a 10 MB framebuffer cannot fit. The unmappable kind comes from
+	 * the kernel map's data range and is given back after the copy.
+	 */
+	const vm_size_t fb_size = round_page(FB_ROW * TARGET_H);
+	vm_offset_t fb_va = ml_io_map_unmappable(FB_PA, fb_size, VM_WIMG_WCOMB);
+	if (!fb_va) {
+		printf("SWEET GPU: step 22: framebuffer map failed\n");
+		goto collapse;
+	}
+	for (uint32_t y = 0; y < TARGET_H; ++y) {
+		const volatile uint32_t *src = (const volatile uint32_t *)(core_target.mem + y * TARGET_ROW);
+		volatile uint32_t *dst = (volatile uint32_t *)(fb_va + y * FB_ROW);
+		for (uint32_t x = 0; x < TARGET_W; ++x)
+			dst[x] = src[x];
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	ml_io_unmap(fb_va, fb_size);
+	printf("SWEET GPU: step 22: A PICTURE DRAWN BY THE GPU IS ON THE PANEL: orange, white, blue from the top\n");
+	kept.at = at;
+	core_proven = true;
+
+collapse:
+	{
+		unsigned keep = 0;
+		bool retained = false, umi_dma_quiet = true;
+		(void)PE_parse_boot_argn("sweetgpukeep", &keep, sizeof(keep));
+		if (keep && core_proven) {
+			kept.sent = kept.at;
+			kept_free[0].start = KEPT_VA_START;
+			kept_free[0].size = KEPT_VA_SIZE;
+			kept_free_count = 1;
+			printf("SWEET GPU: sweetgpukeep=1: THE GPU IS KEPT ON (%u MHz, ring at word %u, addresses %#llx+%#llx)\n",
+			    kept.khz / 1000, kept.at, KEPT_VA_START, KEPT_VA_SIZE);
+			if (kept_self_test()) {
+				kept.on = true;
+				printf("SWEET GPU: kept: starting the SweetGPU service for programs\n");
+				SweetGPUStart();
+				retained = true;
+			} else {
+				printf("UMI GPU: not offered to programs; self-test failed, taking cleanup path\n");
+			}
+		}
+		if (!retained) {
+			/* HackiOS gpu_block_stop / Linux a6xx_gmu_shutdown, then a6xx_rpmh_stop */
+			if (core_started && gpu_core) {
+				/* Linux a6xx_bus_clear_pending_transactions: new requests, then all AXI, halted; let go */
+				printf("SWEET GPU: core before stop: status %#x rptr %u busy %#x\n", gpu_rd(gpu_core, GPU_RBBM_STATUS),
+				    gpu_rd(gpu_core, GPU_CP_RB_RPTR), gpu_rd(gmu_va, GMU_AO_GPU_CX_BUSY));
+				gpu_wr(gpu_core, GPU_GBIF_HALT, 1);
+				for (unsigned i = 0; i < 1000 && !(gpu_rd(gpu_core, GPU_GBIF_HALT_ACK) & 1u); ++i)
+					delay(10);
+				umi_dma_quiet = (gpu_rd(gpu_core, GPU_GBIF_HALT_ACK) & 1u) != 0;
+				gpu_wr(gpu_core, GPU_GBIF_HALT, 2);
+				for (unsigned i = 0; i < 1000 && !(gpu_rd(gpu_core, GPU_GBIF_HALT_ACK) & 2u); ++i)
+					delay(10);
+				umi_dma_quiet = umi_dma_quiet && ((gpu_rd(gpu_core, GPU_GBIF_HALT_ACK) & 2u) != 0);
+				printf("SWEET GPU: core bus halted (gbif halt_ack %#x), let go again\n", gpu_rd(gpu_core, GPU_GBIF_HALT_ACK));
+				gpu_wr(gpu_core, GPU_GBIF_HALT, 0);
+			}
+			if (gx_asked) {
+				gpu_wr(gmu_va, GMU_HOST2GMU_INTR_SET, GMU_GPU_CLEAR);
+				printf("SWEET GPU: 3D core given back (OOB clear)\n");
+			}
+			if (gmu_talks && gmu_tables) {
+				uint32_t slumber[3] = { 0, 0, 0 };
+				if (hfi_send("prepare slumber", HFI_PREPARE_SLUMBER, slumber, 3)) {
+					for (unsigned i = 0; i < 1000 && (gpu_rd(gmu_va, GMU_AO_GPU_CX_BUSY) & GMU_CX_BUSY_GPU); ++i)
+						delay(100);
+				}
+				printf("SWEET GPU: after slumber: cx busy %#x sptprac %#x gx gdsc %#010x rpmh_power_state %#x\n",
+				    gpu_rd(gmu_va, GMU_AO_GPU_CX_BUSY), gpu_rd(gmu_va, GMU_SPTPRAC_PWR_CLK),
+				    gpu_rd(cc, GPUCC_GX_GDSC), gpu_rd(gmu_va, GMU_RPMH_POWER_STATE));
+			}
+			if (gmu_started) {
+				gpu_wr(gmu_va, GMU_CM3_SYSRESET, 1);
+				printf("SWEET GPU: GMU held in reset again\n");
+				uint32_t gx = gpu_rd(cc, GPUCC_GX_GDSC);
+				if (gx & GDSC_PWR_ON) {
+					gpu_wr(cc, GPUCC_GX_GDSC, gx | GDSC_SW_COLLAPSE);
+					for (unsigned i = 0; i < 1000 && (gpu_rd(cc, GPUCC_GX_GDSC) & GDSC_PWR_ON); ++i)
+						delay(100);
+					printf("SWEET GPU: GX was still on: gx gdsc %#010x -> %#010x\n", gx, gpu_rd(cc, GPUCC_GX_GDSC));
+				}
+			}
+			if (zap_loaded) {
+				/* give the zap shader back to TrustZone; the next kernel loads its own (there is no phone restart) */
+				printf("SWEET GPU: zap shader %s\n", gpu_zap_unload() ? "given back to TrustZone" :
+				    "NOT given back: TrustZone keeps it; the next kernel will find it there");
+				zap_loaded = false;
+			}
+			if (rsc_programmed && gmu_rscc) {
+				/* vendor a6xx_rscc_sleep_sequence: the GMU's RPMh votes dropped */
+				gpu_wr(gmu_va, GMU_RSCC_CONTROL_REQ, 1);
+				for (unsigned i = 0; i < 1000 && !(gpu_rd(gmu_rscc, RSCC_RSC_STATUS0_DRV0) & RSCC_ASLEEP); ++i)
+					delay(100);
+				uint32_t st = gpu_rd(gmu_rscc, RSCC_RSC_STATUS0_DRV0);
+				gpu_wr(gmu_va, GMU_RSCC_CONTROL_REQ, 0);
+				printf("SWEET GPU: GMU's RPMh channel %s (rsc_status0 %#x)\n", (st & RSCC_ASLEEP) ? "asleep" :
+				    "DOES NOT GO TO SLEEP", st);
+			}
+			if (umi_smmu_snapshot.dirty) {
+				bool reset = !gmu_started || (gpu_rd(gmu_va, GMU_CM3_SYSRESET) & 1u);
+				bool gx_off = !(gpu_rd(cc, GPUCC_GX_GDSC) & GDSC_PWR_ON);
+				enum UmiGpuSmmuResult restored = umi_gpu_smmu_guard_restore(&umi_smmu_snapshot, &umi_smmu_io,
+				    reset && gx_off && umi_dma_quiet, &umi_smmu_diag);
+				printf("UMI GPU: SMMU restore=%d reset=%u gx_off=%u dma_quiet=%u index=%u observed=%#x\n",
+				    restored, reset, gx_off, umi_dma_quiet, umi_smmu_diag.index, umi_smmu_diag.observed);
+				if (restored != UMI_GPU_SMMU_OK) {
+					printf("UMI GPU: unresolved DMA/SMMU cleanup; retain memory and power, no forced clock-off\n");
+					return;
+				}
+			}
+
+			gpu_wr(cc, GPUCC_CX_GDSC, (gpu_rd(cc, GPUCC_CX_GDSC) & ~GDSC_SW_COLLAPSE) | (cx & GDSC_SW_COLLAPSE));
+			for (unsigned i = 0; i < 500 && (gpu_rd(cc, GPUCC_CX_GDSC) & GDSC_PWR_ON); ++i)
+				delay(100);
+			printf("SWEET GPU: CX collapsed again (cx gdsc %#010x)\n", gpu_rd(cc, GPUCC_CX_GDSC));
+		}
+	}
+done:
+	if (!kept.on && umi_clocks.gcc) umi_restore_clocks();
+	printf("SWEET GPU: done after step %u\n", steps);
+}
+
+static unsigned gpu_steps;
+static int gpu_sleep_chan;
+
+static void
+gpu_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 15;
+	uint64_t deadline;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweetgpudelay", &delay_s, sizeof(delay_s));
+	printf("SWEET GPU: probe in %u s\n", delay_s);
+	clock_interval_to_deadline(delay_s, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&gpu_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	sweet_gpu_probe(gpu_steps);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_gpu_init(void)
+{
+	thread_t thread;
+	unsigned enabled = 0;
+	PE_Video v;
+	DTEntry node;
+	const void *profile = NULL;
+	unsigned int profile_size = 0;
+	(void)PE_parse_boot_argn("umi-gpu-v20", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweetgpu", &gpu_steps, sizeof(gpu_steps));
+	if (enabled != 1 || gpu_steps == 0 || gpu_steps > 22)
+		return;
+	PE_current_console(&v);
+	if (v.v_baseAddr != FB_PA || v.v_width != TARGET_W ||
+	    v.v_height != TARGET_H || v.v_rowBytes != FB_ROW ||
+	    SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "umi-platform", &profile, &profile_size) != kSuccess ||
+	    profile_size != 16 || memcmp(profile, "umi-sm8250-a650\0", 16) != 0) {
+		printf("UMI GPU: explicit platform/framebuffer guard failed; hardware untouched\n");
+		return;
+	}
+	const char *keys[4] = { "gmu-firmware", "sqe-firmware", "zap-metadata", "zap-segment" };
+	const void *data[4] = { 0 };
+	unsigned sizes[4] = { 0 };
+	for (unsigned i = 0; i < 4; ++i) {
+		if (SecureDTGetProperty(node, keys[i], &data[i], &sizes[i]) != kSuccess) {
+			printf("UMI GPU: missing validated firmware input; hardware untouched\n");
+			return;
+		}
+	}
+	if (!umi_gpu_inputs(data[0], sizes[0], data[1], sizes[1], data[2], sizes[2], data[3], sizes[3])) {
+		printf("UMI GPU: malformed or unrecognized firmware inputs; hardware untouched\n");
+		return;
+	}
+	printf("UMI GPU: exact umi profile accepted, requested step %u\n", gpu_steps);
+	if (kernel_thread_start(gpu_thread, NULL, &thread) == KERN_SUCCESS)
+		thread_deallocate(thread);
+	else
+		printf("SWEET GPU: kernel_thread_start failed\n");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_keys.c
@@ -0,0 +1,182 @@
+/*
+ * Minimal polled SWEET keys. Call once after the scheduler is running.
+ * See hw-report.md: volume-up is PM6150L SID 4, NOT PM6150 SID 0.
+ * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an
+ * observer channel. No PMIC config, IRQ acknowledge or reset writes exist.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+void sweet_keys_init(void);
+
+#define KEYS_CORE_PA     0x0c440000u
+#define KEYS_OBS_PA      0x0e600000u
+#define KEYS_CNFG_PA     0x0c40a000u
+#define KEYS_PON_RT      0x0810u
+#define KEYS_GPIO_RT     0xc110u
+#define KEYS_NO_APID     0xffffu
+
+static vm_offset_t keys_core, keys_obs, keys_cnfg;
+static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
+static uint32_t keys_version, keys_last_status;
+static bool keys_started;
+static int keys_sleep_chan;
+
+static uint32_t
+keys_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* v5 can map one PPID more than once; prefer the apps-owned entry. */
+static uint16_t
+keys_find_apid(uint16_t ppid, uint32_t count)
+{
+	uint16_t found = KEYS_NO_APID;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = keys_rd(keys_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = keys_rd(keys_cnfg, 0x700u + 4u * i) & 7u;
+		if (found == KEYS_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+static bool
+keys_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	if (apid == KEYS_NO_APID) {
+		return false;
+	}
+	uint32_t off = 0x80u * apid; /* obs + EE(0)*0x10000 */
+	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(keys_obs + off) = cmd; /* EXT_READL, one byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		keys_last_status = keys_rd(keys_obs, off + 0x08u);
+		if (keys_last_status & 1u) {
+			if (keys_last_status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)keys_rd(keys_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	int state[3] = {0, 0, 0};
+	unsigned errors = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		uint8_t pon = 0, gpio = 0;
+		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+		if (!pok || !gok) {
+			if ((errors++ % 250u) == 0) {
+				printf("SWEET KEYS: read error pon-ok=%d gpio-ok=%d arb-status=%#x\n",
+				    pok, gok, keys_last_status);
+			}
+		} else {
+			errors = 0;
+		}
+		for (int k = 0; k < 3; ++k) {
+			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
+				    k, state[k], pon, gpio);
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		keys_wait();
+	}
+}
+
+void
+sweet_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+	keys_core = ml_io_map(KEYS_CORE_PA, 0x2000);
+	keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
+	keys_obs = ml_io_map(KEYS_OBS_PA, 0x10000);
+	if (!keys_core || !keys_cnfg || !keys_obs) {
+		printf("SWEET KEYS: MMIO mapping failed\n");
+		return;
+	}
+	keys_version = keys_rd(keys_core, 0);
+	uint32_t count = keys_rd(keys_core, 4) & 0x7ffu;
+	if (keys_version < 0x50000000u || keys_version >= 0x70000000u ||
+	    count == 0 || count > 512) {
+		printf("SWEET KEYS: unsupported arbiter version=%#x apids=%u\n",
+		    keys_version, count);
+		return;
+	}
+	keys_pon_apid = keys_find_apid(0x008, count);
+	keys_gpio_apid = keys_find_apid(0x4c1, count);
+	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
+	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+	bool mok = keys_read(keys_gpio_apid, 0xc140, &mode);
+	bool eok = keys_read(keys_gpio_apid, 0xc146, &en);
+	bool sok = keys_read(keys_gpio_apid, 0xc105, &subtype);
+	printf("SWEET KEYS: arb=%#x apids=%u pon-apid=%u gpio4-apid=%u pon=%#x/%d gpio=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d\n",
+	    keys_version, count, keys_pon_apid, keys_gpio_apid,
+	    pon, pok, gpio, gok, mode, mok, en, eok, subtype, sok);
+	/* GPIO configuration belongs to firmware. Diagnose, never repair it here. */
+	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
+	    mode & 3u : (mode >> 4) & 7u;
+	if (!eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
+		printf("SWEET KEYS: GPIO2 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
+		keys_gpio_apid = KEYS_NO_APID;
+	}
+	if (!pok && !gok) {
+		printf("SWEET KEYS: no readable keys; polling retained for recovery\n");
+	}
+	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_rpmh.c
@@ -0,0 +1,358 @@
+/*
+ * SWEET PM6150L L11C bring-up; see report.md for DT and source evidence.
+ * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
+ * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+
+/* Live downstream DT has two positional reg entries, no reg-names. */
+#define RH_RSC_PA       0x18220000u
+#define RH_TCS_PA       0x18220d00u
+#define RH_TCS_SIZE     0x3000u
+#define RH_DICT_PA      0x0c3f000cu
+#define RH_DRV          2u
+#define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
+#define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
+#define RH_TCS_STRIDE   0x2a0u
+#define RH_CMD_STRIDE   0x14u
+#define RH_IRQ_EN       0x00u
+#define RH_IRQ_STATUS   0x04u
+#define RH_IRQ_CLEAR    0x08u
+#define RH_WAIT         0x10u
+#define RH_CONTROL      0x14u
+#define RH_STATUS       0x18u
+#define RH_ENABLE       0x1cu
+#define RH_MSGID        0x30u
+#define RH_ADDR         0x34u
+#define RH_DATA         0x38u
+#define RH_CMD_STATUS   0x3cu
+#define RH_AMC_EN       (1u << 16)
+#define RH_TRIGGER      (1u << 24)
+#define RH_ISSUED       (1u << 8)
+#define RH_COMPLETE     (1u << 16)
+#define RH_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
+#define RH_DB_MAGIC     0x0c0330dbu
+#define RH_DB_HEADER    144u
+#define RH_DB_ENTRY     24u
+#define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
+#define RH_VRM          4u
+#define RH_TIMEOUT_US   100000u
+
+static vm_offset_t rh_rsc, rh_tcs, rh_dict, rh_db;
+static uint32_t rh_db_size;
+static unsigned rh_ncpt;
+static unsigned rh_lock;
+static bool rh_poisoned;
+
+static uint32_t
+rh_read(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+rh_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+rh_sync(uint32_t off, uint32_t value)
+{
+	rh_write(rh_tcs, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (rh_read(rh_tcs, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, rh_read(rh_tcs, off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+rh_db16(uint32_t off)
+{
+	uint32_t v = rh_read(rh_db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+rh_range(uint32_t off, uint32_t size)
+{
+	return off <= rh_db_size && size <= rh_db_size - off;
+}
+
+static int
+rh_map(void)
+{
+	if (!rh_rsc) {
+		rh_rsc = ml_io_map(RH_RSC_PA, 0x100);
+	}
+	if (!rh_tcs) {
+		rh_tcs = ml_io_map(RH_TCS_PA, RH_TCS_SIZE);
+	}
+	if (!rh_dict) {
+		rh_dict = ml_io_map(RH_DICT_PA, 8);
+	}
+	if (!rh_rsc || !rh_tcs || !rh_dict) {
+		printf("SWEET RPMH: RSC/locator mapping failed\n");
+		return ENOMEM;
+	}
+	uint32_t id = rh_read(rh_rsc, 0);
+	uint32_t solver = rh_read(rh_rsc, 4);
+	uint32_t config = rh_read(rh_rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	rh_ncpt = (config >> 27) & 0x1fu;
+	printf("SWEET RPMH: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, rh_ncpt);
+	/* This client implements the pre-v3 layout only; do not guess v3 offsets. */
+	if ((major != 1 && major != 2) || config == 0xffffffffu ||
+	    solver == 0xffffffffu || count < RH_NORMAL_N ||
+	    count > RH_TCS_SIZE / RH_TCS_STRIDE || rh_ncpt < 3 || rh_ncpt > 16) {
+		printf("SWEET RPMH: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	if (!rh_db) {
+		uint32_t pa = rh_read(rh_dict, 0);
+		uint32_t size = rh_read(rh_dict, 4);
+		printf("SWEET RPMH: cmd-db locator=%#x pa=%#x size=%#x\n", RH_DICT_PA, pa, size);
+		/* Firmware supplies the reserved RAM address; never scan physical RAM. */
+		if (pa < 0x80000000u || (pa & 3u) || (size & 3u) ||
+		    size < RH_DB_HEADER || size > RH_DB_MAX ||
+		    (uint64_t)pa + size > 0x100000000ULL) {
+			printf("SWEET RPMH: invalid cmd-db locator\n");
+			return EINVAL;
+		}
+		rh_db = ml_io_map(pa, size);
+		if (!rh_db) {
+			return ENOMEM;
+		}
+		rh_db_size = size;
+	}
+	uint32_t db_version = rh_read(rh_db, 0);
+	uint32_t magic = rh_read(rh_db, 4);
+	uint32_t flags = rh_read(rh_db, 140);
+	printf("SWEET RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+	    db_version, magic, rh_read(rh_db, 136), flags);
+	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
+	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		printf("SWEET RPMH: unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+rh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			if (slave != RH_VRM || (addr >> 16) != RH_VRM || (addr & 15u) ||
+			    !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
+				printf("SWEET RPMH: invalid VRM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("SWEET RPMH: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
+			    res, addr, slave, rh_db16(h + 8),
+			    rh_read(rh_db, e + 8), rh_read(rh_db, e + 12));
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static bool
+rh_free(unsigned t)
+{
+	uint32_t b = t * RH_TCS_STRIDE;
+	/* Idle alone is insufficient: a sleep/wake payload can be armed and idle. */
+	return rh_read(rh_tcs, b + RH_STATUS) != 0 &&
+	    rh_read(rh_tcs, b + RH_STATUS) != 0xffffffffu &&
+	    rh_read(rh_tcs, b + RH_CONTROL) == 0 &&
+	    rh_read(rh_tcs, b + RH_ENABLE) == 0 &&
+	    rh_read(rh_tcs, b + RH_WAIT) == 0 &&
+	    !(rh_read(rh_tcs, RH_IRQ_STATUS) & (1u << t));
+}
+
+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	int chosen = -1;
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		printf("SWEET RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < rh_ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
+				printf("SWEET RPMH: conflicting inherited L11C request in TCS%u\n", t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	rh_poisoned = true;
+	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+	printf("SWEET RPMH: TCS%u ACTIVE %u mV mode=7 enable=1 irq-enable=%#x\n", t, mv, irq_en);
+	for (unsigned c = 0; c < 3; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + RH_ADDR, address + offsets[c]) ||
+		    !rh_sync(cmd + RH_DATA, values[c])) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + RH_WAIT, 7) || !rh_sync(b + RH_ENABLE, 7) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[3] = {0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < 3; ++c) {
+			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		printf("SWEET RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("SWEET RPMH: L11C ACTIVE vote complete (rail voltage requires hardware verification)\n");
+	return 0;
+}
+
+int
+sweet_rpmh_vreg_enable(const char *res, unsigned mv)
+{
+	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
+	if (!res || strcmp(res, "ldoc11") || mv < 2950 || mv > 3400) {
+		printf("SWEET RPMH: expected ldoc11 and 2950..3400 mV\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send(address, mv);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_sample.c
@@ -0,0 +1,88 @@
+/*
+ * SWEET process sampler: where is a daemon stuck?
+ *
+ * The phone has no debugger and daemons log nowhere readable. Every
+ * interval a kernel thread prints, for each process named in boot-arg
+ * sweetsample (comma separated, default "SpringBoard,backboardd"; "-" = off)
+ * and for each of its threads, the user pc/lr/sp and a frame-pointer
+ * backtrace as "SMP name[pid] tN pc ... lr ... bt ..." (header line with the
+ * shared region slide and the main binary's mach header, to symbolicate
+ * with tools/sweet-crash.py). A thread blocked in a syscall shows the
+ * syscall stub in pc and its caller in lr/bt.
+ *
+ * First sample 90 s after start, then every 120 s, 40 samples at most.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+extern task_t proc_task(proc_t);
+extern int hz;
+extern void sweet_sample_start(void);
+
+static char sweet_sample_names[128];
+
+static bool
+sweet_sample_wanted(const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = sweet_sample_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+extern void sweet_sample_task(const char *name, int pid, task_t task);  /* osfmk/kern/exception.c */
+
+static int
+sweet_sample_proc(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (sweet_sample_wanted(name)) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			sweet_sample_task(name, proc_pid(p), task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	if (!PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
+		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
+	}
+	if (sweet_sample_names[0] == '-') {
+		return;
+	}
+	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+	for (int i = 0; i < 40; i++) {
+		printf("SMP --- sample %d\n", i);
+		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+	}
+}
+
+void
+sweet_sample_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_spmi.c
@@ -0,0 +1,126 @@
+/*
+ * Battery-only adaptation of input/sweet_keys.c, observer EXT_READL.
+ * PMIC READ ONLY. The only MMIO store issues a one-byte read command.
+ * No interrupt clear, peripheral enable, charger config, or PMIC writes.
+ * Init is serialized by the single built-in SweetBattery personality.
+ * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <IOKit/IOLocks.h>
+#include "sweet_spmi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define SP_CORE_PA 0x0c440000u
+#define SP_OBS_PA  0x0e600000u
+#define SP_CFG_PA  0x0c40a000u
+#define SP_NO_APID 0xffffu
+
+static vm_offset_t sp_core, sp_obs, sp_cfg;
+static IOLock *sp_lock;
+static unsigned sp_count;
+static bool sp_attempted, sp_ready;
+/* A timed-out command may complete late: never reuse that lane this boot. */
+static bool sp_poisoned[512];
+
+static uint32_t
+sp_rd(vm_offset_t base, unsigned off)
+{
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static uint16_t
+sp_find_apid(unsigned ppid)
+{
+	uint16_t found = SP_NO_APID;
+	for (unsigned i = 0; i < sp_count; ++i) {
+		uint32_t map = sp_rd(sp_core, 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * i) & 7u;
+		if (found == SP_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+int
+sweet_spmi_init(void)
+{
+	if (sp_attempted) {
+		return sp_ready ? 0 : -1;
+	}
+	sp_attempted = true;
+	sp_lock = IOLockAlloc();
+	if (!sp_lock) {
+		return -1;
+	}
+	sp_core = ml_io_map(SP_CORE_PA, 0x2000);
+	sp_cfg = ml_io_map(SP_CFG_PA, 0x1000);
+	sp_obs = ml_io_map(SP_OBS_PA, 0x10000); /* EE 0, 512 * 0x80 */
+	if (!sp_core || !sp_cfg || !sp_obs) {
+		printf("SWEET BATTERY: SPMI mapping failed\n");
+		return -1;
+	}
+	uint32_t arb_version = sp_rd(sp_core, 0);
+	sp_count = sp_rd(sp_core, 4) & 0x7ffu;
+	if (arb_version < 0x50000000u || arb_version >= 0x70000000u ||
+	    !sp_count || sp_count > 512) {
+		printf("SWEET BATTERY: unsupported SPMI arb=%#x APIDs=%u\n",
+		    arb_version, sp_count);
+		return -1;
+	}
+	sp_ready = true;
+	printf("SWEET BATTERY: SPMI arb=%#x APIDs=%u, observer reads only\n",
+	    arb_version, sp_count);
+	return 0;
+}
+
+int
+sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
+{
+	/* Restrict access to the battery blocks; keys retain their own lanes. */
+	unsigned peripheral = addr >> 8;
+	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
+	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
+	    peripheral != 0x13 && peripheral != 0x48)) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned off = 0x80u * apid;
+	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd; /* EXT_READL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				IOLockUnlock(sp_lock);
+				return -1;
+			}
+			*out = (uint8_t)sp_rd(sp_obs, off + 0x18u);
+			IOLockUnlock(sp_lock);
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: SPMI timeout sid=%u addr=%#x APID=%u disabled\n",
+	    sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_spmi.h b/bsd/dev/sweet_spmi.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_spmi.h
@@ -0,0 +1,14 @@
+/* Shared C/C++ interface. Init once, on the SweetBattery start thread. */
+#ifndef SWEET_BATTERY_SPMI_H
+#define SWEET_BATTERY_SPMI_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+int sweet_spmi_init(void);
+/* Thread context only; 0 success, -1 failure; *out unchanged on failure. */
+int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_touch.c
@@ -0,0 +1,660 @@
+/*
+ * SWEET SE7 FIFO I2C / GT9896 Yellowstone / Focaltech 54:52 bring-up.
+ * Call once after the scheduler is running; all work runs on one thread.
+ * Requires ABL-loaded GENI I2C firmware; votes L11C through sweet_rpmh.c.
+ * No firmware/config upload or direct PMIC writes. Only IC data write:
+ * zero to GT9896's event status after reading a report. See touch2/report.md.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_touch_init(void);
+
+#define TOUCH_SE_PA      0x00a84000u
+#define TOUCH_GCC_PA     0x00100000u
+#define TOUCH_NORTH_PA   0x03900000u /* DT TLMM + NORTH (0x500000) */
+#define TOUCH_GCC_VOTE   0x5200cu
+#define TOUCH_RCG       0x18148u    /* wrapper1 LOCAL S1 = global SE7 */
+#define TOUCH_GPIO_CFG(n) ((uint32_t)(n) * 0x1000u)
+#define TOUCH_GPIO_IO(n)  (TOUCH_GPIO_CFG(n) + 4u)
+#define TOUCH_MAX        10u
+#define TOUCH_GOODIX     1
+#define TOUCH_FTS        2
+/* GT9896 is Yellowstone in Xiaomi sweet-r-oss, not the Berlin protocol. */
+#define GOODIX_PID_REG   0x4022u
+#define GOODIX_EVENT_REG 0x4180u
+#define GOODIX_HEAD_LEN  8u
+#define GOODIX_POINT_LEN 8u
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                         (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+/* geni_se_config_packing(8, 4, true, true, true): start bits 7/15/23/31,
+ * MSB-to-LSB, length 8, STOP only on vector 3. FIFO bytes remain LSB first. */
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+static struct {
+	vm_offset_t se, gcc, gpio;
+	bool started, dead, probing;
+	int kind, irq_hint;
+	uint32_t irq_status, irq_last, active;
+	unsigned sent, got;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+} st;
+static int touch_sleep_chan;
+
+static uint32_t
+touch_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+touch_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+touch_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+touch_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(touch_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(st.gpio, off);
+	if (out) {
+		/* Set the desired latch before enabling output (reset is active low). */
+		touch_wr(st.gpio, TOUCH_GPIO_IO(pin),
+		    (touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(st.gpio, off, cfg);
+}
+
+static bool
+touch_clocks(void)
+{
+	/* Vote on only wrapper1 and SE7, preserving other clock users. */
+	uint32_t mask = (0x0fu << 18) | (1u << 23);
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | mask);
+	uint32_t dfs = touch_rd(st.gcc, TOUCH_RCG + 0x14u);
+	uint32_t cfg = touch_rd(st.gcc, TOUCH_RCG + 4u);
+	printf("SWEET TOUCH: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    touch_rd(st.gcc, TOUCH_GCC_VOTE), touch_rd(st.gcc, TOUCH_RCG), cfg, dfs);
+	if (dfs & 1u) {
+		/* SE CLK_SEL=0 selects DFS performance level 0. Do not alter tables. */
+		cfg = touch_rd(st.gcc, TOUCH_RCG + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("SWEET TOUCH: DFS level0=%#x is not XO/1; need clock integration\n", cfg);
+			return false;
+		}
+	} else {
+		/* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		touch_wr(st.gcc, TOUCH_RCG + 4u, cfg);
+		touch_wr(st.gcc, TOUCH_RCG, touch_rd(st.gcc, TOUCH_RCG) | 1u);
+		if (!touch_wait_clear(st.gcc, TOUCH_RCG, 1u)) {
+			printf("SWEET TOUCH: RCG update timeout\n");
+			return false;
+		}
+	}
+	const uint32_t branches[] = {0x18004, 0x18008, 0x1800c, 0x18010, 0x18144};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!touch_wait_clear(st.gcc, branches[i], 1u << 31)) {
+			printf("SWEET TOUCH: GCC branch %#x halted (%#x)\n", branches[i],
+			    touch_rd(st.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Called only for a transfer started by this driver, including a stretched TX. */
+static void
+touch_abort(void)
+{
+	touch_wr(st.se, SE_CTRL, 2); /* abort M command, release held bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (touch_rd(st.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true;
+		printf("SWEET TOUCH: abort failed status=%#x irq=%#x; stopping\n",
+		    touch_rd(st.se, SE_STATUS), touch_rd(st.se, SE_IRQ));
+	}
+	/* Bound drain even if the hardware reports an impossible FIFO count. */
+	for (unsigned i = 0; i < 64 && (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)touch_rd(st.se, SE_RX);
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	if (touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) {
+		st.dead = true;
+		printf("SWEET TOUCH: TX FIFO not empty after abort; stopping\n");
+	}
+}
+
+/* Keep all observed bits for diagnostics, even if a watermark was cleared. */
+static uint32_t
+touch_irq(void)
+{
+	st.irq_last = touch_rd(st.se, SE_IRQ);
+	st.irq_status |= st.irq_last;
+	return st.irq_last;
+}
+
+/* One Linux-style FIFO message. TX is at most 3 bytes; RX at most 90. */
+static int
+touch_msg_run(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (st.dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true; /* no other SE7 owner is supported */
+		return EBUSY;
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SE_TX_WM, nt ? 1u : 0u);
+	touch_wr(st.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	touch_wr(st.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = touch_irq();
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			/* A completed NACK is normal during address probing. Aborting an
+			 * idle sequencer may never produce ABORT_DONE. Wait for completion
+			 * and leave a clean idle engine available for the other IC. */
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = touch_irq();
+			}
+			if ((irq & SE_DONE) && !(touch_rd(st.se, SE_STATUS) & 1u) &&
+			    !(touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				touch_wr(st.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !st.sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			touch_wr(st.se, SE_TX, word);
+			st.sent = nt;
+			touch_wr(st.se, SE_TX_WM, 0);
+		}
+		uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64 || count > (nr - st.got + 3u) / 4u) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = touch_rd(st.se, SE_RX);
+			for (unsigned j = 0; j < 4 && st.got < nr; ++j) {
+				rx[st.got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is checked after draining RX, so final short words aren't lost. */
+		if (irq & SE_DONE) {
+			/* Re-sample after the final drain; a late error must beat DONE. */
+			irq = touch_irq();
+			if (irq & SE_ERRORS) {
+				continue;
+			}
+			touch_wr(st.se, SE_IRQ_CLR, irq);
+			if (st.got == nr && st.sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		/* Preserve DONE/errors if they arrive during this iteration. */
+		touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	touch_abort();
+	return err;
+}
+
+static int
+touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	st.irq_status = st.irq_last = 0;
+	st.sent = st.got = 0;
+	int err = touch_msg_run(addr, tx, nt, rx, nr, stretch);
+	if (st.probing) {
+		printf("SWEET TOUCH: probe xfer addr=%#x %s len=%u stretch=%u err=%d irq=%#x seen=%#x tx=%u rx=%u status=%#x\n",
+		    addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u,
+		    err, st.irq_last, st.irq_status, st.sent, st.got,
+		    touch_rd(st.se, SE_STATUS));
+	}
+	return err;
+}
+
+static int
+touch_read(uint8_t addr, uint16_t reg, bool wide, uint8_t *buf, unsigned len)
+{
+	uint8_t ptr[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
+	int err = touch_msg(addr, wide ? ptr : ptr + 1, wide ? 2u : 1u,
+	    NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	/* STOP_STRETCH on the pointer write retains the bus for a repeated START. */
+	return touch_msg(addr, NULL, 0, buf, len, false);
+}
+
+static int
+touch_goodix_ack(void)
+{
+	const uint8_t ack[3] = {GOODIX_EVENT_REG >> 8, GOODIX_EVENT_REG & 0xffu, 0};
+	return touch_msg(0x5d, ack, sizeof(ack), NULL, 0, false);
+}
+
+/* Raw read only: 0x8240 is the vendor's generic/older VERSION candidate,
+ * not a second accepted GT9896 identity. Never try a four-byte Berlin pointer:
+ * on this 16-bit IC the extra bytes would be register data writes. */
+static int
+touch_probe_info(uint16_t reg, uint8_t *buf)
+{
+	memset(buf, 0xa5, 32);
+	int err = touch_read(0x5d, reg, true, buf, 32);
+	printf("SWEET TOUCH: probe info reg=%#x len=32 err=%d irq=%#x seen=%#x\n",
+	    reg, err, st.irq_last, st.irq_status);
+	if (!err) {
+		for (unsigned off = 0; off < 32; off += 16) {
+			char line[49];
+			for (unsigned j = 0; j < 16; ++j) {
+				(void)snprintf(line + j * 3u, 4, "%02x ", buf[off + j]);
+			}
+			printf("SWEET TOUCH: probe raw %#x: %s\n", reg + off, line);
+		}
+	}
+	return err;
+}
+
+static unsigned
+touch_be16(const uint8_t *p)
+{
+	return ((unsigned)p[0] << 8) | p[1];
+}
+
+static bool
+touch_checksum(const uint8_t *buf, unsigned len)
+{
+	if (len < 2) {
+		return false;
+	}
+	unsigned sum = 0;
+	for (unsigned i = 0; i + 2 < len; ++i) {
+		sum += buf[i];
+	}
+	return (sum & 0xffffu) == touch_be16(buf + len - 2);
+}
+
+static void
+touch_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(st.active & bit) || x[id] != st.x[id] || y[id] != st.y[id]) {
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+			}
+			st.x[id] = x[id];
+			st.y[id] = y[id];
+		} else if (st.active & bit) {
+			sweet_hid_touch((int)id, 0, st.x[id], st.y[id]);
+		}
+	}
+	st.active = mask;
+}
+
+static int
+touch_goodix(void)
+{
+	uint8_t buf[90];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(0x5d, GOODIX_EVENT_REG, true, buf, GOODIX_HEAD_LEN);
+	if (err) {
+		return err;
+	}
+	if (!(buf[0] & 0x80u)) {
+		/* Do not acknowledge firmware/config requests that we cannot service. */
+		if (buf[0] & 0x40u) {
+			return ENOTSUP;
+		}
+		return 0; /* no new touch frame: retain current contacts */
+	}
+	if (!touch_checksum(buf, GOODIX_HEAD_LEN)) {
+		return EIO; /* header untrusted: no write to the IC */
+	}
+	unsigned n = buf[2] & 15u;
+	if (n > TOUCH_MAX) {
+		(void)touch_goodix_ack();
+		return EIO;
+	}
+	if (n) {
+		err = touch_read(0x5d, GOODIX_EVENT_REG + GOODIX_HEAD_LEN, true,
+		    buf + GOODIX_HEAD_LEN, n * GOODIX_POINT_LEN + 2u);
+		if (err) {
+			return err;
+		}
+		if (!touch_checksum(buf + GOODIX_HEAD_LEN, n * GOODIX_POINT_LEN + 2u)) {
+			(void)touch_goodix_ack();
+			return EIO;
+		}
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + GOODIX_HEAD_LEN + i * GOODIX_POINT_LEN;
+		unsigned id = p[0] >> 4;
+		unsigned px = touch_be16(p + 2), py = touch_be16(p + 4);
+		/* Low nibble 1/3 denotes pen data in the vendor parser. */
+		if ((p[0] & 15u) == 1u || (p[0] & 15u) == 3u || id >= TOUCH_MAX ||
+		    (mask & (1u << id)) || px > 1079 || py > 2399) {
+			(void)touch_goodix_ack();
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	err = touch_goodix_ack();
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	return err;
+}
+
+static int
+touch_focaltech(void)
+{
+	uint8_t buf[63];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0, seen = 0;
+	int err = touch_read(0x38, 0, false, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	unsigned n = buf[2] & 15u, active = 0;
+	if ((buf[0] & 0x70u) || n > TOUCH_MAX) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *p = buf + 3u + 6u * i;
+		unsigned id = p[2] >> 4, event = p[0] >> 6;
+		if (id >= TOUCH_MAX) {
+			break; /* vendor's unused-record sentinel */
+		}
+		if (seen & (1u << id)) {
+			return EIO;
+		}
+		seen |= 1u << id;
+		if (event == 1u) {
+			continue; /* UP record */
+		}
+		if (event == 3u) {
+			return EIO;
+		}
+		unsigned px = ((unsigned)(p[0] & 15u) << 8) | p[1];
+		unsigned py = ((unsigned)(p[2] & 15u) << 8) | p[3];
+		if (px > 1079 || py > 2399) {
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+		++active;
+	}
+	if (active != n) {
+		return EIO;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static bool
+touch_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	printf("SWEET TOUCH: se7 fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx,
+	    touch_rd(st.se, 0x908));
+	if (((fw >> 8) & 0xffu) != 3u || (touch_rd(st.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SWEET TOUCH: need ABL-loaded I2C firmware and 32-bit FIFOs; probes skipped\n");
+		return false;
+	}
+	if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+		printf("SWEET TOUCH: SE7 already busy; probes skipped\n");
+		return false;
+	}
+	touch_wr(st.se, 0xe18, 0); /* no GSI events */
+	touch_wr(st.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	touch_wr(st.se, 0x644, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	touch_wr(st.se, SE_CLK_SEL, 0);
+	touch_wr(st.se, SE_MCLK, (7u << 4) | 1u);
+	touch_wr(st.se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+	/* Linux 8-bit I2C packing: MSB on the wire, LSB byte first in FIFO. */
+	touch_wr(st.se, 0x254, 0);
+	touch_wr(st.se, 0x260, SE_PACK0);
+	touch_wr(st.se, 0x264, SE_PACK1);
+	touch_wr(st.se, 0x284, SE_PACK0);
+	touch_wr(st.se, 0x288, SE_PACK1);
+	touch_wr(st.se, SE_TX_WM, 0);
+	touch_wr(st.se, 0x810, 0);
+	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	printf("SWEET TOUCH: packing tx=%#x/%#x rx=%#x/%#x gran=%#x\n",
+	    touch_rd(st.se, 0x260), touch_rd(st.se, 0x264),
+	    touch_rd(st.se, 0x284), touch_rd(st.se, 0x288), touch_rd(st.se, 0x254));
+	if (touch_rd(st.se, 0x260) != SE_PACK0 || touch_rd(st.se, 0x264) != SE_PACK1 ||
+	    touch_rd(st.se, 0x284) != SE_PACK0 || touch_rd(st.se, 0x288) != SE_PACK1 ||
+	    touch_rd(st.se, 0x254) != 0) {
+		printf("SWEET TOUCH: packing readback mismatch; probes skipped\n");
+		return false;
+	}
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SWEET TOUCH: inherited FIFO data; probes skipped\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	/*
+	 * Start late (boot-arg sweettouchdelay, seconds): if the bus access
+	 * below hangs the SoC, the persistent log and the GUI got there first.
+	 */
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET TOUCH: starting in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	printf("SWEET TOUCH: mapping GCC/TLMM/SE7\n");
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x5b000);
+	st.se = ml_io_map(TOUCH_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !st.se) {
+		printf("SWEET TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	if (!touch_clocks() || !touch_se_init()) {
+		goto out;
+	}
+	printf("SWEET TOUCH: TLMM reset=%#x irq=%#x vdd90=%#x; voting L11C through RPMh\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(8)), touch_rd(st.gpio, TOUCH_GPIO_IO(9)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(90)));
+	/* Keep the IC in reset while its rails settle; IRQ stays an input. */
+	touch_gpio(9, 0, 3, 3, false, false); /* IRQ input, 8 mA, pull-up */
+	touch_gpio(8, 0, 3, 3, true, false);
+	int power_error = sweet_rpmh_vreg_enable("ldoc11", 3200);
+	if (power_error) {
+		printf("SWEET TOUCH: L11C RPMh enable failed %d; probes skipped\n", power_error);
+		goto out;
+	}
+	touch_gpio(90, 0, 0, 0, true, true); /* board digital power enable */
+	touch_wait(10); /* conservative rail settling; not a DT timing value */
+	touch_gpio(6, 1, 0, 0, false, false); /* qup11 SDA/SCL, 2 mA */
+	touch_gpio(7, 1, 0, 0, false, false);
+	/* Vendor GT9896 dev_confirm: reset low 2 ms, then high. */
+	touch_gpio(8, 0, 3, 3, true, false);
+	touch_wait(2);
+	touch_gpio(8, 0, 3, 3, true, true);
+	touch_wait(300); /* exceeds vendor 5 ms test + 95 ms post-test wait */
+	uint8_t gid[32], legacy[32], fid1 = 0, fid2 = 0;
+	st.probing = true;
+	int ge = touch_probe_info(GOODIX_PID_REG, gid);
+	printf("SWEET TOUCH: probe 0x5d err=%d pid=%02x%02x%02x%02x fw=%02x.%02x.%02x.%02x irq=%#x\n",
+	    ge, gid[0], gid[1], gid[2], gid[3], gid[8], gid[9], gid[10], gid[11], st.irq_status);
+	(void)touch_probe_info(0x8240, legacy);
+	int fe1 = touch_read(0x38, 0xa3, false, &fid1, 1);
+	int fe2 = touch_read(0x38, 0x9f, false, &fid2, 1);
+	printf("SWEET TOUCH: probe 0x38 err=%d/%d chip-id=%02x:%02x irq=%#x\n",
+	    fe1, fe2, fid1, fid2, st.irq_status);
+	st.probing = false;
+	bool goodix = !ge && gid[0] == '9' && gid[1] == '8' && gid[2] == '9' && gid[3] == '6';
+	bool fts = !fe1 && !fe2 && fid1 == 0x54 && fid2 == 0x52;
+	if (st.dead || goodix == fts) {
+		printf("SWEET TOUCH: no unique supported IC (goodix=%d fts=%d dead=%d); stopping\n",
+		    goodix, fts, st.dead);
+		goto out;
+	}
+	st.kind = goodix ? TOUCH_GOODIX : TOUCH_FTS;
+	printf("SWEET TOUCH: selected %s, 1080x2400, poll=10ms irq-hint=%d\n",
+	    goodix ? "GT9896 Yellowstone" : "Focaltech 54:52", st.irq_hint);
+	unsigned errors = 0, ticks = 0;
+	while (!st.dead) {
+		/* Optional IRQ hint still reads every 100ms, and always while down. */
+		if (!st.irq_hint || st.active || !(touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u) ||
+		    (++ticks % 10u) == 0) {
+			int err = st.kind == TOUCH_GOODIX ? touch_goodix() : touch_focaltech();
+			if (err) {
+				if ((errors++ % 100u) == 0) {
+					printf("SWEET TOUCH: report err=%d irq=%#x\n", err, st.irq_status);
+				}
+				if (errors == 10) {
+					touch_report(0, st.x, st.y); /* release after persistent bad reads */
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		touch_wait(10);
+	}
+	touch_report(0, st.x, st.y);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (st.started) {
+		return;
+	}
+	st.started = true;
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweettouchirq", &st.irq_hint, sizeof(st.irq_hint));
+	if (!enabled) {
+		printf("SWEET TOUCH: disabled (sweettouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(touch_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
