+	data->tier_importance = _pthread_priority_relpri(priority);
+	if (data->qos_tier == THREAD_QOS_UNSPECIFIED || data->tier_importance > 0 ||
+			data->tier_importance < THREAD_QOS_MIN_TIER_IMPORTANCE) {
+		return false;
+	}
+	return true;
