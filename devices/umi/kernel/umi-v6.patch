+/*
+ *	Add a reference to the specified pmap.
+ */
+MARK_AS_PMAP_TEXT void
+pmap_reference_internal(
+	pmap_t pmap)
+{
+	if (pmap != PMAP_NULL) {
+		validate_pmap_mutable(pmap);
+		os_atomic_inc(&pmap->ref_count, relaxed);
+	}
+}
