+/* Called once the system can schedule and time (first exec): starts the
+ * flusher thread, which is the only context that writes the log. */
+void
+sweet_log_kick(void)
+{
+	static int started;
+	thread_t thread;
+
+	if (started || !su.writable) {
+		return;
+	}
+	started = 1;
+	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
