diff --git a/bsd/dev/I16UmiSmmu.h b/bsd/dev/I16UmiSmmu.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/I16UmiSmmu.h
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ * C adaptation of reAAAq/UniXNU-umi package/UmiSmmuTakeover.h.
+ * Same dual-stream policy and register order; callbacks add no I/O by themselves.
+ */
+#ifndef I16_UMI_SMMU_H
+#define I16_UMI_SMMU_H
+#include <stdint.h>
+#include <stdbool.h>
+typedef uint32_t (*I16Read)(void *,unsigned);
+typedef void (*I16Write)(void *,unsigned,uint32_t);
+typedef struct {
+ unsigned bank,pages,count,slot[2]; bool reuse[2]; unsigned error;
+} I16SmmuPlan;
+static const uint16_t i16_streams[2] = {0xe0,0x4e0};
+static I16SmmuPlan i16_smmu_plan(uint64_t dma, uint64_t bytes, I16Read read, void *ctx)
+{
+  I16SmmuPlan p = {0}; p.slot[0] = p.slot[1] = ~0U;
+  uint32_t id0=read(ctx,0x20), id1=read(ctx,0x24), id2=read(ctx,0x28);
+  p.count=id0&255;
+  p.pages=1U<<(((id1>>28)&7)+1);
+  unsigned banks=id1&255;
+  if (!(id0&(1U<<30)) || !(id0&(1U<<27)) || !(id2&(1U<<12)) ||
+      !p.count || p.count>128 || (id1>>31) || p.pages>128 ||
+      banks<2 || banks>128 || (p.pages+banks)*4096>0xd0000) {
+    p.error=1; return p;
+  }
+  const unsigned bits[]={32,36,40,42,44,48};
+  for(unsigned shift=0;shift<=8;shift+=4) {
+    unsigned code=(id2>>shift)&15;
+    if(code>=6 || !bytes || dma>=(1ULL<<bits[code]) ||
+       bytes>(1ULL<<bits[code])-dma) { p.error=2; return p; }
+  }
+  p.bank=banks-1;
+  unsigned freeSlots[128], freeCount=0;
+  for(unsigned i=0;i<p.count;++i) {
+    uint32_t smr=read(ctx,0x800+4*i);
+    if(!(smr&0x80000000U)) { freeSlots[freeCount++]=i; continue; }
+    uint32_t s2cr=read(ctx,0xc00+4*i), mask=(smr>>16)&0x7fff;
+    bool ownBank=((s2cr>>16)&3)==0 && (s2cr&255)==p.bank;
+    bool owned=false;
+    for(unsigned s=0;s<2;++s) {
+      if(((smr^i16_streams[s])&0xffff&~mask)!=0) continue;
+      if(p.reuse[s] || mask || !ownBank) { p.error=3; return p; }
+      p.reuse[s]=true; p.slot[s]=i; owned=true;
+    }
+    if(ownBank && !owned) { p.error=4; return p; }
+  }
+  uint32_t sctlr=read(ctx,(p.pages+p.bank)*4096);
+  if((sctlr&1) ||
+      ((p.reuse[0]||p.reuse[1]) &&
+       (sctlr || read(ctx,0x1000+4*p.bank)!=0x10000 ||
+        (read(ctx,0x1800+4*p.bank)&~1U)))) { p.error=5; return p; }
+  for(unsigned s=0;s<2;++s) if(!p.reuse[s]) {
+    if(!freeCount) { p.error=6; return p; }
+    p.slot[s]=freeSlots[--freeCount];
+  }
+  return p;
+}
+
+// Queue must be stopped before calling. Every write must be ordered by the
+// caller. Refused writes stop immediately; no DMA may start on any failure.
+static unsigned i16_smmu_apply(const I16SmmuPlan *p,I16Read read,I16Write write,void *ctx)
+{
+  if(p->error) return p->error;
+  unsigned cb=(p->pages+p->bank)*4096;
+  // Recheck the complete plan before the first write, including other streams.
+  // DMA range validation was performed by the planner on the actual allocation.
+  for(unsigned s=0;s<2;++s) {
+    uint32_t smr=read(ctx,0x800+4*p->slot[s]);
+    if(p->reuse[s] ? (smr!=(0x80000000U|i16_streams[s]) ||
+         read(ctx,0xc00+4*p->slot[s])!=p->bank) : (smr&0x80000000U)) return 7;
+  }
+  if(read(ctx,cb)&1) return 7;
+  if(!p->reuse[0] && !p->reuse[1]) write(ctx,cb,0);
+  if(read(ctx,cb)!=0) return 8;
+  if(read(ctx,0x1800+4*p->bank)!=1) write(ctx,0x1800+4*p->bank,1);
+  if(!p->reuse[0] && !p->reuse[1]) write(ctx,0x1000+4*p->bank,0x10000);
+  if(read(ctx,0x1800+4*p->bank)!=1 || read(ctx,0x1000+4*p->bank)!=0x10000 ||
+     read(ctx,cb)!=0) return 9;
+  // Configure both routes before making either new stream valid.
+  for(unsigned s=0;s<2;++s) if(!p->reuse[s]) {
+    write(ctx,0xc00+4*p->slot[s],p->bank);
+    if(read(ctx,0xc00+4*p->slot[s])!=p->bank) return 10;
+  }
+  for(unsigned s=0;s<2;++s) if(!p->reuse[s]) {
+    write(ctx,0x800+4*p->slot[s],0x80000000U|i16_streams[s]);
+    if(read(ctx,0x800+4*p->slot[s])!=(0x80000000U|i16_streams[s]) ||
+       read(ctx,0xc00+4*p->slot[s])!=p->bank) return 11;
+  }
+  return 0;
+}
+
+#endif
diff --git a/bsd/dev/UmiGpuFirmware.h b/bsd/dev/UmiGpuFirmware.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/UmiGpuFirmware.h
@@ -0,0 +1,29 @@
+/* Resource bounds checks for the fixed umi firmware inputs; no MMIO. */
+#ifndef UMI_GPU_FIRMWARE_H
+#define UMI_GPU_FIRMWARE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+static inline uint32_t umi_gpu_le32(const uint8_t *p) {
+ return (uint32_t)p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);
+}
+static inline uint16_t umi_gpu_le16(const uint8_t *p) { return (uint16_t)(p[0]|((uint16_t)p[1]<<8)); }
+static inline bool umi_gpu_inputs(const uint8_t *gmu,size_t gn,const uint8_t *sqe,size_t sn,
+ const uint8_t *mdt,size_t mn,const uint8_t *seg,size_t zn) {
+ if(!gmu||!sqe||!mdt||!seg||gn!=41548||sn!=31632||mn!=6860||zn!=1676) return false;
+ for(size_t at=0;at<gn;) {
+  if(gn-at<16) return false;
+  uint32_t va=umi_gpu_le32(gmu+at),n=umi_gpu_le32(gmu+at+4),kind=umi_gpu_le32(gmu+at+8),val=umi_gpu_le32(gmu+at+12);
+  at+=16;
+  if(n>gn-at || n>UINT32_MAX-va) return false;
+  if(n==0&&(kind==1||kind==7)&&(!val||val>0x1000000u||val>UINT32_MAX-va)) return false;
+  at+=n;
+ }
+ if((umi_gpu_le32(sqe+4)&0xfffu)!=0x93u || (sn&3u)) return false;
+ if(mdt[0]!=0x7f||mdt[1]!='E'||mdt[2]!='L'||mdt[3]!='F'||mdt[4]!=1||mdt[5]!=1) return false;
+ uint32_t off=umi_gpu_le32(mdt+28);uint32_t count=umi_gpu_le16(mdt+44);
+ if(umi_gpu_le16(mdt+42)!=32||count!=3||off>mn||count>(mn-off)/32) return false;
+ const uint8_t *load=mdt+off+64;
+ return umi_gpu_le32(load)==1&&umi_gpu_le32(load+16)==zn&&umi_gpu_le32(load+20)>=zn&&umi_gpu_le32(load+20)<=0x1000;
+}
+#endif
diff --git a/bsd/dev/UmiGpuSmmuGuard.h b/bsd/dev/UmiGpuSmmuGuard.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/UmiGpuSmmuGuard.h
@@ -0,0 +1,200 @@
+#ifndef UMI_GPU_SMMU_GUARD_H
+#define UMI_GPU_SMMU_GUARD_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* Guard for the GPU SMMU only (0x03da0000), not the UFS SMMU.
+ * rd/wr must perform one 32-bit MMIO access; caller holds its GPU lock.
+ * Zero-initialize the snapshot. acquire is read-only. Mark dirty immediately
+ * BEFORE the first driver write; never reacquire a dirty snapshot.
+ * restore requires the caller to have stopped/reset GMU/CP and drained DMA.
+ * W1C fault flags and historical TLB contents cannot be restored. Existing
+ * context fault flags are rejected; restore invalidates relevant ASIDs.
+ */
+enum UmiGpuSmmuResult {
+    UMI_GPU_SMMU_OK = 0,
+    UMI_GPU_SMMU_ARGUMENT,
+    UMI_GPU_SMMU_GEOMETRY,
+    UMI_GPU_SMMU_RANGE,
+    UMI_GPU_SMMU_TARGET_VALID,
+    UMI_GPU_SMMU_STREAM_OVERLAP,
+    UMI_GPU_SMMU_TARGET_REFERENCED,
+    UMI_GPU_SMMU_CONTEXT_ENABLED,
+    UMI_GPU_SMMU_PENDING_FAULT,
+    UMI_GPU_SMMU_NOT_QUIESCED,
+    UMI_GPU_SMMU_OWNERSHIP_CHANGED,
+    UMI_GPU_SMMU_TLB_TIMEOUT,
+    UMI_GPU_SMMU_RESTORE_MISMATCH,
+    UMI_GPU_SMMU_GLOBAL_FAULT
+};
+struct UmiGpuSmmuIo {
+    void *cookie;
+    uint32_t (*rd)(void *, uint32_t);
+    void (*wr)(void *, uint32_t, uint32_t);
+    void (*barrier)(void *);
+    void (*relax)(void *); /* optional bounded polling delay */
+};
+struct UmiGpuSmmuDiagnostic {
+    enum UmiGpuSmmuResult result;
+    uint32_t index, observed, expected;
+};
+#define UMI_GPU_SMMU_CB_FIELDS 9u
+static const uint32_t umi_gpu_smmu_cb_offsets[UMI_GPU_SMMU_CB_FIELDS] = {
+    0x00u, 0x10u, 0x20u, 0x24u, 0x28u, 0x2cu, 0x30u, 0x38u, 0x3cu
+};
+struct UmiGpuSmmuSnapshot {
+    uint32_t span, page, pages, contexts, matches;
+    uint32_t idr0, idr1, global_fault;
+    uint32_t smr[2], s2cr[2], cbar[2], cba2r[2];
+    uint32_t cb[2][UMI_GPU_SMMU_CB_FIELDS];
+    uint32_t acquired, dirty;
+};
+static inline enum UmiGpuSmmuResult
+umi_gpu_smmu_result(struct UmiGpuSmmuDiagnostic *d, enum UmiGpuSmmuResult r,
+    uint32_t i, uint32_t got, uint32_t want)
+{
+    if (d) { d->result = r; d->index = i; d->observed = got; d->expected = want; }
+    return r;
+}
+static inline int umi_gpu_smmu_has(uint32_t span, uint64_t off)
+{
+    return !(off & 3u) && off <= span && span - off >= 4u;
+}
+static inline int umi_gpu_smmu_overlap(uint32_t a, uint32_t b)
+{
+    uint32_t masks = ((a >> 16) | (b >> 16)) & 0x7fffu;
+    return (((a ^ b) & 0x7fffu) & ~masks) == 0;
+}
+static inline uint32_t umi_gpu_smmu_wanted_smr(unsigned i)
+{
+    return i ? 0x84000005u : 0x84010000u;
+}
+static inline enum UmiGpuSmmuResult
+umi_gpu_smmu_guard_acquire(struct UmiGpuSmmuSnapshot *s,
+    const struct UmiGpuSmmuIo *io, uint32_t span, struct UmiGpuSmmuDiagnostic *d)
+{
+    if (!s || !io || !io->rd || !io->wr || !io->barrier || span < 0x1000u)
+        return umi_gpu_smmu_result(d, UMI_GPU_SMMU_ARGUMENT, 0, span, 0x1000u);
+    if (s->acquired && s->dirty)
+        return umi_gpu_smmu_result(d, UMI_GPU_SMMU_ARGUMENT, 0, 1, 0);
+    s->acquired = s->dirty = 0;
+    s->span = span;
+    s->idr0 = io->rd(io->cookie, 0x20u);
+    s->idr1 = io->rd(io->cookie, 0x24u);
+    s->page = (s->idr1 >> 31) ? 0x10000u : 0x1000u;
+    s->pages = 2u << ((s->idr1 >> 28) & 7u);
+    s->contexts = s->idr1 & 0xffu;
+    s->matches = s->idr0 & 0xffu;
+    if ((uint64_t)2u * s->pages * s->page != span ||
+        s->contexts < 2u || s->matches < 2u)
+        return umi_gpu_smmu_result(d, UMI_GPU_SMMU_GEOMETRY, 0, s->idr1, span);
+    if (!umi_gpu_smmu_has(span, 0x800u + 4ull * (s->matches - 1u)) ||
+        !umi_gpu_smmu_has(span, 0xc00u + 4ull * (s->matches - 1u)) ||
+        !umi_gpu_smmu_has(span, (uint64_t)(s->pages + 1u) * s->page + 0x7f4u) ||
+        !umi_gpu_smmu_has(span, (uint64_t)s->page + 0x804u))
+        return umi_gpu_smmu_result(d, UMI_GPU_SMMU_RANGE, 0, s->page, span);
+    s->global_fault = io->rd(io->cookie, 0x48u);
+    if (s->global_fault)
+        return umi_gpu_smmu_result(d, UMI_GPU_SMMU_GLOBAL_FAULT, 0, s->global_fault, 0);
+    for (unsigned i = 0; i < 2; ++i) {
+        s->smr[i] = io->rd(io->cookie, 0x800u + 4u * i);
+        s->s2cr[i] = io->rd(io->cookie, 0xc00u + 4u * i);
+        if (s->smr[i] & 0x80000000u)
+            return umi_gpu_smmu_result(d, UMI_GPU_SMMU_TARGET_VALID, i, s->smr[i], 0);
+    }
+    for (unsigned i = 2; i < s->matches; ++i) {
+        uint32_t smr = io->rd(io->cookie, 0x800u + 4u * i);
+        if (!(smr & 0x80000000u)) continue;
+        uint32_t route = io->rd(io->cookie, 0xc00u + 4u * i);
+        if (umi_gpu_smmu_overlap(smr, umi_gpu_smmu_wanted_smr(0)) ||
+            umi_gpu_smmu_overlap(smr, umi_gpu_smmu_wanted_smr(1)))
+            return umi_gpu_smmu_result(d, UMI_GPU_SMMU_STREAM_OVERLAP, i, smr, route);
+        if (((route >> 16) & 3u) == 0 && (route & 0xffu) < 2u)
+            return umi_gpu_smmu_result(d, UMI_GPU_SMMU_TARGET_REFERENCED, i, smr, route);
+    }
+    for (unsigned i = 0; i < 2; ++i) {
+        uint32_t cb = (s->pages + i) * s->page;
+        for (unsigned k = 0; k < UMI_GPU_SMMU_CB_FIELDS; ++k)
+            s->cb[i][k] = io->rd(io->cookie, cb + umi_gpu_smmu_cb_offsets[k]);
+        s->cbar[i] = io->rd(io->cookie, s->page + 4u * i);
+        s->cba2r[i] = io->rd(io->cookie, s->page + 0x800u + 4u * i);
+        if (s->cb[i][0] & 1u)
+            return umi_gpu_smmu_result(d, UMI_GPU_SMMU_CONTEXT_ENABLED, i, s->cb[i][0], 0);
+        uint32_t fsr = io->rd(io->cookie, cb + 0x58u);
+        if (fsr & 0xc00001feu)
+            return umi_gpu_smmu_result(d, UMI_GPU_SMMU_PENDING_FAULT, i, fsr, 0);
+    }
+    s->acquired = 1;
+    return umi_gpu_smmu_result(d, UMI_GPU_SMMU_OK, 0, 0, 0);
+}
+static inline int umi_gpu_smmu_guard_mark_dirty(struct UmiGpuSmmuSnapshot *s)
+{
+    if (!s || !s->acquired) return 0;
+    s->dirty = 1;
+    return 1;
+}
+static inline int umi_gpu_smmu_sync(const struct UmiGpuSmmuIo *io, uint32_t cb, uint32_t asid)
+{
+    io->wr(io->cookie, cb + 0x610u, asid);
+    io->wr(io->cookie, cb + 0x7f0u, 1u);
+    io->barrier(io->cookie);
+    for (unsigned n = 0; n < 10000u; ++n) {
+        if (!(io->rd(io->cookie, cb + 0x7f4u) & 1u)) return 1;
+        if (io->relax) io->relax(io->cookie);
+    }
+    return 0;
+}
+static inline enum UmiGpuSmmuResult
+umi_gpu_smmu_guard_restore(struct UmiGpuSmmuSnapshot *s,
+    const struct UmiGpuSmmuIo *io, int quiesced, struct UmiGpuSmmuDiagnostic *d)
+{
+    if (!s || !io || !io->rd || !io->wr || !io->barrier || !s->acquired)
+        return umi_gpu_smmu_result(d, UMI_GPU_SMMU_ARGUMENT, 0, 0, 0);
+    if (!s->dirty) return umi_gpu_smmu_result(d, UMI_GPU_SMMU_OK, 0, 0, 0);
+    if (!quiesced) return umi_gpu_smmu_result(d, UMI_GPU_SMMU_NOT_QUIESCED, 0, 0, 1);
+    /* Refuse to clear a route that another driver changed after acquisition. */
+    for (unsigned i = 0; i < 2; ++i) {
+        uint32_t smr = io->rd(io->cookie, 0x800u + 4u * i);
+        uint32_t route = io->rd(io->cookie, 0xc00u + 4u * i);
+        if ((smr != s->smr[i] && smr != umi_gpu_smmu_wanted_smr(i) &&
+             smr != (umi_gpu_smmu_wanted_smr(i) & 0x7fffffffu)) ||
+            (route != s->s2cr[i] && route != i && route != (2u << 16)))
+            return umi_gpu_smmu_result(d, UMI_GPU_SMMU_OWNERSHIP_CHANGED, i, smr, route);
+    }
+    for (unsigned i = 0; i < 2; ++i) {
+        io->wr(io->cookie, 0x800u + 4u * i, io->rd(io->cookie, 0x800u + 4u * i) & 0x7fffffffu);
+        uint32_t cb = (s->pages + i) * s->page;
+        io->wr(io->cookie, cb, io->rd(io->cookie, cb) & ~1u);
+    }
+    io->barrier(io->cookie);
+    for (unsigned i = 0; i < 2; ++i) {
+        uint32_t cb = (s->pages + i) * s->page;
+        uint32_t current_asid = io->rd(io->cookie, cb + 0x24u) >> 16;
+        if (!umi_gpu_smmu_sync(io, cb, current_asid))
+            return umi_gpu_smmu_result(d, UMI_GPU_SMMU_TLB_TIMEOUT, i, 1, 0);
+        io->wr(io->cookie, s->page + 0x800u + 4u * i, s->cba2r[i]);
+        io->wr(io->cookie, s->page + 4u * i, s->cbar[i]);
+        for (unsigned k = 1; k < UMI_GPU_SMMU_CB_FIELDS; ++k)
+            io->wr(io->cookie, cb + umi_gpu_smmu_cb_offsets[k], s->cb[i][k]);
+        if (!umi_gpu_smmu_sync(io, cb, s->cb[i][3] >> 16))
+            return umi_gpu_smmu_result(d, UMI_GPU_SMMU_TLB_TIMEOUT, i, 1, 0);
+        io->wr(io->cookie, 0xc00u + 4u * i, s->s2cr[i]);
+        io->wr(io->cookie, 0x800u + 4u * i, s->smr[i]);
+        io->wr(io->cookie, cb, s->cb[i][0]);
+    }
+    io->barrier(io->cookie);
+    for (unsigned i = 0; i < 2; ++i) {
+        uint32_t cb = (s->pages + i) * s->page;
+        for (unsigned k = 0; k < UMI_GPU_SMMU_CB_FIELDS; ++k)
+            if (io->rd(io->cookie, cb + umi_gpu_smmu_cb_offsets[k]) != s->cb[i][k])
+                return umi_gpu_smmu_result(d, UMI_GPU_SMMU_RESTORE_MISMATCH, i, k, s->cb[i][k]);
+        if (io->rd(io->cookie, 0x800u + 4u * i) != s->smr[i] ||
+            io->rd(io->cookie, 0xc00u + 4u * i) != s->s2cr[i] ||
+            io->rd(io->cookie, s->page + 4u * i) != s->cbar[i] ||
+            io->rd(io->cookie, s->page + 0x800u + 4u * i) != s->cba2r[i])
+            return umi_gpu_smmu_result(d, UMI_GPU_SMMU_RESTORE_MISMATCH, i, 0, 0);
+    }
+    s->dirty = 0;
+    return umi_gpu_smmu_result(d, UMI_GPU_SMMU_OK, 0, 0, 0);
+}
+#endif
diff --git a/bsd/dev/UmiLowDma.h b/bsd/dev/UmiLowDma.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/UmiLowDma.h
@@ -0,0 +1,69 @@
+/* Research diagnostic only. Loader owns/reserves the entire allocation.
+ * Wire format: /sweet-ufs/dma-pool, four LE u64 values, exactly 32 bytes.
+ * No allocation or hardware operation is performed by these policy helpers. */
+#ifndef UMI_LOW_DMA_H
+#define UMI_LOW_DMA_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+
+#define UMI_LOW_DMA_ALLOC_SIZE 0x18000ULL
+#define UMI_LOW_DMA_BUFFER_SIZE 0x14000ULL
+#define UMI_LOW_DMA_HEAP_START 0x98900000ULL
+#define UMI_LOW_DMA_HEAP_END 0x9bc00000ULL
+
+static bool umi_lowdma_end(uint64_t base, uint64_t size, uint64_t *end)
+{
+    if (!size || base > UINT64_MAX - size) return false;
+    *end = base + size;
+    return true;
+}
+
+static bool umi_lowdma_overlap(uint64_t start, uint64_t end,
+    uint64_t other_start, uint64_t other_end)
+{
+    return start < other_end && other_start < end;
+}
+
+static bool umi_lowdma_pool_valid(const uint64_t pool[4],
+    uint64_t kernel_base, uint64_t kernel_size)
+{
+    uint64_t allocation_end, buffer_end, kernel_end;
+    if (pool[1] != UMI_LOW_DMA_ALLOC_SIZE || pool[3] != UMI_LOW_DMA_BUFFER_SIZE ||
+        (pool[0] & 0xfff) || (pool[2] & 0x3fff) ||
+        !umi_lowdma_end(pool[0], pool[1], &allocation_end) ||
+        !umi_lowdma_end(pool[2], pool[3], &buffer_end) ||
+        !umi_lowdma_end(kernel_base, kernel_size, &kernel_end)) return false;
+    if (pool[0] < UMI_LOW_DMA_HEAP_START || allocation_end > UMI_LOW_DMA_HEAP_END ||
+        allocation_end > 0x100000000ULL || pool[2] < pool[0] || buffer_end > allocation_end)
+        return false;
+    if (umi_lowdma_overlap(pool[0], allocation_end, kernel_base, kernel_end) ||
+        umi_lowdma_overlap(pool[0], allocation_end, 0x9c000000ULL, 0x9e300000ULL) ||
+        umi_lowdma_overlap(pool[0], allocation_end, 0xb0000000ULL, 0xb0400000ULL) ||
+        umi_lowdma_overlap(pool[0], allocation_end, 0x23ff00000ULL, 0x240000000ULL))
+        return false;
+    return true;
+}
+
+/* Bounded NUL-separated compatible list. Reject unterminated strings and
+ * duplicate identity entries, even if an earlier entry matched. */
+static bool umi_lowdma_is_umi(const unsigned char *bytes, size_t length)
+{
+    static const unsigned char target[] = "xiaomi,umi";
+    unsigned matches = 0;
+    size_t pos = 0;
+    if (!bytes || !length || length > 4096) return false;
+    while (pos < length) {
+        size_t begin = pos;
+        while (pos < length && bytes[pos]) ++pos;
+        if (pos == length) return false;
+        if (pos - begin == sizeof(target) - 1) {
+            size_t i = 0;
+            while (i < sizeof(target) - 1 && bytes[begin + i] == target[i]) ++i;
+            if (i == sizeof(target) - 1) ++matches;
+        }
+        ++pos;
+    }
+    return matches == 1;
+}
+#endif
