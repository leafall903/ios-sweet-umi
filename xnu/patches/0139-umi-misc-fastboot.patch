+/*
+ * Write blocks of the whole LUN, ignoring the partition bounds. Only the
+ * bootloader message path uses this, and only when the boot argument asked
+ * for it: the misc partition is outside "userdata".
+ */
+static int
+ufs_write_raw(uint64_t lba, uint32_t count)
+{
+	if (!su.writable || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
+	    lba + count - 1 > UINT32_MAX) {
+		return EPERM;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
+
+/* Read blocks of the whole LUN into the bounce buffer. */
+static int
+ufs_read_raw(uint64_t lba, uint32_t count)
+{
+	if (count == 0 || count > BOUNCE_SIZE / UFS_BLOCK || lba + count - 1 > UINT32_MAX) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x28, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, false);
+}
