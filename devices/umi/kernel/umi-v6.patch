+#pragma once
+#include <stdint.h>
+#include <stdbool.h>
+static bool umi_cpu_mode_valid(uint32_t cpus,uint32_t gui,uint32_t aff) {
+ return cpus==1 ? gui==0 : (cpus==4 || cpus==8) && gui==1 && aff==cpus-1;
+}
+static bool umi_cpu_boot_valid(uint32_t cpus) {
+ uint32_t gui=0,aff=UINT32_MAX;
+ PE_parse_boot_argn("umi-smp-gui",&gui,4);PE_parse_boot_argn("sweetaff1max",&aff,4);
+ return umi_cpu_mode_valid(cpus,gui,aff);
+}
diff --git a/iokit/Kernel/arm/UmiSurfaceRange.h b/iokit/Kernel/arm/UmiSurfaceRange.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/UmiSurfaceRange.h
@@ -0,0 +1,8 @@
+#pragma once
+#include <stdint.h>
+static inline bool umi_surface_task_range(uint64_t address,uint64_t size,uint64_t page,uint64_t*first,uint64_t*length,uint32_t*delta) {
+ if(!address||!size||size>(256ULL<<20)||!page||(page&(page-1))||page>65536)return false;
+ if(address>UINT64_MAX-size || address+size>UINT64_MAX-(page-1))return false;
+ *first=address&~(page-1);uint64_t end=(address+size+page-1)&~(page-1);*length=end-*first;*delta=(uint32_t)(address-*first);
+ return *length && *length<=(256ULL<<20)+2*page;
+}
diff --git a/iokit/Kernel/arm/UmiSweetBridge.cpp b/iokit/Kernel/arm/UmiSweetBridge.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/UmiSweetBridge.cpp
@@ -0,0 +1,50 @@
+// Local iOS 16 prototype: ST frame queue -> built-in IOHIDFamily 1915 service.
+// Hardware is opt-in with umi-fts=1; absent/zero performs no MMIO or power IO.
+#include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
+#include "UmiSmpMode.h"
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include "UmiSweetFrameBridge.h"
+extern "C" {
+bool umi_touch_next(UmiTouchFrame *frame);
+void native_touch_probe(void);
+bool umi_hid_input_ready(void);
+void umi_keys_start(void);
+void sweet_hid_touch(int finger,int down,int x,int y);
+extern volatile uint32_t native_touch_hid_reports;
+// Compatibility diagnostics only. No IOHID2031 loader or edge vtable hook.
+char boot_progress_ext[8][48];
+volatile uint32_t native_hid_stage,native_hid_resource_found,native_hid_input_events[8],native_touch_edge_stats[4];
+volatile int native_hid_load_status=-1,native_hid_matching_load_status=-1,native_hid_input_results[8];
+}
+static bool bridge_started;
+static void bridge_worker(void *,wait_result_t) {
+    thread_set_thread_name(current_thread(),"umi_hid16");
+    for(unsigned n=0;n<3000 && !umi_hid_input_ready();++n) IOSleep(10);
+    if(!umi_hid_input_ready()) { IOLog("UMI input: HID registration timeout; hardware untouched\n"); thread_terminate(current_thread()); return; }
+    IOLog("UMI input: UFS ready and HID registered; starting native input\n");
+    native_touch_probe();
+    umi_keys_start();
+    UmiTouchFrame delivered={};
+    for(;;) {
+        UmiTouchFrame next;
+        for(unsigned n=0;n<8 && umi_touch_next(&next);++n) {
+            unsigned attempted=umi_sweet_deliver(delivered,next,[](int id,int down,int x,int y){sweet_hid_touch(id,down,x,y);});
+            native_touch_hid_reports=native_touch_hid_reports+attempted;
+        }
+        IOSleep(8);
+    }
+}
+extern "C" void umi_sweet_touch_start(void) {
+    unsigned enabled=0;
+    if(!PE_parse_boot_argn("umi-fts",&enabled,sizeof(enabled)) || enabled!=1 || bridge_started)return;
+    unsigned gpi=0,cpus=0,root=0,smmu=0;
+    if(!PE_parse_boot_argn("umi-fts-gpi",&gpi,4)||gpi!=1 ||
+       !PE_parse_boot_argn("cpus",&cpus,4)||!umi_cpu_boot_valid(cpus) ||
+       !PE_parse_boot_argn("umi-rootfs",&root,4)||root!=1 ||
+       !PE_parse_boot_argn("umi-smmu",&smmu,4)||smmu!=1)return;
+    thread_t thread;
+    if(kernel_thread_start(bridge_worker,nullptr,&thread)!=KERN_SUCCESS)return;
+    bridge_started=true;thread_deallocate(thread);
+}
diff --git a/iokit/Kernel/arm/UmiSweetFrameBridge.h b/iokit/Kernel/arm/UmiSweetFrameBridge.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/UmiSweetFrameBridge.h
@@ -0,0 +1,15 @@
+// Local iOS 16 prototype. No IOHID binary ABI or vtable offsets.
+#pragma once
+#include "UmiFtsCore.h"
+template<class Emit>
+static unsigned umi_sweet_deliver(UmiTouchFrame &previous,const UmiTouchFrame &next,Emit emit) {
+    unsigned sent=0;
+    for(unsigned id=0;id<10;++id) {
+        const auto &old=previous.points[id];const auto &now=next.points[id];
+        if(old.active==now.active && (!now.active || (old.x==now.x && old.y==now.y)))continue;
+        // A lift retains the last delivered coordinate for its stable ID.
+        const auto &position=now.active?now:old;
+        emit((int)id,now.active?1:0,(int)position.x,(int)position.y);++sent;
+    }
+    previous=next;return sent;
+}
