+#ifndef IOHIDDeviceTypes_h
+#define IOHIDDeviceTypes_h
+
+/* SWEET: kernel build, no SDK TargetConditionals.h */
+#ifndef TARGET_OS_DRIVERKIT
+#define TARGET_OS_DRIVERKIT 0
+#endif
+
+#if TARGET_OS_DRIVERKIT
+#include <DriverKit/IOTypes.h>
