+#define HFC_CUMULATIVE_CYCLES	 3
+#define HFC_MAXIMUM_FILE_COUNT	 hfc_max_file_count
+#define HFC_MAXIMUM_FILESIZE	 hfc_max_file_size 
+#define HFC_MINIMUM_TEMPERATURE  24
