+#define PTHREAD_FEATURE_SUPPORTED	( \
+	PTHREAD_FEATURE_DISPATCHFUNC | \
+	PTHREAD_FEATURE_FINEPRIO | \
+	PTHREAD_FEATURE_BSDTHREADCTL | \
+	PTHREAD_FEATURE_SETSELF | \
+	PTHREAD_FEATURE_QOS_MAINTENANCE | \
+	PTHREAD_FEATURE_QOS_DEFAULT | \
