+		uuid_clear (hfsmp->hfs_full_uuid);
+		hfs_unlock_mount (hfsmp);
+		(void) hfs_flushvolumeheader(hfsmp, HFS_FVH_WAIT);
+		break;
+		
+	case HFS_GET_BOOT_INFO:
+		if (!vnode_isvroot(vp))
