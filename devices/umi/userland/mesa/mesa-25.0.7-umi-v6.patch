diff --git a/src/hakios-drm/hakios.drm.c b/src/hakios-drm/hakios.drm.c
new file mode 100644
--- /dev/null
+++ b/src/hakios-drm/hakios.drm.c
@@ -0,0 +1,226 @@
+/*
+ * The libdrm of xf86drm.h (see there): Linux's DRM requests to the kernel's GPU driver as calls
+ * of its IOKit user client. A request's number (the low byte of the ioctl code) is the call's
+ * selector, its structure goes in and comes back as it is; a buffer's memory is the client
+ * memory of the type that is the buffer's handle.
+ *
+ * freedreno knows its device by a file descriptor. It gets one that means nothing (/dev/null):
+ * there is one GPU and one connection to it in a process.
+ */
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <IOKit/IOKitLib.h>
+
+#include "xf86drm.h"
+
+#define HAKIOS_GPU_SERVICE     "SweetGPU"
+#define HAKIOS_GPU_SURFACE     0x7e            /* the request that is not Linux's */
+#define HAKIOS_GPU_DESCRIBE    0xffffffffu     /* ... asked only what the buffer would be like */
+
+static io_connect_t connection;
+static int connection_fd = -1;
+
+int
+drmOpenWithType(const char *name, const char *busid, int type)
+{
+	io_service_t service;
+
+	(void)busid;
+	(void)type;
+	if (strcmp(name, "msm") != 0) {
+		return -1;
+	}
+	if (connection_fd >= 0) {
+		return dup(connection_fd);
+	}
+	service = IOServiceGetMatchingService(0, IOServiceMatching(HAKIOS_GPU_SERVICE));
+	if (service == 0) {
+		return -1;
+	}
+	if (IOServiceOpen(service, mach_task_self(), 0, &connection) != 0) {
+		IOObjectRelease(service);
+		return -1;
+	}
+	IOObjectRelease(service);
+	connection_fd = open("/dev/null", O_RDWR);
+	return dup(connection_fd);
+}
+
+static int
+call(unsigned number, void *data, size_t size)
+{
+	size_t returned = size;
+	kern_return_t result = IOConnectCallStructMethod(connection, number, data, size, data, &returned);
+
+	switch (result) {
+	case 0:
+		return 0;
+	case kIOReturnNoMemory:
+		return ENOMEM;
+	case kIOReturnBadArgument:
+		return EINVAL;
+	case kIOReturnTimeout:
+		return ETIMEDOUT;
+	case kIOReturnBusy:
+		return EBUSY;
+	case kIOReturnNotFound:
+		return ENOENT;
+	case kIOReturnUnsupported:
+		return ENOSYS;
+	default:
+		return EIO;
+	}
+}
+
+int
+drmIoctl(int fd, unsigned long request, void *arg)
+{
+	int error = call((unsigned)(request & 0xff), arg, IOCPARM_LEN(request));
+
+	(void)fd;
+	if (error != 0) {
+		errno = error;
+		return -1;
+	}
+	return 0;
+}
+
+int
+drmCommandWrite(int fd, unsigned long index, const void *data, unsigned long size)
+{
+	(void)fd;
+	return -call((unsigned)(DRM_COMMAND_BASE + index), (void *)(uintptr_t)data, size);
+}
+
+int
+drmCommandWriteRead(int fd, unsigned long index, void *data, unsigned long size)
+{
+	(void)fd;
+	return -call((unsigned)(DRM_COMMAND_BASE + index), data, size);
+}
+
+/*
+ * The driver calls itself what Linux's is called, and is of the version whose interface it has:
+ * 1.7, buffers at addresses the kernel chooses and tells ("softpin"), nothing newer.
+ */
+drmVersionPtr
+drmGetVersion(int fd)
+{
+	drmVersionPtr version = calloc(1, sizeof(*version));
+
+	(void)fd;
+	if (version != NULL) {
+		version->version_major = 1;
+		version->version_minor = 7;
+		version->name = strdup("msm");
+		version->name_len = 3;
+		version->date = strdup("");
+		version->desc = strdup("Adreno on Darwin");
+		version->desc_len = (int)strlen(version->desc);
+	}
+	return version;
+}
+
+void
+drmFreeVersion(drmVersionPtr version)
+{
+	if (version != NULL) {
+		free(version->name);
+		free(version->date);
+		free(version->desc);
+		free(version);
+	}
+}
+
+int
+drmGetCap(int fd, uint64_t capability, uint64_t *value)
+{
+	(void)fd;
+	(void)capability;
+	*value = 0;
+	return 0;
+}
+
+void *
+hakios_drm_map(int fd, uint32_t handle, uint64_t size)
+{
+	mach_vm_address_t address = 0;
+	mach_vm_size_t mapped = 0;
+
+	(void)fd;
+	(void)size;
+	/*
+	 * Linux gives freedreno its buffers write-combined, with no cache of this processor's between
+	 * the program and the memory the GPU sees. So does the kernel's driver here: the memory is
+	 * made that way, and this mapping is as the memory is.
+	 */
+	if (IOConnectMapMemory64(connection, handle, mach_task_self(), &address, &mapped, kIOMapAnywhere) != 0) {
+		return (void *)-1;              /* mmap()'s MAP_FAILED */
+	}
+	return (void *)(uintptr_t)address;
+}
+
+void
+hakios_drm_unmap(int fd, uint32_t handle, void *address)
+{
+	(void)fd;
+	IOConnectUnmapMemory64(connection, handle, mach_task_self(), (mach_vm_address_t)(uintptr_t)address);
+}
+
+int
+hakios_drm_surface(int fd, struct hakios_drm_surface *surface)
+{
+	int error;
+
+	(void)fd;
+	surface->handle = HAKIOS_GPU_DESCRIBE;
+	error = call(HAKIOS_GPU_SURFACE, surface, sizeof(*surface));
+	if (error != 0) {
+		errno = error;
+		return -1;
+	}
+	return 0;
+}
+
+int
+drmPrimeFDToHandle(int fd, int surface, uint32_t *handle)
+{
+	struct hakios_drm_surface request = { .surface = (uint32_t)surface };
+	int error = call(HAKIOS_GPU_SURFACE, &request, sizeof(request));
+
+	(void)fd;
+	if (error != 0) {
+		errno = error;
+		return -1;
+	}
+	*handle = request.handle;
+	return 0;
+}
+
+static int
+none(void)
+{
+	errno = ENOSYS;
+	return -1;
+}
+
+/* Buffers and fences as file descriptors, for handing them to other programs and drivers: none of that here. */
+#define NONE(name, ...) int name(__VA_ARGS__) { return none(); }
+NONE(drmPrimeHandleToFD, __attribute__((unused)) int fd, __attribute__((unused)) uint32_t handle,
+    __attribute__((unused)) uint32_t flags, __attribute__((unused)) int *prime_fd)
+NONE(drmSyncobjCreate, __attribute__((unused)) int fd, __attribute__((unused)) uint32_t flags,
+    __attribute__((unused)) uint32_t *handle)
+NONE(drmSyncobjDestroy, __attribute__((unused)) int fd, __attribute__((unused)) uint32_t handle)
+NONE(drmSyncobjReset, __attribute__((unused)) int fd, __attribute__((unused)) const uint32_t *handles,
+    __attribute__((unused)) uint32_t count)
+NONE(drmSyncobjFDToHandle, __attribute__((unused)) int fd, __attribute__((unused)) int obj_fd,
+    __attribute__((unused)) uint32_t *handle)
+NONE(drmSyncobjHandleToFD, __attribute__((unused)) int fd, __attribute__((unused)) uint32_t handle,
+    __attribute__((unused)) int *obj_fd)
+NONE(drmSyncobjImportSyncFile, __attribute__((unused)) int fd, __attribute__((unused)) uint32_t handle,
+    __attribute__((unused)) int sync_file_fd)
+NONE(drmSyncobjExportSyncFile, __attribute__((unused)) int fd, __attribute__((unused)) uint32_t handle,
+    __attribute__((unused)) int *sync_file_fd)
diff --git a/src/hakios-drm/xf86drm.h b/src/hakios-drm/xf86drm.h
new file mode 100644
--- /dev/null
+++ b/src/hakios-drm/xf86drm.h
@@ -0,0 +1,76 @@
+/*
+ * What Mesa's freedreno takes from libdrm's xf86drm.h, for a system without Linux's DRM: the
+ * declarations here, the functions in hakios.drm.c, which carry the requests to the kernel's
+ * GPU driver (the service HakiosGPU; iokit/Kernel/hakios.gpu.cpp) as calls of its user client.
+ * tools/mk-mesa.sh puts both into Mesa's tree, where they are the "libdrm" freedreno is built
+ * against. The request numbers and their structures are Linux's (Mesa's include/drm-uapi).
+ */
+#ifndef HAKIOS_XF86DRM_H
+#define HAKIOS_XF86DRM_H
+
+#include <fcntl.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+
+#include "drm-uapi/drm.h"
+
+#define DRM_NODE_PRIMARY        0
+#define DRM_NODE_RENDER         2
+#define DRM_CLOEXEC             O_CLOEXEC
+#define DRM_RDWR                O_RDWR
+
+typedef struct _drmVersion {
+	int version_major, version_minor, version_patchlevel;
+	int name_len;
+	char *name;
+	int date_len;
+	char *date;
+	int desc_len;
+	char *desc;
+} drmVersion, *drmVersionPtr;
+
+int drmOpenWithType(const char *name, const char *busid, int type);
+int drmIoctl(int fd, unsigned long request, void *arg);
+int drmCommandWrite(int fd, unsigned long index, const void *data, unsigned long size);
+int drmCommandWriteRead(int fd, unsigned long index, void *data, unsigned long size);
+drmVersionPtr drmGetVersion(int fd);
+void drmFreeVersion(drmVersionPtr version);
+int drmGetCap(int fd, uint64_t capability, uint64_t *value);
+
+/*
+ * Buffers and fences as file descriptors: there are none here. But memory that somebody else
+ * has made does come in, as Linux's comes in by file descriptor: an IOSurface, by its ID, where
+ * freedreno expects the descriptor (see hakios_drm_surface() below).
+ */
+int drmPrimeHandleToFD(int fd, uint32_t handle, uint32_t flags, int *prime_fd);
+int drmPrimeFDToHandle(int fd, int surface, uint32_t *handle);
+int drmSyncobjCreate(int fd, uint32_t flags, uint32_t *handle);
+int drmSyncobjDestroy(int fd, uint32_t handle);
+int drmSyncobjReset(int fd, const uint32_t *handles, uint32_t count);
+int drmSyncobjFDToHandle(int fd, int obj_fd, uint32_t *handle);
+int drmSyncobjHandleToFD(int fd, uint32_t handle, int *obj_fd);
+int drmSyncobjImportSyncFile(int fd, uint32_t handle, int sync_file_fd);
+int drmSyncobjExportSyncFile(int fd, uint32_t handle, int *sync_file_fd);
+
+/* Not libdrm's: a buffer's memory in this process, in place of mmap() on the device (freedreno_bo.c is patched to call these). */
+void *hakios_drm_map(int fd, uint32_t handle, uint64_t size);
+void hakios_drm_unmap(int fd, uint32_t handle, void *address);
+
+/*
+ * Not libdrm's either: what the memory of an IOSurface would be like as a buffer (the kernel's
+ * request and its answer: struct hakios_surface in iokit/Kernel/hakios.gpu.cpp); 0, or -1 with
+ * errno. The buffer itself is made by drmPrimeFDToHandle(), which freedreno calls with its
+ * table of buffers locked, so that a buffer on its way out and the same surface on its way in
+ * cannot pass each other.
+ */
+struct hakios_drm_surface {
+	uint32_t surface;                       /* the IOSurface's ID */
+	uint32_t handle;                        /* (the kernel's: which of the two is asked) */
+	uint64_t size;                          /* back: how big the buffer is, */
+	uint32_t offset, row_bytes;             /* where the pixels start in it and how long a row of them is, */
+	uint32_t width, height, pixel_format, planes;   /* and what they are */
+};
+int hakios_drm_surface(int fd, struct hakios_drm_surface *surface);
+
+#endif
