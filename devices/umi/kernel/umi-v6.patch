+    uint64_t saved = umi_ramlog_irq_save();
+    if(!umi_ramlog_try_enter()){umi_ramlog_irq_restore(saved);return;}
+    umi_ramlog_append(umi_ramlog, (const uint8_t *)bytes, (size_t)size);
