+/* Independent liveness indicator: this thread touches only the framebuffer,
+ * never the console lock nor the UFS lock, so it keeps painting even when the
+ * log thread is blocked. Stops painting => the kernel itself is stuck. */
+static void
+sweet_watchdog_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t n = 0;
+
+	for (;;) {
+		PE_Video video;
+
+		PE_current_console(&video);
+		if (video.v_baseAddr && video.v_rowBytes && video.v_height > 300) {
+			uint32_t *fb = (uint32_t *)(video.v_baseAddr);
+			uint32_t w = video.v_rowBytes / 4;
+			uint32_t colour = (n & 1) ? 0x00ff0000 : 0x0000ff00;
+			for (uint32_t y = 0; y < 64; y++) {
+				uint32_t *row = fb + (uint64_t)y * w;
+				for (uint32_t x = 0; x < w; x++) {
+					row[x] = (((x / 32) + n) & 1) ? colour : 0x00000000;
+				}
+			}
+		}
+		n++;
+		delay_for_interval(2, NSEC_PER_SEC);
+	}
+}
