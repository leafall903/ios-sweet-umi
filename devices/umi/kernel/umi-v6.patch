+	vm_map_offset_t va,
+	int             *disp_p)
+{
+#if XNU_MONITOR
+	return pmap_query_page_info_ppl(pmap, va, disp_p);
+#else
+	return pmap_query_page_info_internal(pmap, va, disp_p);
+#endif
