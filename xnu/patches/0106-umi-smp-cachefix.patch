+/*
+ * A CPU started with PSCI CPU_ON reads the kernel through physical addresses
+ * with its MMU and caches off until common_start, so it reads *memory*: what
+ * the running processors have not written back yet is not there for it.
+ * Clean (not flush: the running processors keep using all of it) the
+ * segments that core reads in that state.  Called from cpu_start(), right
+ * before PE_cpu_start() enters SweetCPU::startCPU() and CPU_ON.
+ */
+static unsigned long
+sweet_smp_clean_segment(const char *name)
+{
+	unsigned long size = 0;
+	vm_offset_t start = (vm_offset_t)getsegdatafromheader(&_mh_execute_header, name, &size);
+
+	if (start == 0 || size == 0) {
+		return 0;
+	}
+	CleanPoC_DcacheRegion_Force(start, size);
+	return size;
+}
